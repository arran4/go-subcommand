// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"slices"
	"strconv"
	"strings"
	"sync"

	app "example.com/helpissue"
	"example.com/helpissue/cmd"
	"example.com/helpissue/cmd/app/templates"
)

var generatedOpenReader = func(name string) (io.ReadCloser, error) {
	return os.Open(name)
}

var generatedOpenWriter = func(name string) (io.WriteCloser, error) {
	return os.OpenFile(name, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0666)
}

type Cmd interface {
	Execute(args []string) error
	Usage()
}

type InternalCommand struct {
	Exec      func(args []string) error
	UsageFunc func()
}

func (c *InternalCommand) Execute(args []string) error {
	return c.Exec(args)
}

func (c *InternalCommand) Usage() {
	c.UsageFunc()
}

func NewLazyCommand(f func() Cmd) func() Cmd {
	var once sync.Once
	var cmd Cmd
	return func() Cmd {
		once.Do(func() {
			cmd = f()
		})
		return cmd
	}
}

type UserError struct {
	Err error
	Msg string
}

func (e *UserError) Error() string {
	if e.Err != nil {
		return fmt.Sprintf("%s: %v", e.Msg, e.Err)
	}
	return e.Msg
}

func NewUserError(err error, msg string) *UserError {
	return &UserError{Err: err, Msg: msg}
}

func executeUsage(out io.Writer, templateName string, data any) error {
	return templates.GetTemplates().ExecuteTemplate(out, templateName, data)
}

type RootCmd struct {
	*flag.FlagSet
	Commands      map[string]func() Cmd
	Version       string
	Commit        string
	Date          string
	url           string
	flag          bool
	dep           string
	CommandAction func(c *RootCmd) error
}

func (c *RootCmd) Usage() {
	err := executeUsage(os.Stderr, "app_usage.txt", UsageDataRootCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *RootCmd) usageError(kind cmd.UsageErrorKind, flag string, cause error, format string, args ...any) error {
	return newUsageError(c.commandPath(), kind, flag, cause, format, args...)
}

func (c *RootCmd) commandPath() string { return "app" }

func (c *RootCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "app_usage.txt", UsageDataRootCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

type UsageDataRootCmd struct {
	*RootCmd
	Recursive bool
}

func NewRoot(name, version, commit, date string) (*RootCmd, error) {
	c := &RootCmd{
		FlagSet:  flag.NewFlagSet(name, flag.ExitOnError),
		Commands: make(map[string]func() Cmd),
		Version:  version,
		Commit:   commit,
		Date:     date,
	}
	c.FlagSet.Usage = c.Usage

	c.BoolVar(&c.flag, "flag", false, "Toggle flag.")
	c.BoolVar(&c.flag, "f", false, "Toggle flag.")

	c.CommandAction = func(c *RootCmd) error {

		err := app.Root(c.url, c.flag, c.dep)
		if err != nil {
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
				return err
			}
			if errors.Is(err, cmd.ErrPrintHelp) {
				c.Usage()
				return nil
			}
			if errors.Is(err, cmd.ErrHelp) {
				fmt.Fprintf(os.Stderr, "Use '%s help' for more information.\n", os.Args[0])
				return nil
			}
			if errors.Is(err, cmd.ErrUsage) {
				return err
			}
			return fmt.Errorf("app failed: %w", err)
		}
		return nil
	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewAliased() })
		c.Commands["aliased"] = subCmd

		c.Commands["al"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewGroup() })
		c.Commands["group"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewNested() })
		c.Commands["nested"] = subCmd

	}
	c.Commands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"help"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"usage"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["version"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				fmt.Printf("Version: %s\nCommit: %s\nDate: %s\n", c.Version, c.Commit, c.Date)
				return nil
			},
			UsageFunc: func() {
				fmt.Fprintf(os.Stderr, "Usage: %s version\n", os.Args[0])
			},
		}
	}
	return c, nil
}

func (c *RootCmd) Execute(args []string) (err error) {
	var cleanups []func() error
	defer func() {
		for i := len(cleanups) - 1; i >= 0; i-- {
			if cerr := cleanups[i](); cerr != nil && err == nil {
				err = cerr
			}
		}
	}()
	var remainingArgs []string
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {

			case "flag":
				if hasValue {
					b, err := strconv.ParseBool(value)
					if err != nil {
						return c.usageError(cmd.UsageInvalidValue, name, err, "invalid boolean value for flag %s: %s", name, value)
					}
					c.flag = b
				} else {
					c.flag = true
				}
			default:
				return c.usageError(cmd.UsageUnknownFlag, name, nil, "unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false

				if char == "f" {
					found = true
					c.flag = true
				}
				if !found {
					return c.usageError(cmd.UsageUnknownFlag, char, nil, "unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	isHelpRequest := !dashDashSeen && len(remainingArgs) > 0 && (remainingArgs[0] == "help" || remainingArgs[0] == "usage" || remainingArgs[0] == "version")
	if !isHelpRequest && !dashDashSeen {
		for _, arg := range remainingArgs {
			if arg == "--" {
				break
			}
			if arg == "-h" || arg == "--help" {
				isHelpRequest = true
				break
			}
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.Commands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}

	if isHelpRequest && len(remainingArgs) > 0 {
		c.Usage()
		return nil
	}
	if len(remainingArgs) < 1 {
		return c.usageError(cmd.UsageInvalidArguments, "", nil, "expected at least 1 positional arguments, got %d", len(remainingArgs))
	}
	// Handle positional argument url
	{
		argIndex := 0
		if argIndex >= 0 && argIndex < len(remainingArgs) {
			argVal := remainingArgs[argIndex]
			c.url = argVal
		} else {
		}
	}
	{
		v, err := app.Provider()
		if err != nil {
			return fmt.Errorf("failed to generate dep: %w", err)
		}
		c.dep = v
		if closer, ok := interface{}(v).(io.Closer); ok {
			cleanups = append(cleanups, closer.Close)
		}
	}
	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	}
	return nil
}
