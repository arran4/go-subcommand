// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"slices"
	"strings"

	app "example.com/helpissue"
	"example.com/helpissue/cmd"
)

var _ Cmd = (*GroupLeaf)(nil)

type GroupLeaf struct {
	*Group
	Flags         *flag.FlagSet
	pos           string
	tag           string
	output        io.Writer
	input         io.Reader
	custom        string
	dep           string
	extra         []string
	SubCommands   map[string]func() Cmd
	CommandAction func(c *GroupLeaf) error
}

type UsageDataGroupLeaf struct {
	*GroupLeaf
	Recursive bool
}

func (c *GroupLeaf) Usage() {
	err := executeUsage(os.Stderr, "leaf_usage.txt", UsageDataGroupLeaf{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *GroupLeaf) usageError(kind cmd.UsageErrorKind, flag string, cause error, format string, args ...any) error {
	return newUsageError(c.commandPath(), kind, flag, cause, format, args...)
}

func (c *GroupLeaf) commandPath() string { return "app group leaf" }

func (c *GroupLeaf) UsageRecursive() {
	err := executeUsage(os.Stderr, "leaf_usage.txt", UsageDataGroupLeaf{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *GroupLeaf) Execute(args []string) (err error) {
	var cleanups []func() error
	defer func() {
		for i := len(cleanups) - 1; i >= 0; i-- {
			if cerr := cleanups[i](); cerr != nil && err == nil {
				err = cerr
			}
		}
	}()
	var stagedIO []func() error
	var remainingArgs []string
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {

			case "tag":
				if !hasValue {
					if i+1 < len(args) {
						value = args[i+1]
						i++
					} else {
						return c.usageError(cmd.UsageMissingFlagValue, name, nil, "flag %s requires a value", name)
					}
				}
				c.tag = value

			case "output":
				if !hasValue {
					if i+1 < len(args) {
						value = args[i+1]
						i++
					} else {
						return c.usageError(cmd.UsageMissingFlagValue, name, nil, "flag %s requires a value", name)
					}
				}
				ioVal := value
				stagedIO = append(stagedIO, func() error {
					if ioVal == "-" {
						c.output = os.Stdout
					} else {
						f, err := generatedOpenWriter(ioVal)
						if err != nil {
							return err
						}
						cleanups = append(cleanups, f.Close)
						c.output = f
					}
					return nil
				})

			case "input":
				if !hasValue {
					if i+1 < len(args) {
						value = args[i+1]
						i++
					} else {
						return c.usageError(cmd.UsageMissingFlagValue, name, nil, "flag %s requires a value", name)
					}
				}
				ioVal := value
				stagedIO = append(stagedIO, func() error {
					if ioVal == "-" {
						c.input = os.Stdin
					} else {
						f, err := generatedOpenReader(ioVal)
						if err != nil {
							return err
						}
						cleanups = append(cleanups, f.Close)
						c.input = f
					}
					return nil
				})

			case "custom":
				if !hasValue {
					if i+1 < len(args) {
						value = args[i+1]
						i++
					} else {
						return c.usageError(cmd.UsageMissingFlagValue, name, nil, "flag %s requires a value", name)
					}
				}
				c.custom = value
			default:
				return c.usageError(cmd.UsageUnknownFlag, name, nil, "unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false

				if char == "t" {
					found = true
					// Value flag
					value := ""
					if j+1 < len(shorts) {
						// Value is the rest of the short flag
						value = shorts[j+1:]
						if strings.HasPrefix(value, "=") {
							value = value[1:]
						}
						j = len(shorts) // break inner loop
					} else {
						// Value is the next arg
						if i+1 < len(args) {
							value = args[i+1]
							i++
						} else {
							return c.usageError(cmd.UsageMissingFlagValue, char, nil, "flag -%s requires a value", char)
						}
					}
					c.tag = value
				}

				if char == "o" {
					found = true
					// Value flag
					value := ""
					if j+1 < len(shorts) {
						// Value is the rest of the short flag
						value = shorts[j+1:]
						if strings.HasPrefix(value, "=") {
							value = value[1:]
						}
						j = len(shorts) // break inner loop
					} else {
						// Value is the next arg
						if i+1 < len(args) {
							value = args[i+1]
							i++
						} else {
							return c.usageError(cmd.UsageMissingFlagValue, char, nil, "flag -%s requires a value", char)
						}
					}
					ioVal := value
					stagedIO = append(stagedIO, func() error {
						if ioVal == "-" {
							c.output = os.Stdout
						} else {
							f, err := generatedOpenWriter(ioVal)
							if err != nil {
								return err
							}
							cleanups = append(cleanups, f.Close)
							c.output = f
						}
						return nil
					})
				}

				if char == "i" {
					found = true
					// Value flag
					value := ""
					if j+1 < len(shorts) {
						// Value is the rest of the short flag
						value = shorts[j+1:]
						if strings.HasPrefix(value, "=") {
							value = value[1:]
						}
						j = len(shorts) // break inner loop
					} else {
						// Value is the next arg
						if i+1 < len(args) {
							value = args[i+1]
							i++
						} else {
							return c.usageError(cmd.UsageMissingFlagValue, char, nil, "flag -%s requires a value", char)
						}
					}
					ioVal := value
					stagedIO = append(stagedIO, func() error {
						if ioVal == "-" {
							c.input = os.Stdin
						} else {
							f, err := generatedOpenReader(ioVal)
							if err != nil {
								return err
							}
							cleanups = append(cleanups, f.Close)
							c.input = f
						}
						return nil
					})
				}

				if char == "c" {
					found = true
					// Value flag
					value := ""
					if j+1 < len(shorts) {
						// Value is the rest of the short flag
						value = shorts[j+1:]
						if strings.HasPrefix(value, "=") {
							value = value[1:]
						}
						j = len(shorts) // break inner loop
					} else {
						// Value is the next arg
						if i+1 < len(args) {
							value = args[i+1]
							i++
						} else {
							return c.usageError(cmd.UsageMissingFlagValue, char, nil, "flag -%s requires a value", char)
						}
					}
					c.custom = value
				}
				if !found {
					return c.usageError(cmd.UsageUnknownFlag, char, nil, "unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	isHelpRequest := !dashDashSeen && len(remainingArgs) > 0 && (remainingArgs[0] == "help" || remainingArgs[0] == "usage")
	if !isHelpRequest && !dashDashSeen {
		for _, arg := range remainingArgs {
			if arg == "--" {
				break
			}
			if arg == "-h" || arg == "--help" {
				isHelpRequest = true
				break
			}
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}

	if isHelpRequest && len(remainingArgs) > 0 {
		c.Usage()
		return nil
	}
	if len(remainingArgs) < 1 {
		return c.usageError(cmd.UsageInvalidArguments, "", nil, "expected at least 1 positional arguments, got %d", len(remainingArgs))
	}
	// Handle positional argument pos
	{
		argIndex := 0
		if argIndex >= 0 && argIndex < len(remainingArgs) {
			argVal := remainingArgs[argIndex]
			c.pos = argVal
		} else {
		}
	}
	// Handle vararg extra
	{
		varArgStart := 1
		if varArgStart > len(remainingArgs) {
			varArgStart = len(remainingArgs)
		}
		varArgs := remainingArgs[varArgStart:]
		c.extra = varArgs
	}
	for _, fn := range stagedIO {
		if err := fn(); err != nil {
			return err
		}
	}

	{
		v, err := app.Provider()
		if err != nil {
			return fmt.Errorf("failed to generate dep: %w", err)
		}
		c.dep = v
		if closer, ok := interface{}(v).(io.Closer); ok {
			cleanups = append(cleanups, closer.Close)
		}
	}
	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *Group) NewGroupLeaf() *GroupLeaf {
	set := flag.NewFlagSet("leaf", flag.ContinueOnError)
	v := &GroupLeaf{
		Group:       c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}

	set.StringVar(&v.tag, "tag", "default", "Tag label.")
	set.StringVar(&v.tag, "t", "default", "Tag label.")

	set.Func("output", "Output destination file.", func(s string) error {
		// Parsed manually in Execute
		return nil
	})
	set.Func("o", "Output destination file.", func(s string) error {
		// Parsed manually in Execute
		return nil
	})

	set.Func("input", "Input source file.", func(s string) error {
		// Parsed manually in Execute
		return nil
	})
	set.Func("i", "Input source file.", func(s string) error {
		// Parsed manually in Execute
		return nil
	})

	set.StringVar(&v.custom, "custom", "", "(parser: ParseCustom) Custom parsed value.")
	set.StringVar(&v.custom, "c", "", "(parser: ParseCustom) Custom parsed value.")
	set.Usage = v.Usage

	v.CommandAction = func(c *GroupLeaf) error {

		err := app.Leaf(c.pos, c.tag, c.output, c.input, c.custom, c.dep, c.extra...)
		if err != nil {
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
				return err
			}
			if errors.Is(err, cmd.ErrPrintHelp) {
				c.Usage()
				return nil
			}
			if errors.Is(err, cmd.ErrHelp) {
				fmt.Fprintf(os.Stderr, "Use '%s help' for more information.\n", os.Args[0])
				return nil
			}
			if errors.Is(err, cmd.ErrUsage) {
				return err
			}
			return fmt.Errorf("leaf failed: %w", err)
		}
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
