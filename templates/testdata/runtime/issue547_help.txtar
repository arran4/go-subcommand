Regression test for Issue #547: Leaf help and help after positionals.
Leaf commands must not advertise fictitious child subcommands.
Help flags must be accurately documented.
Help after a positional argument is handled without executing the action or provider.
The -- terminator retains its contract.

-- input/go.mod --
module example.com/helpissue

go 1.22

-- input/app.go --
package app

import (
	"fmt"
	"io"
	"os"
	"strings"
)

func record(msg string) {
	f, err := os.OpenFile("side_effects.log", os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
	if err == nil {
		fmt.Fprintln(f, msg)
		_ = f.Close()
	}
}

func Provider() (string, error) {
	record("provider called")
	return "provided", nil
}

func ParseCustom(val string) (string, error) {
	record(fmt.Sprintf("custom parser called with %s", val))
	return "PARSED:" + val, nil
}

// Root is a subcommand `app` -- Root command with positional and business generator.
//
// Flags:
//
//	flag: -f --flag Toggle flag.
//	dep: (generator: Provider) Injected dependency.
//	url: @1 URL target.
func Root(url string, flag bool, dep string) error {
	record(fmt.Sprintf("root url=%s flag=%t dep=%s", url, flag, dep))
	fmt.Printf("root url=%s flag=%t\n", url, flag)
	return nil
}

// Group is a subcommand `app group` -- Group for leaf command.
func Group() {}

// Leaf is a subcommand `app group leaf` -- Leaf command demonstration.
//
// Flags:
//
//	tag: -t --tag (default: "default") Tag label.
//	output: -o --output Output destination file.
//	input: -i --input Input source file.
//	custom: -c --custom (parser: ParseCustom) Custom parsed value.
//	dep: (generator: Provider) Injected dependency.
//	pos: @1 Positional argument.
//	extra: ... Extra trailing arguments.
func Leaf(pos string, tag string, output io.Writer, input io.Reader, custom string, dep string, extra ...string) error {
	record(fmt.Sprintf("leaf pos=%s tag=%s custom=%s extra=%s", pos, tag, custom, strings.Join(extra, ",")))
	if output != nil {
		_, _ = output.Write([]byte("written_data\n"))
	}
	fmt.Printf("leaf pos=%s tag=%s custom=%s extra=%s\n", pos, tag, custom, strings.Join(extra, ","))
	return nil
}

// Nested is a subcommand `app nested` -- Nested parent command.
func Nested() {}

// NestedChild is a subcommand `app nested child` -- Deep nested command.
//
// Flags:
//
//	item: @1 Item identifier.
func NestedChild(item string) error {
	record(fmt.Sprintf("nested item=%s", item))
	fmt.Printf("nested item=%s\n", item)
	return nil
}

// Aliased is a subcommand `app aliased` -- Directly aliased leaf command.
// Aliases: al
//
// Flags:
//
//	name: @1 Target name.
func Aliased(name string) error {
	record(fmt.Sprintf("aliased name=%s", name))
	fmt.Printf("aliased name=%s\n", name)
	return nil
}

