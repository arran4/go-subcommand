module example.com/unmatched

go 1.22
-- input/app.go --
package app

import (
	"fmt"
)

// Root is a subcommand `app`.
// CLI-Parser: plus-minus
//
// Flags:
//
//	a: -a Flag a.
//	n: -n Number option.
//	known: --known Known option.
//	args: (unmatched) Unmatched argv at root.
func Root(a bool, n int, known int, args []string) error {
	fmt.Printf("root: a=%v n=%d known=%d args=%q\n", a, n, known, args)
	return nil
}

// Volume is a subcommand `app volume`.
//
// Flags:
//
//	player: --player Select player.
//	args: (unmatched) Unmatched argv in volume.
func Volume(player string, args []string) error {
	fmt.Printf("volume: player=%s args=%q\n", player, args)
	return nil
}

// Child is a subcommand `app child`.
//
// Flags:
//
//	known: --known Known flag.
//	known2: --known2 Known flag 2.
//	args: (unmatched) Unmatched argv in child.
func Child(known string, known2 string, args []string) error {
	fmt.Printf("child: known=%s known2=%s args=%q\n", known, known2, args)
	return nil
}

// Run is a subcommand `app run`.
//
// Flags:
//
//	args: (unmatched) Unmatched argv in run.
func Run(args []string) error {
	fmt.Printf("run: args=%q\n", args)
	return nil
}

// Other is a subcommand `app other`.
//
// Flags:
//
//	flag: --flag Flag.
func Other(flag string) error {
	fmt.Printf("other: flag=%s\n", flag)
	return nil
}
