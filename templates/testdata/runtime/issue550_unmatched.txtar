// Scans args, validates all tokens and staged values before committing any changes.
// Preserves positional argument ordering and yields when encountering subcommands.
func parsePlusMinus(args []string, path string, short, long map[string]plusMinusOption, extra ...any) (remaining []string, seen map[string]bool, commit func() error, terminated bool, special string, err error) {
	var subcmdMap map[string]bool
	allowUnmatched := false
	for _, arg := range extra {
		switch v := arg.(type) {
		case bool:
			allowUnmatched = v
		case map[string]bool:
			subcmdMap = v
		}
	}

	stagedSeen := make(map[string]bool)
	var commits []func() error
	var positionals []string
	dashDashSeen := false
	frozen := false

	for i := 0; i < len(args); i++ {
		token, tokenErr := tokenizePlusMinus(args[i], path, short, long, allowUnmatched)
		if tokenErr != nil {
			return nil, stagedSeen, nil, false, "", tokenErr
		}
		if token.Special != "" {
