	err := executeUsage(os.Stderr, "other_usage.txt", UsageDataOther{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *Other) Execute(args []string) (err error) {
	plusMinusOptions := map[string]plusMinusOption{
		"flag": {
			Key:               "flag",
			Boolean:           false,
			IO:                false,
			SupportsBarePlus:  false,
			SupportsValuePlus: false,
			Set: func(value string) error {
				v := value
				c.flag = v
				return nil
			},
			StageMinus: func(value string) (func() error, error) {
				v := value
				return func() error {
					c.flag = v
					return nil
				}, nil
			},
			StageBarePlus: func() (func() error, error) {
				return nil, nil
			},
			StageValuePlus: func(value string) (func() error, error) {
				return nil, nil
			},
		},
		"a": {
			Key:               "a",
			Boolean:           true,
			IO:                false,
			SupportsBarePlus:  true,
			SupportsValuePlus: false,
			Set: func(value string) error {
				v, err := strconv.ParseBool(value)
				if err != nil {
					return err
				}
				c.a = v
				return nil
			},
			StageMinus: func(value string) (func() error, error) {
				v, err := strconv.ParseBool(value)
				if err != nil {
					return nil, err
				}
				return func() error {
					c.a = v
					return nil
				}, nil
			},
			StageBarePlus: func() (func() error, error) {
				v := false
				return func() error {
					c.a = v
					return nil
				}, nil
			},
			StageValuePlus: func(value string) (func() error, error) {
				return nil, nil
			},
		},
		"n": {
			Key:               "n",
			Boolean:           false,
			IO:                false,
			SupportsBarePlus:  false,
			SupportsValuePlus: false,
			Set: func(value string) error {
				v, err := strconv.Atoi(value)
				if err != nil {
					return err
				}
				c.n = v
				return nil
			},
			StageMinus: func(value string) (func() error, error) {
				v, err := strconv.Atoi(value)
				if err != nil {
					return nil, err
				}
				return func() error {
					c.n = v
					return nil
				}, nil
			},
			StageBarePlus: func() (func() error, error) {
				return nil, nil
			},
			StageValuePlus: func(value string) (func() error, error) {
				return nil, nil
			},
		},
		"known": {
			Key:               "known",
			Boolean:           false,
			IO:                false,
			SupportsBarePlus:  false,
			SupportsValuePlus: false,
			Set: func(value string) error {
				v, err := strconv.Atoi(value)
				if err != nil {
					return err
				}
				c.known = v
				return nil
			},
			StageMinus: func(value string) (func() error, error) {
				v, err := strconv.Atoi(value)
				if err != nil {
					return nil, err
				}
				return func() error {
					c.known = v
					return nil
				}, nil
			},
			StageBarePlus: func() (func() error, error) {
				return nil, nil
			},
			StageValuePlus: func(value string) (func() error, error) {
				return nil, nil
			},
		},
	}
	plusMinusShort := map[string]plusMinusOption{
		"a": plusMinusOptions["a"],
		"n": plusMinusOptions["n"],
	}
	plusMinusLong := map[string]plusMinusOption{
		"flag":  plusMinusOptions["flag"],
		"known": plusMinusOptions["known"],
	}
	_ = plusMinusOptions
	subcmdMap := make(map[string]bool)
	for name := range c.SubCommands {
		subcmdMap[name] = true
	}
	remainingArgs, seenFlags, commitFlags, dashDashSeen, pmSpecial, err := parsePlusMinus(args, c.commandPath(), plusMinusShort, plusMinusLong, subcmdMap)
	if err != nil {
		return err
	}
	if pmSpecial == "help" || pmSpecial == "usage" {
		c.Usage()
		return nil
	}
	if pmSpecial == "version" {
		fmt.Printf("Version: %s\nCommit: %s\nDate: %s\n", c.Version, c.Commit, c.Date)
		return nil
	}
	c.plusMinusCommit = commitFlags
	c.seenFlags = seenFlags

	isHelpRequest := !dashDashSeen && len(remainingArgs) > 0 && (remainingArgs[0] == "help" || remainingArgs[0] == "usage")
	if !isHelpRequest && !dashDashSeen {
		for _, arg := range remainingArgs {
			if arg == "--" {
				break
			}
			if arg == "-h" || arg == "--help" {
				isHelpRequest = true
				break
			}
		}
	}
	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}

	if isHelpRequest && len(remainingArgs) > 0 {
		c.Usage()
		return nil
	}
	if err := c.commitAll(); err != nil {
		return err
	}

	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *RootCmd) NewOther() *Other {
	set := flag.NewFlagSet("other", flag.ContinueOnError)
	v := &Other{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}

	set.StringVar(&v.flag, "flag", "", "Flag.")
	set.Usage = v.Usage

	v.CommandAction = func(c *Other) error {

		err := app.Other(c.flag)
		if err != nil {
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
				return err
			}
			if errors.Is(err, cmd.ErrPrintHelp) {
				c.Usage()
				return nil
			}
			if errors.Is(err, cmd.ErrHelp) {
				fmt.Fprintf(os.Stderr, "Use '%s help' for more information.\n", os.Args[0])
				return nil
			}
			if errors.Is(err, cmd.ErrUsage) {
				return err
			}
			return fmt.Errorf("other failed: %w", err)
		}
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
