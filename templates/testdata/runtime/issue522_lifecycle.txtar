func (c *RootCmd) Execute(args []string) (err error) {
	defer func() {
		c.cleanupMu.Lock()
		defer c.cleanupMu.Unlock()
		for i := len(c.cleanups) - 1; i >= 0; i-- {
			if cerr := c.cleanups[i](); cerr != nil && err == nil {
				err = cerr
			}
		}
		c.cleanups = nil
		for _, reset := range c.resets {
			reset()
		}
		c.resets = nil
	}()
	var remainingArgs []string
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {
			default:
