-- input/res/res.go --
package res

import (
	"fmt"
	"os"
)

type LocalRootRes struct{ Tag string }

func (l *LocalRootRes) Close() error {
	fmt.Printf("close:A-root:%s\n", l.Tag)
	if os.Getenv("FAIL_CLOSE_A") == "1" {
		return fmt.Errorf("close A failed")
	}
	return nil
}

func OpenLocalRoot() (*LocalRootRes, error) {
	fmt.Println("acquire:A-root")
	return &LocalRootRes{Tag: "root"}, nil
}

type LocalRes struct{ Tag string }

func (l *LocalRes) Close() error {
	fmt.Printf("close:A:%s\n", l.Tag)
	if os.Getenv("FAIL_CLOSE_A") == "1" {
		return fmt.Errorf("close A failed")
	}
	return nil
}

func OpenLocal() (*LocalRes, error) {
	fmt.Println("acquire:A")
	return &LocalRes{Tag: "sub"}, nil
}

type SharedRes struct{ Tag string }

func (s *SharedRes) Close() error {
	fmt.Printf("close:B:%s\n", s.Tag)
	if os.Getenv("FAIL_CLOSE_B") == "1" {
		return fmt.Errorf("close B failed")
	}
	return nil
}

func OpenShared() (*SharedRes, error) {
	if os.Getenv("FAIL_B") == "1" {
		fmt.Println("acquire:B:fail")
		return nil, fmt.Errorf("acquire B failed")
	}
	fmt.Println("acquire:B")
	return &SharedRes{Tag: "shared"}, nil
}
-- input/app.go --
package app

import (
	"fmt"
	"io"

	"example.com/mixedcleanup/res"
)

// Root is a subcommand `app` -- Root mixed local + shared closable resources.
// Requires: res.OpenShared
//
// Flags:
//
//	local: (generator: res.OpenLocalRoot) Unpromoted root local closable generator A.
//	skipB: --skip-b Do not acquire B.
//	failAction: --fail-action Return an error after acquiring B.
func Root(local *res.LocalRootRes, shared func() (*res.SharedRes, error), skipB bool, failAction bool) error {
	if skipB {
		fmt.Printf("action:skip-B:%s\n", local.Tag)
		return nil
	}
	fmt.Printf("action:before-B:%s\n", local.Tag)
	b, err := shared()
	if err != nil {
		return err
	}
	if failAction {
		fmt.Printf("action:fail:%s\n", b.Tag)
		return fmt.Errorf("action failed")
	}
	fmt.Printf("action:after-B:%s:%s\n", local.Tag, b.Tag)
	return nil
}

// Mix is a subcommand `app mix` -- Subcommand mixed local + shared closable resources.
// Requires: res.OpenShared
//
// Flags:
//
//	local: (generator: res.OpenLocal) Unpromoted subcommand local closable generator A.
//	skipB: --skip-b Do not acquire B.
//	failAction: --fail-action Return an error after acquiring B.
//	out: -o --out (default: "-") Optional output stream.
func Mix(local *res.LocalRes, shared func() (*res.SharedRes, error), skipB bool, failAction bool, out io.Writer) error {
	if skipB {
		fmt.Printf("action:skip-B:%s\n", local.Tag)
		return nil
	}
	fmt.Printf("action:before-B:%s\n", local.Tag)
	b, err := shared()
	if err != nil {
		return err
	}
	if failAction {
		fmt.Printf("action:fail:%s\n", b.Tag)
		return fmt.Errorf("action failed")
	}
	_, _ = fmt.Fprintf(out, "action:after-B:%s:%s\n", local.Tag, b.Tag)
	return nil
}
