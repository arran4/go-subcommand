		}
	}

	isHelpRequest := !dashDashSeen && len(remainingArgs) > 0 && (remainingArgs[0] == "help" || remainingArgs[0] == "usage")
	if !isHelpRequest && !dashDashSeen {
		for _, arg := range remainingArgs {
			if arg == "--" {
				break
			}
			if arg == "-h" || arg == "--help" {
				isHelpRequest = true
				break
			}
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}

	if isHelpRequest && len(remainingArgs) > 0 {
		c.Usage()
		return nil
	}
	for _, fn := range stagedIO {
		if err := fn(); err != nil {
			return err
		}
	}

	if !seenFlags["out"] {
		if "-" == "-" {
			c.out = c.outputStdout()
		} else {
			f, err := generatedOpenWriter("-")
			if err != nil {
				return err
			}
			cleanups = append(cleanups, f.Close)
			c.out = f
		}
	}
	c.shared = c.Shared
	{
		v, err := res.OpenLocal()
		if err != nil {
			return fmt.Errorf("failed to generate local: %w", err)
		}
		c.local = v
		if closer, ok := interface{}(v).(io.Closer); ok {
			c.registerCleanup(closer.Close)
		}
	}
	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *RootCmd) NewMix() *Mix {
	set := flag.NewFlagSet("mix", flag.ContinueOnError)
	v := &Mix{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}
	set.SetOutput(v.outputStderr())

	set.BoolVar(&v.skipB, "skip-b", false, "Do not acquire B.")

	set.BoolVar(&v.failAction, "fail-action", false, "Return an error after acquiring B.")

	set.Func("out", "Optional output stream.", func(s string) error {
		// Parsed manually in Execute
		return nil
	})
	set.Func("o", "Optional output stream.", func(s string) error {
		// Parsed manually in Execute
		return nil
	})
	set.Usage = v.Usage

	v.CommandAction = func(c *Mix) error {

		err := app.Mix(c.local, c.shared, c.skipB, c.failAction, c.out)
		if err != nil {
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
				return err
			}
			if errors.Is(err, cmd.ErrPrintHelp) {
				c.Usage()
				return nil
			}
			if errors.Is(err, cmd.ErrHelp) {
				fmt.Fprintf(c.outputStderr(), "Use '%s help' for more information.\n", os.Args[0])
				return nil
			}
			if errors.Is(err, cmd.ErrUsage) {
				return err
			}
			return fmt.Errorf("mix failed: %w", err)
		}
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
