func (c *RootCmd) NewSub() *Sub {
	set := flag.NewFlagSet("sub", flag.ContinueOnError)
	v := &Sub{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}
	set.Usage = v.Usage

	v.CommandAction = func(c *Sub) error {

		err := app.Sub(c.target)
		if err != nil {
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
				return err
			}
			if errors.Is(err, cmd.ErrPrintHelp) {
