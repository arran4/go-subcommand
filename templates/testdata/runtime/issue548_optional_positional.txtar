Regression test for Issue #548: Explicitly optional root positionals.
When a positional argument is marked (optional), it must not be treated as mandatory.
Bare invocation runs the root action with zero-value without requiring positional count checks.
Required positionals remain enforced.
Explicit subcommands work.

-- input/go.mod --
module example.com/optionalpos

go 1.22

-- input/app.go --
package app

import (
	"fmt"
)

// Root is a subcommand `app` -- Application with optional root positional.
//
// Flags:
//
//	url: @1 (optional) URL to extract
//	verbose: -v --verbose Verbose output
func Root(url string, verbose bool) error {
	if url == "" {
		fmt.Println("Usage policy: displaying root help")
		return nil
	}
	fmt.Printf("extracted: %s (verbose=%t)\n", url, verbose)
	return nil
}

// Sub is a subcommand `app sub` -- Explicit subcommand with required positional.
//
// Flags:
//
//	target: @1 (required) Required target
func Sub(target string) error {
	fmt.Printf("sub: %s\n", target)
	return nil
}

// Pair is a subcommand `app pair` -- Subcommand with required positional followed by optional positional.
//
// Flags:
//
//	first: @1 (required) First required target
//	second: @2 (optional) Second optional target
func Pair(first string, second string) error {
	fmt.Printf("pair: first=%s second=%s\n", first, second)
	return nil
}

-- expected/invocations.json --
[
  {"args": [], "stdout": "Usage policy: displaying root help\n"},
  {"args": ["https://example.com"], "stdout": "extracted: https://example.com (verbose=false)\n"},
  {"args": ["--", "https://example.com"], "stdout": "extracted: https://example.com (verbose=false)\n"},
  {"args": ["-v", "https://example.com"], "stdout": "extracted: https://example.com (verbose=true)\n"},
  {"args": ["sub", "my-target"], "stdout": "sub: my-target\n"},
  {"args": ["sub", "--", "my-target"], "stdout": "sub: my-target\n"},
  {"args": ["sub"], "status": 1, "stderr": "Error: expected at least 1 positional arguments, got 0\n"},
  {"args": ["pair", "arg1"], "stdout": "pair: first=arg1 second=\n"},
  {"args": ["pair", "arg1", "arg2"], "stdout": "pair: first=arg1 second=arg2\n"},
  {"args": ["pair", "--", "arg1", "arg2"], "stdout": "pair: first=arg1 second=arg2\n"},
  {"args": ["pair"], "status": 1, "stderr": "Error: expected at least 1 positional arguments, got 0\n"}
]
-- expected/root.go --
// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"slices"
	"strconv"
	"strings"
	"sync"

	app "example.com/optionalpos"
	"example.com/optionalpos/cmd"
	"example.com/optionalpos/cmd/app/templates"
)

type Cmd interface {
	Execute(args []string) error
	Usage()
}

type InternalCommand struct {
	Exec      func(args []string) error
	UsageFunc func()
}

func (c *InternalCommand) Execute(args []string) error {
	return c.Exec(args)
}

func (c *InternalCommand) Usage() {
	c.UsageFunc()
}

func NewLazyCommand(f func() Cmd) func() Cmd {
	var once sync.Once
	var cmd Cmd
	return func() Cmd {
		once.Do(func() {
			cmd = f()
		})
		return cmd
	}
}

type UserError struct {
	Err error
	Msg string
}

func (e *UserError) Error() string {
	if e.Err != nil {
		return fmt.Sprintf("%s: %v", e.Msg, e.Err)
	}
	return e.Msg
}

func NewUserError(err error, msg string) *UserError {
	return &UserError{Err: err, Msg: msg}
}

func executeUsage(out io.Writer, templateName string, data any) error {
	return templates.GetTemplates().ExecuteTemplate(out, templateName, data)
}

type RootCmd struct {
	*flag.FlagSet
	Commands      map[string]func() Cmd
	Version       string
	Commit        string
	Date          string
	url           string
	verbose       bool
	CommandAction func(c *RootCmd) error
}

func (c *RootCmd) Usage() {
	err := executeUsage(os.Stderr, "app_usage.txt", UsageDataRootCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *RootCmd) usageError(kind cmd.UsageErrorKind, flag string, cause error, format string, args ...any) error {
	return newUsageError(c.commandPath(), kind, flag, cause, format, args...)
}

func (c *RootCmd) commandPath() string { return "app" }

func (c *RootCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "app_usage.txt", UsageDataRootCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

type UsageDataRootCmd struct {
	*RootCmd
	Recursive bool
}

func NewRoot(name, version, commit, date string) (*RootCmd, error) {
	c := &RootCmd{
		FlagSet:  flag.NewFlagSet(name, flag.ExitOnError),
		Commands: make(map[string]func() Cmd),
		Version:  version,
		Commit:   commit,
		Date:     date,
	}
	c.FlagSet.Usage = c.Usage

	c.BoolVar(&c.verbose, "verbose", false, "Verbose output")
	c.BoolVar(&c.verbose, "v", false, "Verbose output")

	c.CommandAction = func(c *RootCmd) error {

		err := app.Root(c.url, c.verbose)
		if err != nil {
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
				return err
			}
			if errors.Is(err, cmd.ErrPrintHelp) {
				c.Usage()
				return nil
			}
			if errors.Is(err, cmd.ErrHelp) {
				fmt.Fprintf(os.Stderr, "Use '%s help' for more information.\n", os.Args[0])
				return nil
			}
			if errors.Is(err, cmd.ErrUsage) {
				return err
			}
			return fmt.Errorf("app failed: %w", err)
		}
		return nil
	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewPair() })
		c.Commands["pair"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewSub() })
		c.Commands["sub"] = subCmd

	}
	c.Commands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"help"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"usage"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["version"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				fmt.Printf("Version: %s\nCommit: %s\nDate: %s\n", c.Version, c.Commit, c.Date)
				return nil
			},
			UsageFunc: func() {
				fmt.Fprintf(os.Stderr, "Usage: %s version\n", os.Args[0])
			},
		}
	}
	return c, nil
}

func (c *RootCmd) Execute(args []string) (err error) {
	var remainingArgs []string
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {

			case "verbose":
				if hasValue {
					b, err := strconv.ParseBool(value)
					if err != nil {
						return c.usageError(cmd.UsageInvalidValue, name, err, "invalid boolean value for flag %s: %s", name, value)
					}
					c.verbose = b
				} else {
					c.verbose = true
				}
			default:
				return c.usageError(cmd.UsageUnknownFlag, name, nil, "unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false

				if char == "v" {
					found = true
					c.verbose = true
				}
				if !found {
					return c.usageError(cmd.UsageUnknownFlag, char, nil, "unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	isHelpRequest := !dashDashSeen && len(remainingArgs) > 0 && (remainingArgs[0] == "help" || remainingArgs[0] == "usage" || remainingArgs[0] == "version")
	if !isHelpRequest && !dashDashSeen {
		for _, arg := range remainingArgs {
			if arg == "--" {
				break
			}
			if arg == "-h" || arg == "--help" {
				isHelpRequest = true
				break
			}
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.Commands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}

	if isHelpRequest && len(remainingArgs) > 0 {
		c.Usage()
		return nil
	}
	// Handle positional argument url
	{
		argIndex := 0
		if argIndex >= 0 && argIndex < len(remainingArgs) {
			argVal := remainingArgs[argIndex]
			c.url = argVal
		} else {
		}
	}
	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	}
	return nil
}
