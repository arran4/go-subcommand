module example.com/contextpresence

go 1.22
-- input/buildinfo/buildinfo.go --
package buildinfo

type BuildInfo struct {
	Version string
	Record func(string)
}
-- input/app.go --
package app

import (
	"encoding/json"
	"fmt"

	"example.com/contextpresence/buildinfo"
)

// Root is a subcommand `app` -- Report root state.
//
// Flags:
//
//	info: (root context) Constructor-owned build information.
//	enabled: --enabled -e (default: true) Enable output.
//	count: --count -n (default: 7) Count.
//	label: --label -l (default: "default") Label.
//	seen: (flag presence) Explicit inputs.
func Root(info buildinfo.BuildInfo, enabled bool, count int, label string, seen map[string]bool) error {
	return report("root", info, enabled, count, label, seen)
}

// Child is a subcommand `app child` -- Report inherited context.
//
// Flags:
//
//	info: (from parent) Constructor-owned build information.
//	enabled: --enabled -e (default: true) Enable output.
//	count: --count -n (default: 7) Count.
//	label: --label -l (default: "default") Label.
//	seen: (flag presence) Explicit inputs.
func Child(info buildinfo.BuildInfo, enabled bool, count int, label string, seen map[string]bool) error {
	return report("child", info, enabled, count, label, seen)
}

// Grandchild is a subcommand `app child grandchild` -- Report deeply inherited context.
//
// Flags:
//
//	info: (from parent) Constructor-owned build information.
//	enabled: --enabled -e (default: true) Enable output.
//	count: --count -n (default: 7) Count.
//	label: --label -l (default: "default") Label.
//	seen: (flag presence) Explicit inputs.
func Grandchild(info buildinfo.BuildInfo, enabled bool, count int, label string, seen map[string]bool) error {
	return report("grandchild", info, enabled, count, label, seen)
}

func report(path string, info buildinfo.BuildInfo, enabled bool, count int, label string, seen map[string]bool) error {
	if info.Version == "reject" { return fmt.Errorf("context rejected") }
	flags, _ := json.Marshal(seen)
	line := fmt.Sprintf("%s version=%q enabled=%t count=%d label=%q seen=%s", path, info.Version, enabled, count, label, flags)
	if info.Record != nil { info.Record(line) } else { fmt.Println(line) }
	return nil
}
-- expected/contract_test.go --
package main

import (
	"reflect"
	"testing"

	"example.com/contextpresence/buildinfo"
)

func TestConstructorAndPresence(t *testing.T) {
	var got []string
	info := buildinfo.BuildInfo{Version: "supplied", Record: func(line string) { got = append(got, line) }}
	for _, tc := range []struct { args []string; want string }{
		{nil, `root version="supplied" enabled=true count=7 label="default" seen={}`},
		{[]string{"--enabled=false", "--count=0", "--label="}, `root version="supplied" enabled=false count=0 label="" seen={"count":true,"enabled":true,"label":true}`},
		{[]string{"child"}, `child version="supplied" enabled=true count=7 label="default" seen={}`},
		{[]string{"child", "grandchild", "--enabled=false", "-n", "0", "-l", ""}, `grandchild version="supplied" enabled=false count=0 label="" seen={"count":true,"enabled":true,"label":true}`},
	} {
		root, err := NewRootWithContext("app", "dev", "none", "unknown", info)
		if err != nil { t.Fatal(err) }
		got = nil
		if err := root.Execute(tc.args); err != nil { t.Fatal(err) }
		if !reflect.DeepEqual(got, []string{tc.want}) { t.Fatalf("%v: got %q want %q", tc.args, got, tc.want) }
		child := root.Commands["child"]().(*Child)
		grandchild := child.SubCommands["grandchild"]()
		// Constructor state belongs only to RootCmd, promoted through embedding.
		for _, node := range []any{child, grandchild} {
			typ := reflect.TypeOf(node).Elem()
			for i := 0; i < typ.NumField(); i++ {
				if typ.Field(i).Type == reflect.TypeOf(info) { t.Fatalf("%s shadows constructor state", typ) }
			}
		}
	}
	root, err := NewRootWithContext("app", "dev", "none", "unknown", buildinfo.BuildInfo{Version: "reject"})
	if err != nil { t.Fatal(err) }
	if err := root.Execute([]string{"child", "grandchild"}); err == nil || err.Error() != "grandchild failed: context rejected" { t.Fatalf("action error=%v", err) }
	for _, args := range [][]string{{"help"}, {"usage", "child", "grandchild"}, {"--help"}, {"version"}} {
		root, err := NewRootWithContext("app", "dev", "none", "unknown", info)
		if err != nil { t.Fatal(err) }
		got = nil
		if err := root.Execute(args); err != nil { t.Fatal(err) }
		if len(got) != 0 { t.Fatalf("%v executed an action", args) }
	}
	// Reusing a tree must not retain the previous invocation's presence keys.
	root, err = NewRootWithContext("app", "dev", "none", "unknown", info)
	if err != nil { t.Fatal(err) }
	if err := root.Execute([]string{"--count=0"}); err != nil { t.Fatal(err) }
	got = nil
	if err := root.Execute([]string{"--label="}); err != nil { t.Fatal(err) }
	if !reflect.DeepEqual(got, []string{`root version="supplied" enabled=true count=0 label="" seen={"label":true}`}) { t.Fatalf("presence leaked: %q", got) }
}
