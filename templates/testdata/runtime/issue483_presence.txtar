// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"slices"
	"strconv"
	"strings"
	"sync"

	app "example.com/contextpresence"
	"example.com/contextpresence/buildinfo"
	"example.com/contextpresence/cmd"
	"example.com/contextpresence/cmd/app/templates"
)

type Cmd interface {
	Execute(args []string) error
	Usage()
}

type InternalCommand struct {
	Exec      func(args []string) error
	UsageFunc func()
}

func (c *InternalCommand) Execute(args []string) error {
	return c.Exec(args)
}

func (c *InternalCommand) Usage() {
	c.UsageFunc()
}

func NewLazyCommand(f func() Cmd) func() Cmd {
	var once sync.Once
	var cmd Cmd
	return func() Cmd {
		once.Do(func() {
			cmd = f()
		})
		return cmd
	}
}

type UserError struct {
	Err error
	Msg string
}

func (e *UserError) Error() string {
	if e.Err != nil {
		return fmt.Sprintf("%s: %v", e.Msg, e.Err)
	}
	return e.Msg
}

func NewUserError(err error, msg string) *UserError {
	return &UserError{Err: err, Msg: msg}
}

func executeUsage(out io.Writer, templateName string, data any) error {
	return templates.GetTemplates().ExecuteTemplate(out, templateName, data)
}

type RootCmd struct {
	*flag.FlagSet
	Commands      map[string]func() Cmd
	Version       string
	Commit        string
	Date          string
	info          buildinfo.BuildInfo
	enabled       bool
	count         int
	label         string
	seen          map[string]bool
	CommandAction func(c *RootCmd) error
}

func (c *RootCmd) Usage() {
	err := executeUsage(os.Stderr, "app_usage.txt", UsageDataRootCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *RootCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "app_usage.txt", UsageDataRootCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

type UsageDataRootCmd struct {
	*RootCmd
	Recursive bool
}

// NewRoot retains the no-context constructor contract. Call
// NewRootWithContext when the application owns typed root context.
func NewRoot(name, version, commit, date string) (*RootCmd, error) {
	var info buildinfo.BuildInfo
	return NewRootWithContext(name, version, commit, date, info)
}

func NewRootWithContext(name, version, commit, date string, info buildinfo.BuildInfo) (*RootCmd, error) {
	c := &RootCmd{
		FlagSet:  flag.NewFlagSet(name, flag.ExitOnError),
		Commands: make(map[string]func() Cmd),
		Version:  version,
		Commit:   commit,
		Date:     date,
		info:     info,
	}
	c.FlagSet.Usage = c.Usage

	c.BoolVar(&c.enabled, "enabled", true, "Enable output.")
	c.BoolVar(&c.enabled, "e", true, "Enable output.")

	c.IntVar(&c.count, "count", 7, "Count.")
	c.IntVar(&c.count, "n", 7, "Count.")

	c.StringVar(&c.label, "label", "default", "Label.")
	c.StringVar(&c.label, "l", "default", "Label.")

	c.CommandAction = func(c *RootCmd) error {

		err := app.Root(c.info, c.enabled, c.count, c.label, c.seen)
		if err != nil {
			if errors.Is(err, cmd.ErrPrintHelp) {
				c.Usage()
				return nil
			}
			if errors.Is(err, cmd.ErrHelp) {
				fmt.Fprintf(os.Stderr, "Use '%s help' for more information.\n", os.Args[0])
				return nil
			}
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
				return exitCode
			}
			return fmt.Errorf("app failed: %w", err)
		}
		return nil
	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewChild() })
		c.Commands["child"] = subCmd

	}
	c.Commands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"help"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return fmt.Errorf("unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"usage"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return fmt.Errorf("unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["version"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				fmt.Printf("Version: %s\nCommit: %s\nDate: %s\n", c.Version, c.Commit, c.Date)
				return nil
			},
			UsageFunc: func() {
				fmt.Fprintf(os.Stderr, "Usage: %s version\n", os.Args[0])
			},
		}
	}
	return c, nil
}

func (c *RootCmd) Execute(args []string) (err error) {
	var remainingArgs []string
	seenFlags := make(map[string]bool)
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {

			case "enabled":
				seenFlags["enabled"] = true
				if hasValue {
					b, err := strconv.ParseBool(value)
					if err != nil {
						return fmt.Errorf("invalid boolean value for flag %s: %s", name, value)
					}
					c.enabled = b
				} else {
					c.enabled = true
				}

			case "count":
				seenFlags["count"] = true
				if !hasValue {
					if i+1 < len(args) {
						value = args[i+1]
						i++
					} else {
						return fmt.Errorf("flag %s requires a value", name)
					}
				}
				v, err := strconv.Atoi(value)
				if err != nil {
					return fmt.Errorf("invalid integer value for flag %s: %s", name, value)
				}
				c.count = v

			case "label":
				seenFlags["label"] = true
				if !hasValue {
					if i+1 < len(args) {
						value = args[i+1]
						i++
					} else {
						return fmt.Errorf("flag %s requires a value", name)
					}
				}
				c.label = value
			default:
				return fmt.Errorf("unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false

				if char == "e" {
					found = true
					seenFlags["enabled"] = true
					c.enabled = true
				}

				if char == "n" {
					found = true
					seenFlags["count"] = true
					// Value flag
					value := ""
					if j+1 < len(shorts) {
						// Value is the rest of the short flag
						value = shorts[j+1:]
						if strings.HasPrefix(value, "=") {
							value = value[1:]
						}
						j = len(shorts) // break inner loop
					} else {
						// Value is the next arg
						if i+1 < len(args) {
							value = args[i+1]
							i++
						} else {
							return fmt.Errorf("flag -%s requires a value", char)
						}
					}
					v, err := strconv.Atoi(value)
					if err != nil {
						return fmt.Errorf("invalid integer value for flag -%s: %s", char, value)
					}
					c.count = v
				}

				if char == "l" {
					found = true
					seenFlags["label"] = true
					// Value flag
					value := ""
					if j+1 < len(shorts) {
						// Value is the rest of the short flag
						value = shorts[j+1:]
						if strings.HasPrefix(value, "=") {
							value = value[1:]
						}
						j = len(shorts) // break inner loop
					} else {
						// Value is the next arg
						if i+1 < len(args) {
							value = args[i+1]
							i++
						} else {
							return fmt.Errorf("flag -%s requires a value", char)
						}
					}
					c.label = value
				}
				if !found {
					return fmt.Errorf("unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.Commands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
		c.Usage()
		return fmt.Errorf("unknown command: %s", remainingArgs[0])
	}
	c.seen = seenFlags
	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	}
	return nil
}
