		c.Usage()
	}

	return nil
}

func (c *Child) NewChildGrandchild() *ChildGrandchild {
	set := flag.NewFlagSet("grandchild", flag.ContinueOnError)
	v := &ChildGrandchild{
		Child:       c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}

	set.BoolVar(&v.enabled, "enabled", true, "Enable output.")
	set.BoolVar(&v.enabled, "e", true, "Enable output.")

	set.IntVar(&v.count, "count", 7, "Count.")
	set.IntVar(&v.count, "n", 7, "Count.")

	set.StringVar(&v.label, "label", "default", "Label.")
	set.StringVar(&v.label, "l", "default", "Label.")
	set.Usage = v.Usage

	v.CommandAction = func(c *ChildGrandchild) error {

		err := app.Grandchild(c.info, c.enabled, c.count, c.label, c.seen)
		if err != nil {
			if errors.Is(err, cmd.ErrPrintHelp) {
				c.Usage()
				return nil
			}
			if errors.Is(err, cmd.ErrHelp) {
				fmt.Fprintf(os.Stderr, "Use '%s help' for more information.\n", os.Args[0])
				return nil
			}
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
				return exitCode
			}
			return fmt.Errorf("grandchild failed: %w", err)
		}
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
