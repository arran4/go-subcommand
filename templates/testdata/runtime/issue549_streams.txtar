var generatedOpenReader = func(name string) (io.ReadCloser, error) {
	return os.Open(name)
}

var generatedOpenWriter = func(name string) (io.WriteCloser, error) {
	return os.OpenFile(name, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0666)
}

type nopWriteCloser struct {
	io.Writer
}

func (nopWriteCloser) Close() error { return nil }

func toWriteCloser(w io.Writer) io.WriteCloser {
	if wc, ok := w.(io.WriteCloser); ok {
		return wc
	}
	return nopWriteCloser{w}
}

type Cmd interface {
	Execute(args []string) error
	Usage()
}

type InternalCommand struct {
	Exec      func(args []string) error
	UsageFunc func()
}

func (c *InternalCommand) Execute(args []string) error {
	return c.Exec(args)
}

func (c *InternalCommand) Usage() {
	c.UsageFunc()
}

func NewLazyCommand(f func() Cmd) func() Cmd {
	var once sync.Once
	var cmd Cmd
	return func() Cmd {
		once.Do(func() {
			cmd = f()
		})
		return cmd
	}
}

type UserError struct {
	Err error
	Msg string
}

func (e *UserError) Error() string {
	if e.Err != nil {
		return fmt.Sprintf("%s: %v", e.Msg, e.Err)
	}
	return e.Msg
}

func NewUserError(err error, msg string) *UserError {
	return &UserError{Err: err, Msg: msg}
}

func executeUsage(out io.Writer, templateName string, data any) error {
	return templates.GetTemplates().ExecuteTemplate(out, templateName, data)
}

type RootCmd struct {
	*flag.FlagSet
	Commands      map[string]func() Cmd
	Version       string
	Commit        string
	Date          string
	Stdin         io.Reader
	Stdout        io.Writer
	Stderr        io.Writer
	name          string
	err           bool
	helpErr       bool
	exitErr       bool
	CommandAction func(c *RootCmd) error
}

func (c *RootCmd) outputStdout() io.Writer {
	if c != nil && c.Stdout != nil {
		return c.Stdout
	}
	return os.Stdout
}

func (c *RootCmd) outputStderr() io.Writer {
	if c != nil && c.Stderr != nil {
		return c.Stderr
	}
	return os.Stderr
}

func (c *RootCmd) inputStdin() io.Reader {
	if c != nil && c.Stdin != nil {
		return c.Stdin
	}
	return os.Stdin
}

func (c *RootCmd) SetStreams(stdout, stderr io.Writer) {
	c.Stdout = stdout
	c.Stderr = stderr
	if c.FlagSet != nil {
		c.FlagSet.SetOutput(c.outputStderr())
	}
}

func (c *RootCmd) SetIO(stdin io.Reader, stdout, stderr io.Writer) {
	c.Stdin = stdin
	c.Stdout = stdout
	c.Stderr = stderr
	if c.FlagSet != nil {
		c.FlagSet.SetOutput(c.outputStderr())
	}
}

func (c *RootCmd) Usage() {
	err := executeUsage(c.outputStderr(), "app_usage.txt", UsageDataRootCmd{c, false})
	if err != nil {
		fmt.Fprintf(c.outputStderr(), "Error generating usage: %s\n", err)
	}
}

func (c *RootCmd) usageError(kind cmd.UsageErrorKind, flag string, cause error, format string, args ...any) error {
	return newUsageError(c.commandPath(), kind, flag, cause, format, args...)
}

func (c *RootCmd) commandPath() string { return "app" }

func (c *RootCmd) UsageRecursive() {
	err := executeUsage(c.outputStderr(), "app_usage.txt", UsageDataRootCmd{c, true})
	if err != nil {
		fmt.Fprintf(c.outputStderr(), "Error generating usage: %s\n", err)
	}
}

type UsageDataRootCmd struct {
	*RootCmd
	Recursive bool
}

func NewRoot(name, version, commit, date string) (*RootCmd, error) {
	c := &RootCmd{
		FlagSet:  flag.NewFlagSet(name, flag.ExitOnError),
		Commands: make(map[string]func() Cmd),
		Version:  version,
		Commit:   commit,
		Date:     date,
	}
	c.FlagSet.SetOutput(c.outputStderr())
	c.FlagSet.Usage = c.Usage

	c.StringVar(&c.name, "name", "world", "Name to greet.")
	c.StringVar(&c.name, "n", "world", "Name to greet.")

	c.BoolVar(&c.err, "err", false, "Trigger user error.")

	c.BoolVar(&c.helpErr, "help-err", false, "Trigger help error.")

	c.BoolVar(&c.exitErr, "exit-err", false, "Trigger explicit exit status.")

	c.CommandAction = func(c *RootCmd) error {

		err := app.Root(c.name, c.err, c.helpErr, c.exitErr)
		if err != nil {
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
				return err
			}
			if errors.Is(err, cmd.ErrPrintHelp) {
				c.Usage()
				return nil
			}
			if errors.Is(err, cmd.ErrHelp) {
				fmt.Fprintf(c.outputStderr(), "Use '%s help' for more information.\n", os.Args[0])
				return nil
			}
			if errors.Is(err, cmd.ErrUsage) {
				return err
			}
			return fmt.Errorf("app failed: %w", err)
		}
		return nil
	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewChild() })
		c.Commands["child"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewEcho() })
		c.Commands["echo"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewMixed() })
		c.Commands["mixed"] = subCmd

	}
	c.Commands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"help"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"usage"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["version"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				fmt.Fprintf(c.outputStdout(), "Version: %s\nCommit: %s\nDate: %s\n", c.Version, c.Commit, c.Date)
				return nil
			},
			UsageFunc: func() {
				fmt.Fprintf(c.outputStderr(), "Usage: %s version\n", os.Args[0])
			},
		}
	}
	return c, nil
}

func (c *RootCmd) Execute(args []string) (err error) {
	var remainingArgs []string
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {

			case "name":
				if !hasValue {
					if i+1 < len(args) {
						value = args[i+1]
						i++
					} else {
						return c.usageError(cmd.UsageMissingFlagValue, name, nil, "flag %s requires a value", name)
					}
				}
				c.name = value

			case "err":
				if hasValue {
					b, err := strconv.ParseBool(value)
					if err != nil {
						return c.usageError(cmd.UsageInvalidValue, name, err, "invalid boolean value for flag %s: %s", name, value)
					}
					c.err = b
				} else {
					c.err = true
				}

			case "helpErr", "help-err":
				if hasValue {
					b, err := strconv.ParseBool(value)
					if err != nil {
						return c.usageError(cmd.UsageInvalidValue, name, err, "invalid boolean value for flag %s: %s", name, value)
					}
					c.helpErr = b
				} else {
					c.helpErr = true
				}

			case "exitErr", "exit-err":
				if hasValue {
					b, err := strconv.ParseBool(value)
					if err != nil {
						return c.usageError(cmd.UsageInvalidValue, name, err, "invalid boolean value for flag %s: %s", name, value)
					}
					c.exitErr = b
				} else {
					c.exitErr = true
				}
			default:
				return c.usageError(cmd.UsageUnknownFlag, name, nil, "unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false

				if char == "n" {
					found = true
					// Value flag
					value := ""
					if j+1 < len(shorts) {
						// Value is the rest of the short flag
						value = shorts[j+1:]
						if strings.HasPrefix(value, "=") {
							value = value[1:]
						}
						j = len(shorts) // break inner loop
					} else {
						// Value is the next arg
						if i+1 < len(args) {
							value = args[i+1]
							i++
						} else {
							return c.usageError(cmd.UsageMissingFlagValue, char, nil, "flag -%s requires a value", char)
						}
					}
					c.name = value
				}

				if !found {
					return c.usageError(cmd.UsageUnknownFlag, char, nil, "unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.Commands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
		c.Usage()
		return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", remainingArgs[0])
	}
	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	}
	return nil
}
