-- input/app.go --
package app

import (
	"errors"
	"fmt"
	"io"

	"example.com/streams/cmd"
)

// Root is a subcommand `app` -- Streams application root.
// CLI-Parser: gnu
//
// Flags:
//
//	name: -n --name (default: "world") Name to greet.
//	err: --err Trigger user error.
//	helpErr: --help-err Trigger help error.
//	exitErr: --exit-err Trigger explicit exit status.
func Root(name string, err bool, helpErr bool, exitErr bool) error {
	if err {
		return errors.New("root failed explicitly")
	}
	if helpErr {
		return cmd.ErrHelp
	}
	if exitErr {
		return &cmd.ErrExitCode{Code: 42, Err: errors.New("custom exit code")}
	}
	fmt.Printf("root: hello %s\n", name)
	return nil
}

// Child is a subcommand `app child` -- Child command with go-flag parser.
// CLI-Parser: go-flag
//
// Flags:
//
//	item: -item Item name.
func Child(item string) error {
	fmt.Printf("child: item=%s\n", item)
	return nil
}

// Mixed is a subcommand `app mixed` -- Subcommand with plus-minus parser.
// CLI-Parser: plus-minus
//
// Flags:
//
//	verbose: +v -v Verbose mode.
func Mixed(verbose bool) error {
	fmt.Printf("mixed: verbose=%t\n", verbose)
	return nil
}

// Echo is a subcommand `app echo` -- Subcommand with IO streams.
// CLI-Parser: gnu
//
// Flags:
//
//	in: --in Input reader.
//	out: --out Output writer.
func Echo(in io.Reader, out io.Writer) error {
	if in != nil && out != nil {
		b, err := io.ReadAll(in)
		if err != nil {
			return err
		}
		_, err = out.Write(b)
		return err
	}
	return nil
}
