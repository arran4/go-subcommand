	set.SetOutput(v.outputStderr())

	set.StringVar(&v.env, "env", "canary", "Shadowed environment.")
	set.Usage = v.Usage

	v.CommandAction = func(c *Custom) error {

		err := app.Custom(c.env, c.store)
		if err != nil {
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
