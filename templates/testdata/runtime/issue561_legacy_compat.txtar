module example.com/legacycompat

go 1.22
-- input/db/db.go --
package db

import "fmt"

type Conn struct {
	Role string
}

func PrimaryDB() (*Conn, error) {
	fmt.Println("db:primary")
	return &Conn{Role: "primary"}, nil
}

func ReplicaDB() (*Conn, error) {
	fmt.Println("db:replica")
	return &Conn{Role: "replica"}, nil
}
-- input/store/store.go --
package store

import "fmt"

type Store struct {
	Env string
}

func OpenStore(env string) (*Store, error) {
	fmt.Printf("store:open:%s\n", env)
	return &Store{Env: env}, nil
}
-- input/app.go --
package app

import (
	"fmt"

	"example.com/legacycompat/db"
	"example.com/legacycompat/store"
)

// Root is a subcommand `app` -- Legacy compatibility root.
// Shared provider: store = "example.com/legacycompat/store".OpenStore(env)
//
// Flags:
//
//	env: --env (default: "prod") Target environment.
func Root(env string) error {
	fmt.Printf("action:root:%s\n", env)
	return nil
}

// Run is a subcommand `app run` -- Uses root shared store with root env.
func Run(store *store.Store) error {
	fmt.Printf("action:run:%s\n", store.Env)
	return nil
}

// Custom is a subcommand `app custom` -- Shadows env flag without mutating root shared provider.
//
// Flags:
//
//	env: --env (default: "canary") Shadowed environment.
func Custom(env string, store *store.Store) error {
	fmt.Printf("action:custom:%s:%s\n", env, store.Env)
	return nil
}

// DB is a command `app db` -- Database operations using named legacy Shared providers.
// Shared provider: primary = "example.com/legacycompat/db".PrimaryDB
// Shared provider: replica = "example.com/legacycompat/db".ReplicaDB

// Report is a subcommand `app db report` -- Binds primary and replica unambiguously by legacy name.
func Report(primary, replica *db.Conn) error {
	fmt.Printf("action:report:%s:%s\n", primary.Role, replica.Role)
	return nil
}

// Swap is a subcommand `app db swap` -- Explicit override takes precedence over parameter name.
//
// Flags:
//
//	primary: (provider: db.ReplicaDB) Explicitly select replica.
func Swap(primary *db.Conn) error {
	fmt.Printf("action:swap:%s\n", primary.Role)
	return nil
}
