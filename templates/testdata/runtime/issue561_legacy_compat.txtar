			}
			if arg == "-h" || arg == "--help" {
				isHelpRequest = true
				break
			}
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}

	if isHelpRequest && len(remainingArgs) > 0 {
		c.Usage()
		return nil
	}

	{
		v, err := c.ProvideStore()
		if err != nil {
			return fmt.Errorf("failed to provide store: %w", err)
		}
		c.store = v
	}
	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *RootCmd) NewCustom() *Custom {
	set := flag.NewFlagSet("custom", flag.ContinueOnError)
	v := &Custom{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
