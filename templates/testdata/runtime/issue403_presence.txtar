Real source-comment provider dependencies plus explicit flag presence.
TestGenerateProviderFlagPresence compares generated artifacts, compiles the
application, and replays exact provider/action/cleanup stdout and process results.
-- input/go.mod --
module example.com/providerpresence

go 1.22
-- input/resources/resources.go --
package resources

import (
	"encoding/json"
	"fmt"
	"io"
)

type Resource struct { Name, Mode string }

func (r *Resource) Close() error {
	fmt.Println("close:" + r.Name)
	if r.Mode == "close" || r.Mode == "action-close" { return fmt.Errorf("%s cleanup", r.Name) }
	return nil
}

func OpenSecond(first io.Closer, mode string, count int, seen map[string]bool, item string) (io.Closer, error) {
	if r, ok := first.(*Resource); !ok || r.Name != "first" { return nil, fmt.Errorf("first dependency not bound") }
	flags, _ := json.Marshal(seen)
	fmt.Printf("open:second count=%d item=%q seen=%s\n", count, item, flags)
	if mode == "second" { return nil, fmt.Errorf("second acquisition") }
	return &Resource{Name: "second", Mode: mode}, nil
}
-- input/app.go --
package app

import (
	"encoding/json"
	"fmt"
	"io"

	"example.com/providerpresence/resources"
)

func OpenFirst(enabled bool, label string, seen map[string]bool, mode string) (io.Closer, error) {
	flags, _ := json.Marshal(seen)
	fmt.Printf("open:first enabled=%t label=%q seen=%s\n", enabled, label, flags)
	if mode == "first" { return nil, fmt.Errorf("first acquisition") }
	return &resources.Resource{Name: "first", Mode: mode}, nil
}

// Root is a subcommand `app` -- Run root providers.
//
// Flags:
//
//	second: (generator: "example.com/providerpresence/resources".OpenSecond(first, mode, count, seen, item)) Imported dependent provider.
//	first: (generator: OpenFirst(enabled, label, seen, mode)) Local initial provider.
//	mode: --mode (default: "ok") Failure mode.
//	enabled: --enabled -e (default: true) Enable output.
//	count: --count -n (default: 7) Count.
//	label: --label -l (default: "default") Inherited label.
//	item: --item (default: "item") Item.
//	seen: (flag presence) Explicit parser inputs, not a provider.
func Root(second, first io.Closer, mode string, enabled bool, count int, label, item string, seen map[string]bool) error {
	return action("root", mode)
}

// Run is a subcommand `app group run` -- Run nested providers.
//
// Flags:
//
//	second: (generator: "example.com/providerpresence/resources".OpenSecond(first, mode, count, seen, item)) Imported dependent provider.
//	first: (generator: OpenFirst(enabled, label, seen, mode)) Local initial provider.
//	mode: (from parent) Inherited failure mode.
//	label: (from parent) Inherited label.
//	enabled: --enabled -e (default: true) Enable output.
//	count: --count -n (default: 7) Count.
//	item: @1 (default: "item") Positional item.
//	seen: (flag presence) Explicit inputs at this command.
func Run(second, first io.Closer, mode, label string, enabled bool, count int, item string, seen map[string]bool) error {
	return action("nested", mode)
}

func action(path, mode string) error {
	fmt.Println("action:" + path)
	if mode == "action" || mode == "action-close" { return fmt.Errorf("action failure") }
	return nil
}

// Plain is a subcommand `app plain` -- Presence without providers.
//
// Flags:
//
//	seen: (flag presence) Explicit inputs.
//	enabled: --enabled -e (default: true) Enable output.
func Plain(seen map[string]bool, enabled bool) {
	flags, _ := json.Marshal(seen)
	fmt.Printf("plain enabled=%t seen=%s\n", enabled, flags)
}
