			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}
	// Handle positional argument item
	{
		argIndex := 0
		if argIndex >= 0 && argIndex < len(remainingArgs) {
			argVal := remainingArgs[argIndex]
			c.item = argVal
		} else {
			c.item = "item"
		}
	}

	c.seen = seenFlags
	{
		v, err := app.OpenFirst(c.enabled, c.label, c.seen, c.mode)
		if err != nil {
			return fmt.Errorf("failed to generate first: %w", err)
		}
		c.first = v
		if closer, ok := interface{}(v).(io.Closer); ok {
			cleanups = append(cleanups, closer.Close)
		}
	}
	{
		v, err := resources.OpenSecond(c.first, c.mode, c.count, c.seen, c.item)
		if err != nil {
			return fmt.Errorf("failed to generate second: %w", err)
		}
		c.second = v
		if closer, ok := interface{}(v).(io.Closer); ok {
			cleanups = append(cleanups, closer.Close)
		}
	}
	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *Group) NewGroupRun() *GroupRun {
	set := flag.NewFlagSet("run", flag.ContinueOnError)
	v := &GroupRun{
		Group:       c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}

	set.BoolVar(&v.enabled, "enabled", true, "Enable output.")
	set.BoolVar(&v.enabled, "e", true, "Enable output.")

	set.IntVar(&v.count, "count", 7, "Count.")
	set.IntVar(&v.count, "n", 7, "Count.")
	set.Usage = v.Usage

	v.CommandAction = func(c *GroupRun) error {

		err := app.Run(c.second, c.first, c.mode, c.label, c.enabled, c.count, c.item, c.seen)
		if err != nil {
			if errors.Is(err, cmd.ErrPrintHelp) {
				c.Usage()
				return nil
			}
			if errors.Is(err, cmd.ErrHelp) {
				fmt.Fprintf(os.Stderr, "Use '%s help' for more information.\n", os.Args[0])
				return nil
			}
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
				return exitCode
			}
			return fmt.Errorf("run failed: %w", err)
		}
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
