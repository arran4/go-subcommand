// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"errors"
	"fmt"
	"io"
	"os"

	"example.com/collisions/cmd"
)

var (
	version = "dev"
	commit  = "none"
	date    = "unknown"
)

func generatedRun(args []string, stderr io.Writer) int {
	return generatedRunWithStreams(args, nil, stderr)
}

func generatedRunWithStreams(args []string, stdout, stderr io.Writer) int {
	return generatedRunWithIO(args, nil, stdout, stderr)
}

func generatedRunWithIO(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
	root, err := NewRootWithOptions("app", version, commit, date, RootOptions{
		Streams: CommandIO{
			Stdin:  stdin,
			Stdout: stdout,
			Stderr: stderr,
		},
	})
	if err == nil {
		err = root.Execute(args)
	}
	outErr := stderr
	if outErr == nil && root != nil {
		outErr = root.outputStderr()
	}
	generatedRenderError(outErr, err)
	return generatedExitCode(err)
}

// Explicit statuses take precedence over category defaults and the fallback.
// All ordinary failures retain the historical status 1.
func generatedExitCode(err error) int {
	if err == nil {
		return 0
	}
	var exit *cmd.ErrExitCode
	if errors.As(err, &exit) {
		return exit.Code
	}
	if errors.Is(err, cmd.ErrUsage) {
		return 1
	}
	return 1
}

func generatedRenderError(stderr io.Writer, err error) {
	if err == nil {
		return
	}
	if stderr == nil {
		stderr = os.Stderr
	}
	var exit *cmd.ErrExitCode
	if errors.As(err, &exit) {
		if exit.Err == nil {
			return
		}
		err = exit.Err
	}
	fmt.Fprintf(stderr, "Error: %v\n", err)
}
