package deps

import "fmt"

type Banner struct {
	Label string
}

func NewBanner() (*Banner, error) {
	return &Banner{Label: "shared-banner"}, nil
}

func FormatSummary(a, b string) string {
	return fmt.Sprintf("%s:%s", a, b)
}
-- input/app.go --
package app

import (
	"fmt"

	"example.com/collisions/deps"
)

// Root is a subcommand `app` -- Root with parameter names matching generated internals.
// Shared provider: stdout = "example.com/collisions/deps".NewBanner
//
// Flags:
//
//	Stdin: --in-arg Root Stdin param.
//	Stdout: --out-arg Root Stdout param.
//	Stderr: --err-arg Root Stderr param.
//	IO: (root context) Root context named IO.
//	name: (root context) Root context named name.
func Root(Stdin string, Stdout string, Stderr string, IO string, name string) error {
	fmt.Printf("root:%s:%s:%s:%s:%s\n", Stdin, Stdout, Stderr, IO, name)
	return nil
}

// SubA is a subcommand `app sub-a` -- Subcommand consuming root shared provider stdout.
//
// Flags:
//
//	stdout: Shared banner.
//	Stdout: --sub-stdout Child Stdin/Stdout collision param.
func SubA(stdout *deps.Banner, Stdout string) error {
	fmt.Printf("sub-a:%s:%s\n", deps.FormatSummary(stdout.Label, Stdout), Stdout)
	return nil
}

// SubB is a subcommand `app sub-b` -- Second subcommand consuming root shared provider stdout.
func SubB(stdout *deps.Banner) error {
	fmt.Printf("sub-b:%s\n", stdout.Label)
	return nil
}

// CommandIoCmd is a subcommand `app command-io` -- Collides with CommandIo/CommandIO if unguarded.
func CommandIoCmd() error {
	fmt.Println("command-io")
	return nil
}

// RootOptionsCmd is a subcommand `app root-options` -- Collides with RootOptions.
func RootOptionsCmd() error {
	fmt.Println("root-options")
	return nil
}

// NewRootWithOptionsCmd is a subcommand `app new-root-with-options` -- Collides with NewRootWithOptions.
func NewRootWithOptionsCmd() error {
	fmt.Println("new-root-with-options")
	return nil
}

// NewRootWithContextCmd is a subcommand `app new-root-with-context` -- Collides with NewRootWithContext.
func NewRootWithContextCmd() error {
	fmt.Println("new-root-with-context")
	return nil
}
