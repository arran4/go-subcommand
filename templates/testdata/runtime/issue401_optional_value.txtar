				if char == "h" {
					c.Usage()
					return nil
				}
				found := false

				if char == "r" {
					found = true
					value := ""
					hasValue := false
					if j+1 < len(shorts) {
						value = shorts[j+1:]
						if strings.HasPrefix(value, "=") {
							value = value[1:]
						}
						hasValue = true
						j = len(shorts)
					}
					if !hasValue {
						c.raw = append(c.raw, nil)
					} else {
						s := value
						c.raw = append(c.raw, &s)
					}
