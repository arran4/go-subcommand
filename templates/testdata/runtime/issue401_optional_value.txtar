  {"args": ["validate", "-sinvalid"], "status": 1, "stderr": "Error: invalid optional value for flag -s: invalid parameter payload\n"},
  {"args": ["--help"], "stderrFile": "root-help.stderr"},
  {"args": ["help"], "stderrFile": "root-help.stderr"},
  {"args": ["usage"], "stderrFile": "root-help.stderr"}
