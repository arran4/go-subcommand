		}
	}

	isHelpRequest := !dashDashSeen && len(remainingArgs) > 0 && (remainingArgs[0] == "help" || remainingArgs[0] == "usage")
	if !isHelpRequest && !dashDashSeen {
		for _, arg := range remainingArgs {
			if arg == "--" {
				break
			}
			if arg == "-h" || arg == "--help" {
				isHelpRequest = true
				break
			}
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}

	if isHelpRequest && len(remainingArgs) > 0 {
		c.Usage()
		return nil
	}

	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *RootCmd) NewNumeric() *Numeric {
	set := flag.NewFlagSet("numeric", flag.ContinueOnError)
	v := &Numeric{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}
	set.Usage = v.Usage

	v.CommandAction = func(c *Numeric) error {

		app.Numeric(c.big, c.ports, c.timeout, c.rate, c.ratio, c.speed, c.defCount)
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
-- expected/root-help.stderr --
Usage: app [flags...] <subcommand>

- Root optional value command.

Subcommands:
    convert  - Generator conversion.
    custom   - Custom parser optional flag.
    numeric  - Extended numeric, duration, float and custom alias optional
             flags.
    pointers - Pointer and double-pointer optional values.
    scalar   - Scalar optional values with defaults.
    scope    - Optional flag before positional arg.
    slices   - Slice and pointer-slice optional values.
    help     Print this help message
    usage    Print this usage message


Flags:
    --label, -l [=string]   Optional string label.
    --verbose, -v [=bool]   Optional boolean flag.
