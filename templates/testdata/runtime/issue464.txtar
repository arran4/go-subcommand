// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"fmt"
	"io"
	"os"
	"slices"
	"strconv"
	"sync"

	app "example.com/plusminus"
	"example.com/plusminus/cmd"
	"example.com/plusminus/cmd/app/templates"
)

type Cmd interface {
	Execute(args []string) error
	Usage()
}

type InternalCommand struct {
	Exec      func(args []string) error
	UsageFunc func()
}

func (c *InternalCommand) Execute(args []string) error {
	return c.Exec(args)
}

func (c *InternalCommand) Usage() {
	c.UsageFunc()
}

func NewLazyCommand(f func() Cmd) func() Cmd {
	var once sync.Once
	var cmd Cmd
	return func() Cmd {
		once.Do(func() {
			cmd = f()
		})
		return cmd
	}
}

type UserError struct {
	Err error
	Msg string
}

func (e *UserError) Error() string {
	if e.Err != nil {
		return fmt.Sprintf("%s: %v", e.Msg, e.Err)
	}
	return e.Msg
}

func NewUserError(err error, msg string) *UserError {
	return &UserError{Err: err, Msg: msg}
}

func executeUsage(out io.Writer, templateName string, data any) error {
	return templates.GetTemplates().ExecuteTemplate(out, templateName, data)
}

type RootCmd struct {
	*flag.FlagSet
	Commands      map[string]func() Cmd
	Version       string
	Commit        string
	Date          string
	alpha         bool
	beta          bool
	ab            bool
	count         int
	label         string
	seen          map[string]bool
	args          []string
	CommandAction func(c *RootCmd) error
}

func (c *RootCmd) Usage() {
	err := executeUsage(os.Stderr, "app_usage.txt", UsageDataRootCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *RootCmd) usageError(kind cmd.UsageErrorKind, flag string, cause error, format string, args ...any) error {
	return newUsageError(c.commandPath(), kind, flag, cause, format, args...)
}

func (c *RootCmd) commandPath() string { return "app" }

func (c *RootCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "app_usage.txt", UsageDataRootCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

type UsageDataRootCmd struct {
	*RootCmd
	Recursive bool
}

func NewRoot(name, version, commit, date string) (*RootCmd, error) {
	c := &RootCmd{
		FlagSet:  flag.NewFlagSet(name, flag.ExitOnError),
		Commands: make(map[string]func() Cmd),
		Version:  version,
		Commit:   commit,
		Date:     date,
	}
	c.FlagSet.Usage = c.Usage

	c.BoolVar(&c.alpha, "enable", true, "Alpha toggle.")
	c.BoolVar(&c.alpha, "alpha", true, "Alpha toggle.")
	c.BoolVar(&c.alpha, "a", true, "Alpha toggle.")

	c.BoolVar(&c.beta, "beta", false, "Beta toggle.")
	c.BoolVar(&c.beta, "b", false, "Beta toggle.")

	c.BoolVar(&c.ab, "both", false, "One long option.")
	c.BoolVar(&c.ab, "ab", false, "One long option.")

	c.IntVar(&c.count, "count", 7, "Count.")

	c.StringVar(&c.label, "label", "base", "Label.")

	c.CommandAction = func(c *RootCmd) error {

		app.Root(c.alpha, c.beta, c.ab, c.count, c.label, c.seen, c.args...)
		return nil
	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewEffect() })
		c.Commands["effect"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewGnu() })
		c.Commands["gnu"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewLegacy() })
		c.Commands["legacy"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewPlusMinus() })
		c.Commands["plus-minus"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewSingle() })
		c.Commands["single"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewValues() })
		c.Commands["values"] = subCmd

	}
	c.Commands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"help"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"usage"}, target[1:]...)
						if deep {
