	"strings"

	"example.com/plusminus/cmd"
)

type plusMinusOption struct {
	Key     string
	Boolean bool
	IO      bool
	Set     func(string) error
}

type plusMinusValue struct {
	Name   string
	Option plusMinusOption
	Value  string
}

type plusMinusToken struct {
	Boundary, Terminated, Help, NeedsValue bool
	Values                                 []plusMinusValue
}

// Tokenization validates a complete cluster before any setter runs.
func tokenizePlusMinus(token, path string, short, long map[string]plusMinusOption) (plusMinusToken, error) {
	var result plusMinusToken
	if token == "--" {
		result.Terminated = true
		return result, nil
	}
	if token == "-h" || token == "--help" {
		result.Help = true
		return result, nil
	}
	if len(token) < 2 || token[0] != '-' && token[0] != '+' {
		result.Boundary = true
		return result, nil
	}
	if strings.HasPrefix(token, "--") {
		name, value, assigned := token[2:], "", false
		if at := strings.IndexByte(name, '='); at >= 0 {
			name, value, assigned = name[:at], name[at+1:], true
		}
		option, found := long[name]
		if len(name) < 2 || !found {
			return result, newUsageError(path, cmd.UsageUnknownFlag, name, nil, "unknown flag: --%s", name)
		}
		if option.Boolean && !assigned {
			value = "true"
		}
		result.NeedsValue = !option.Boolean && !assigned
		result.Values = []plusMinusValue{{Name: name, Option: option, Value: value}}
		return result, nil
	}
	if token[1] == '+' || strings.ContainsAny(token[1:], "=+-") {
		return result, newUsageError(path, cmd.UsageInvalidArguments, "", nil, "invalid plus-minus option: %s", token)
	}
	for i := 1; i < len(token); i++ {
		name := token[i : i+1]
		if !(token[i] >= 'a' && token[i] <= 'z' || token[i] >= 'A' && token[i] <= 'Z') {
			return result, newUsageError(path, cmd.UsageInvalidArguments, "", nil, "invalid short option syntax: %s", token)
		}
		if name == "h" {
			return result, newUsageError(path, cmd.UsageInvalidArguments, name, nil, "help cannot be disabled or clustered: %s", token)
		}
		option, found := short[name]
		if !found {
			return result, newUsageError(path, cmd.UsageUnknownFlag, name, nil, "unknown flag: %s%s", token[:1], name)
		}
		if !option.Boolean {
			return result, newUsageError(path, cmd.UsageInvalidArguments, name, nil, "short option %s requires a long value form", name)
		}
		value := "true"
		if token[0] == '+' {
			value = "false"
		}
		result.Values = append(result.Values, plusMinusValue{Name: name, Option: option, Value: value})
	}
	return result, nil
}

// Stop at this scope's first command/positional boundary. The remaining slice
// retains its original bytes and is never inspected or rewritten by this parser.
func parsePlusMinus(args []string, path string, short, long map[string]plusMinusOption) (remaining []string, seen map[string]bool, terminated, help bool, err error) {
	seen = make(map[string]bool)
	for i := 0; i < len(args); i++ {
		token, tokenErr := tokenizePlusMinus(args[i], path, short, long)
		if tokenErr != nil {
			return nil, seen, false, false, tokenErr
		}
		if token.Boundary {
			return args[i:], seen, false, false, nil
		}
		if token.Terminated {
			return args[i+1:], seen, true, false, nil
		}
		if token.Help {
			return nil, seen, false, true, nil
		}
		if token.NeedsValue {
			if i+1 == len(args) {
				return nil, seen, false, false, newUsageError(path, cmd.UsageMissingFlagValue, token.Values[0].Name, nil, "flag --%s requires a value", token.Values[0].Name)
			}
			i++
			token.Values[0].Value = args[i]
		}
		for _, operation := range token.Values {
			if setErr := operation.Option.Set(operation.Value); setErr != nil {
				if operation.Option.IO {
					return nil, seen, false, false, setErr
				}
				return nil, seen, false, false, newUsageError(path, cmd.UsageInvalidValue, operation.Name, setErr, "invalid value %q for flag %s: %v", operation.Value, operation.Name, setErr)
			}
			seen[operation.Option.Key] = true
		}
	}
	return nil, seen, false, false, nil
}
