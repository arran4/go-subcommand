-- input/app.go --
package app

import (
	"encoding/json"
	"fmt"
	"time"
)

// Root is a subcommand `app` -- Toggle root options.
// CLI-Parser: plus-minus
//
// Flags:
//
//	alpha: -a --alpha --enable (default: true) Alpha toggle.
//	beta: -b --beta (default: false) Beta toggle.
//	ab: --ab --both (default: false) One long option.
//	count: --count (default: 7) Count.
//	label: --label (default: "base") Label.
//	seen: (flag presence) Explicit inputs.
//	args: ... Literal positional tail.
func Root(alpha, beta, ab bool, count int, label string, seen map[string]bool, args ...string) {
	report("root", alpha, beta, ab, count, label, seen, args)
}

func report(path string, alpha, beta, ab bool, count int, label string, seen map[string]bool, args []string) {
	presence, _ := json.Marshal(seen)
	fmt.Printf("%s a=%t b=%t ab=%t count=%d label=%q args=%q seen=%s\n", path, alpha, beta, ab, count, label, args, presence)
}

// Gnu is a subcommand `app gnu` -- GNU scope.
// CLI-Parser: gnu
//
// Flags:
//
//	a: -a (default: false) Canonical one-letter toggle.
//	b: -b (default: false) Second toggle.
//	ab: --ab (default: false) Long collision.
//	seen: (flag presence) Explicit inputs.
//	args: ... Literal tail.
func Gnu(a, b, ab bool, seen map[string]bool, args ...string) { report("gnu", a, b, ab, 0, "", seen, args) }

// Pm is a subcommand `app gnu pm` -- Child-owned plus-minus scope.
// CLI-Parser: plus-minus
// Aliases: toggle
//
// Flags:
//
//	child: -c --child (default: true) Child-only toggle.
//	seen: (flag presence) Explicit inputs.
//	args: ... Literal tail.
func Pm(child bool, seen map[string]bool, args ...string) { report("gnu/pm", child, false, false, 0, "", seen, args) }

// Deep is a subcommand `app gnu pm deep` -- Inherits nearest plus-minus ancestor.
//
// Flags:
//
//	deep: -d --deep (default: true) Deep-only toggle.
//	seen: (flag presence) Explicit inputs.
func Deep(deep bool, seen map[string]bool) { report("deep", deep, false, false, 0, "", seen, nil) }

// Legacy is a subcommand `app legacy` -- Go-flag override.
// CLI-Parser: go-flag
//
// Flags:
//
//	a: -a (default: false) Short toggle.
//	b: -b (default: false) Short toggle.
//	ab: --ab (default: false) Exact Go-flag name.
//	seen: (flag presence) Explicit inputs.
//	args: ... Literal tail.
func Legacy(a, b, ab bool, seen map[string]bool, args ...string) { report("legacy", a, b, ab, 0, "", seen, args) }

// Old is a subcommand `app gnu pm old` -- Deep override back to Go-flag.
// CLI-Parser: go-flag
//
// Flags:
//
//	ab: --ab (default: false) Exact flag.
//	seen: (flag presence) Explicit inputs.
func Old(ab bool, seen map[string]bool) { report("old", false, false, ab, 0, "", seen, nil) }

func ParseCustom(s string) (string, error) {
	if s == "bad" { return "", fmt.Errorf("custom rejected") }
	return s, nil
}

// Values is a subcommand `app values` -- Long values and conversion.
//
// Flags:
//
//	delay: --delay (default: "1s") Duration.
//	custom: (parser: ParseCustom) --custom Custom parser.
//	tags: --tag Repeated value.
//	maybe: -m --maybe Pointer toggle.
func Values(delay time.Duration, custom string, tags []string, maybe *bool) {
	value := "nil"
	if maybe != nil { value = fmt.Sprint(*maybe) }
	fmt.Printf("delay=%s custom=%q tags=%q maybe=%s\n", delay, custom, tags, value)
}

func Build() (string, error) { fmt.Println("provider"); return "ready", nil }

// Effect is a subcommand `app effect` -- Effectful provider.
//
// Flags:
//
//	value: (generator: Build) Prepared value.
func Effect(value string) { fmt.Println(value) }

// PlusMinus is a subcommand `app plus-minus` -- Helper filename collision.
func PlusMinus() { fmt.Println("literal") }

// Single is a subcommand `app single` -- Canonical one-letter toggle.
//
// Flags:
//
//	a: -q (default: true) Canonical short with an alias.
//	seen: (flag presence) Explicit inputs.
func Single(a bool, seen map[string]bool) { report("single", a, false, false, 0, "", seen, nil) }
