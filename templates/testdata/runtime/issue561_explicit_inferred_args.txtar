Compiled regression fixture for explicit guard and provider arguments consuming
inferred action dependencies (`Requires: auth.CurrentUser, auth.RequireAdmin(user)`).
-- input/go.mod --
module example.com/explicitinferred

go 1.22
-- input/auth/auth.go --
package auth

import (
	"fmt"
	"os"
)

type User struct {
	Role string
}

type Badge struct {
	Label string
}

func CurrentUser() (*User, error) {
	if os.Getenv("FAIL_USER") == "1" {
		fmt.Println("auth:current-user:fail")
		return nil, fmt.Errorf("user lookup failed")
	}
	role := "admin"
	if r := os.Getenv("USER_ROLE"); r != "" {
		role = r
	}
	fmt.Println("auth:current-user")
	return &User{Role: role}, nil
}

func RequireAdmin(user *User) error {
	if user == nil {
		fmt.Println("auth:require-admin:nil-user")
		return fmt.Errorf("nil user")
	}
	fmt.Printf("auth:require-admin:%s\n", user.Role)
	if os.Getenv("FAIL_ADMIN") == "1" || user.Role != "admin" {
		return fmt.Errorf("admin authorization failed")
	}
	return nil
}

func BuildBadge(user *User) (*Badge, error) {
	if user == nil {
		return nil, fmt.Errorf("nil user for badge")
	}
	fmt.Printf("auth:build-badge:%s\n", user.Role)
	return &Badge{Label: "badge-" + user.Role}, nil
}
-- input/app.go --
package app

import (
	"fmt"

	"example.com/explicitinferred/auth"
)

// Root is a subcommand `app` -- Explicit inferred arg app.
func Root() error { return nil }

// API is a command `app api` -- API commands.
// Requires: auth.CurrentUser

// Health is a subcommand `app api health` -- Sibling health check.
func Health() error {
	fmt.Println("action:health")
	return nil
}

// List is a subcommand `app api list` -- Guard explicitly consumes inferred action user.
// Requires: auth.CurrentUser, auth.RequireAdmin(user)
func List(user *auth.User) error {
	fmt.Printf("action:list:%s\n", user.Role)
	return nil
}

// ShowBadge is a subcommand `app api badge` -- Provider explicitly consumes inferred action user.
// Requires: auth.CurrentUser, auth.BuildBadge(user)
func ShowBadge(badge *auth.Badge, user *auth.User) error {
	fmt.Printf("action:badge:%s:%s\n", badge.Label, user.Role)
	return nil
}
