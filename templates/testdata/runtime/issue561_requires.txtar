-- input/auth/auth.go --
package auth

import (
	"fmt"
	"os"
)

type User struct {
	Role string
}

type Audit struct {
	Tag string
}

func CurrentUser() (*User, error) {
	if os.Getenv("FAIL_USER") == "1" {
		fmt.Println("auth:current-user:fail")
		return nil, fmt.Errorf("user lookup failed")
	}
	role := "admin"
	if r := os.Getenv("USER_ROLE"); r != "" {
		role = r
	}
	fmt.Println("auth:current-user")
	return &User{Role: role}, nil
}

func RequireAdmin(user *User) error {
	fmt.Printf("auth:require-admin:%s\n", user.Role)
	if os.Getenv("FAIL_ADMIN") == "1" || user.Role != "admin" {
		return fmt.Errorf("admin authorization failed")
	}
	return nil
}

func AuditTrail() (*Audit, error) {
	fmt.Println("auth:audit-trail")
	if os.Getenv("FAIL_AUDIT") == "1" {
		return nil, fmt.Errorf("audit failed")
	}
	return &Audit{Tag: "audit-1"}, nil
}
-- input/jobs/jobs.go --
package jobs

import (
	"fmt"
	"os"
)

type Runtime struct {
	ID string
}

func BuildRuntime() *Runtime {
	return &Runtime{ID: "rt-1"}
}

type Store struct {
	Env  string
	RtID string
}

func (s *Store) Close() error {
	fmt.Printf("close:store:%s\n", s.Env)
	if os.Getenv("FAIL_CLOSE") == "1" {
		return fmt.Errorf("store close failed")
	}
	return nil
}

type Client struct {
	Store *Store
}

func (c *Client) Close() error {
	fmt.Printf("close:client:%s\n", c.Store.Env)
	return nil
}

type Meta struct {
	Version string
}

func OpenStore(env string, rt *Runtime) (*Store, error) {
	rtID := "cli-default"
	if rt != nil {
		rtID = rt.ID
	}
	fmt.Printf("jobs:open-store:%s:%s\n", env, rtID)
	if os.Getenv("FAIL_STORE") == "1" {
		return nil, fmt.Errorf("store open failed")
	}
	return &Store{Env: env, RtID: rtID}, nil
}

func OpenClient(store *Store) (*Client, error) {
	fmt.Printf("jobs:open-client:%s\n", store.Env)
	if os.Getenv("FAIL_CLIENT") == "1" {
		return nil, fmt.Errorf("client open failed")
	}
	return &Client{Store: store}, nil
}

func LoadMeta() *Meta {
	fmt.Println("jobs:load-meta")
	return &Meta{Version: "v1"}
}
