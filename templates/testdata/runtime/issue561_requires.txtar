package app

import (
	"fmt"

	"example.com/requiresapp/auth"
	"example.com/requiresapp/db"
	"example.com/requiresapp/jobs"
	"example.com/requiresapp/storea"
	"example.com/requiresapp/storeb"
)

type UserAlias = auth.User

// Root is a subcommand `app` -- Application root command.
//
// Flags:
//
//	env: --env (default: "prod") Target environment.
//	rt: (root context) Typed runtime context.
func Root(env string, rt *jobs.Runtime) error {
	rtID := "cli-default"
	if rt != nil {
		rtID = rt.ID
	}
	fmt.Printf("action:root:%s:%s\n", env, rtID)
	return nil
}

// API is a command `app api` -- API endpoints.
// Requires: auth.CurrentUser

// Health is a subcommand `app api health` -- Health check without user acquisition.
func Health() error {
	fmt.Println("action:health")
	return nil
}

// Profile is a subcommand `app api profile` -- Profile using type alias without auth import.
func Profile(user *UserAlias) error {
	fmt.Printf("action:profile:%s\n", user.Role)
	return nil
}

// Users is a command `app api users` -- User management.
// Requires: auth.RequireAdmin

// UsersList is a subcommand `app api users list` -- List users.
func UsersList(user *auth.User) error {
	fmt.Printf("action:users-list:%s\n", user.Role)
	return nil
}

// UsersDelete is a subcommand `app api users delete` -- Delete user via type alias.
func UsersDelete(user *UserAlias) error {
	fmt.Printf("action:users-delete:%s\n", user.Role)
	return nil
}

// Admin is a command `app admin` -- Admin commands.
// Requires: auth.RequireAdmin, auth.AuditTrail (always)
// Requires: auth.CurrentUser

// AdminPing is a subcommand `app admin ping` -- Admin ping.
// Requires: auth.CurrentUser
func AdminPing() error {
	fmt.Println("action:admin-ping")
	return nil
}

// AdminInspect is a subcommand `app admin inspect` -- Admin inspection.
func AdminInspect(audit *auth.Audit, user *auth.User) error {
	fmt.Printf("action:admin-inspect:%s:%s\n", audit.Tag, user.Role)
	return nil
}

// Jobs is a command `app jobs` -- Background jobs.
// Requires: jobs.OpenClient, jobs.OpenStore, jobs.LoadMeta

// JobsRun is a subcommand `app jobs run` -- Run jobs with lazy dependencies.
//
// Flags:
//
//	dryRun: --dry-run Skip opening store and client.
//	checkErr: --check-err Invoke failing client twice to verify error caching.
func JobsRun(dryRun bool, checkErr bool, client func() (*jobs.Client, error), meta func() *jobs.Meta) error {
	m := meta()
	if dryRun {
		fmt.Printf("action:jobs-run:dry:%s\n", m.Version)
		return nil
	}
	if checkErr {
		_, err1 := client()
		_, err2 := client()
		fmt.Printf("action:jobs-run:check-err:%v:%v\n", err1 != nil, err1 == err2)
		return err1
	}
	c1, err := client()
	if err != nil {
		return err
	}
	c2, err := client()
	if err != nil {
		return err
	}
	if c1 != c2 {
		return fmt.Errorf("client instance not memoized")
	}
	fmt.Printf("action:jobs-run:live:%s:%s:%s\n", c1.Store.Env, c1.Store.RtID, m.Version)
	return nil
}

// JobsCustom is a subcommand `app jobs custom` -- Shadowed env flag isolation.
//
// Flags:
//
//	env: --env (default: "canary") Custom environment.
func JobsCustom(env string, store *jobs.Store) error {
	fmt.Printf("action:jobs-custom:%s:%s\n", env, store.Env)
	return nil
}

// DB is a command `app db` -- Database commands.
// Requires: db.PrimaryDB, db.ReplicaDB

// DBQuery is a subcommand `app db query` -- Query primary and replica connections.
//
// Flags:
//
//	replica: (provider: db.ReplicaDB) Replica connection.
//	primary: (provider: db.PrimaryDB) Primary connection.
func DBQuery(replica *db.Conn, primary *db.Conn) error {
	fmt.Printf("action:db-query:%s:%s\n", replica.Role, primary.Role)
	return nil
}

// Stores is a command `app stores` -- Multiple packages exporting Open.
// Requires: storea.Open, storeb.Open

// StoresSync is a subcommand `app stores sync` -- Sync handles across stores.
func StoresSync(a *storea.Handle, b *storeb.Handle) error {
	fmt.Printf("action:stores-sync:%s:%s\n", a.Name, b.Name)
	return nil
}

// Compat is a subcommand `app compat` -- Mix legacy Initializer and Requires.
// Initializer: "example.com/requiresapp/auth".RequireAdmin
// Requires: auth.CurrentUser
func Compat(user *auth.User) error {
	fmt.Printf("action:compat:%s\n", user.Role)
	return nil
}
