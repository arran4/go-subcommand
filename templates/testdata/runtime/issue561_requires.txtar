// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"slices"
	"strings"
	"sync"

	app "example.com/requiresapp"
	"example.com/requiresapp/cmd"
	"example.com/requiresapp/cmd/app/templates"
	"example.com/requiresapp/jobs"
)

type Cmd interface {
	Execute(args []string) error
	Usage()
}

type InternalCommand struct {
	Exec      func(args []string) error
	UsageFunc func()
}

func (c *InternalCommand) Execute(args []string) error {
	return c.Exec(args)
}

func (c *InternalCommand) Usage() {
	c.UsageFunc()
}

func NewLazyCommand(f func() Cmd) func() Cmd {
	var once sync.Once
	var cmd Cmd
	return func() Cmd {
		once.Do(func() {
			cmd = f()
		})
		return cmd
	}
}

type UserError struct {
	Err error
	Msg string
}

func (e *UserError) Error() string {
	if e.Err != nil {
		return fmt.Sprintf("%s: %v", e.Msg, e.Err)
	}
	return e.Msg
}

func NewUserError(err error, msg string) *UserError {
	return &UserError{Err: err, Msg: msg}
}

func executeUsage(out io.Writer, templateName string, data any) error {
	return templates.GetTemplates().ExecuteTemplate(out, templateName, data)
}

type RootCmd struct {
	*flag.FlagSet
	Commands      map[string]func() Cmd
	Version       string
	Commit        string
	Date          string
	Stdin         io.Reader
	Stdout        io.Writer
	Stderr        io.Writer
	env           string
	rt            *jobs.Runtime
	CommandAction func(c *RootCmd) error
	cleanups      []func() error
	cleanupMu     sync.Mutex
	resets        []func()
}

func (c *RootCmd) registerCleanup(fn func() error) {
	c.cleanupMu.Lock()
	defer c.cleanupMu.Unlock()
	c.cleanups = append(c.cleanups, fn)
}

func (c *RootCmd) registerReset(fn func()) {
	c.cleanupMu.Lock()
	defer c.cleanupMu.Unlock()
	c.resets = append(c.resets, fn)
}

func (c *RootCmd) outputStdout() io.Writer {
	if c != nil && c.Stdout != nil {
		return c.Stdout
	}
	return os.Stdout
}

func (c *RootCmd) outputStderr() io.Writer {
	if c != nil && c.Stderr != nil {
		return c.Stderr
	}
	return os.Stderr
}

func (c *RootCmd) inputStdin() io.Reader {
	if c != nil && c.Stdin != nil {
		return c.Stdin
	}
	return os.Stdin
}

type CommandIO struct {
	Stdin  io.Reader
	Stdout io.Writer
	Stderr io.Writer
}

type RootOptions struct {
	IO CommandIO
	rt *jobs.Runtime
}

func (c *RootCmd) Usage() {
	err := executeUsage(c.outputStderr(), "app_usage.txt", UsageDataRootCmd{c, false})
	if err != nil {
		fmt.Fprintf(c.outputStderr(), "Error generating usage: %s\n", err)
	}
}

func (c *RootCmd) usageError(kind cmd.UsageErrorKind, flag string, cause error, format string, args ...any) error {
	return newUsageError(c.commandPath(), kind, flag, cause, format, args...)
}

func (c *RootCmd) commandPath() string { return "app" }

func (c *RootCmd) UsageRecursive() {
	err := executeUsage(c.outputStderr(), "app_usage.txt", UsageDataRootCmd{c, true})
	if err != nil {
		fmt.Fprintf(c.outputStderr(), "Error generating usage: %s\n", err)
	}
}

type UsageDataRootCmd struct {
	*RootCmd
	Recursive bool
}

// NewRoot retains the default no-options constructor contract. Call
// NewRootWithOptions when supplying invocation streams or options, or
// NewRootWithContext when the application owns typed root context.
func NewRoot(name, version, commit, date string) (*RootCmd, error) {
	return NewRootWithOptions(name, version, commit, date, RootOptions{})
}
func NewRootWithContext(name, version, commit, date string, rt *jobs.Runtime) (*RootCmd, error) {
	return NewRootWithOptions(name, version, commit, date, RootOptions{
		rt: rt,
	})
}

func NewRootWithOptions(name, version, commit, date string, opts RootOptions) (*RootCmd, error) {
	c := &RootCmd{
		FlagSet:  flag.NewFlagSet(name, flag.ExitOnError),
		Commands: make(map[string]func() Cmd),
		Version:  version,
		Commit:   commit,
		Date:     date,
		Stdin:    opts.IO.Stdin,
		Stdout:   opts.IO.Stdout,
		Stderr:   opts.IO.Stderr,
		rt:       opts.rt,
	}
	c.FlagSet.SetOutput(c.outputStderr())
	c.FlagSet.Usage = c.Usage

	c.StringVar(&c.env, "env", "prod", "Target environment.")

	c.CommandAction = func(c *RootCmd) error {

		err := app.Root(c.env, c.rt)
		if err != nil {
			var exitCode *cmd.ErrExitCode
			if errors.As(err, &exitCode) {
				return err
			}
			if errors.Is(err, cmd.ErrPrintHelp) {
				c.Usage()
				return nil
			}
			if errors.Is(err, cmd.ErrHelp) {
				fmt.Fprintf(c.outputStderr(), "Use '%s help' for more information.\n", os.Args[0])
				return nil
			}
			if errors.Is(err, cmd.ErrUsage) {
				return err
			}
			return fmt.Errorf("app failed: %w", err)
		}
		return nil
	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewAdmin() })
		c.Commands["admin"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewApi() })
		c.Commands["api"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewCompat() })
		c.Commands["compat"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewDb() })
		c.Commands["db"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewJobs() })
		c.Commands["jobs"] = subCmd

	}

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewStores() })
		c.Commands["stores"] = subCmd

	}
	c.Commands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"help"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := slices.Contains(args, "-deep")
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"usage"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["version"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				fmt.Fprintf(c.outputStdout(), "Version: %s\nCommit: %s\nDate: %s\n", c.Version, c.Commit, c.Date)
				return nil
			},
			UsageFunc: func() {
				fmt.Fprintf(c.outputStderr(), "Usage: %s version\n", os.Args[0])
			},
		}
	}
	return c, nil
}

func (c *RootCmd) Execute(args []string) (err error) {
	defer func() {
		c.cleanupMu.Lock()
		defer c.cleanupMu.Unlock()
		for i := len(c.cleanups) - 1; i >= 0; i-- {
			if cerr := c.cleanups[i](); cerr != nil && err == nil {
				err = cerr
			}
		}
		c.cleanups = nil
		for _, reset := range c.resets {
			reset()
		}
		c.resets = nil
	}()
	var remainingArgs []string
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {

			case "env":
				if !hasValue {
					if i+1 < len(args) {
						value = args[i+1]
						i++
					} else {
						return c.usageError(cmd.UsageMissingFlagValue, name, nil, "flag %s requires a value", name)
					}
				}
				c.env = value
			default:
				return c.usageError(cmd.UsageUnknownFlag, name, nil, "unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false

				if !found {
					return c.usageError(cmd.UsageUnknownFlag, char, nil, "unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	isHelpRequest := !dashDashSeen && len(remainingArgs) > 0 && (remainingArgs[0] == "help" || remainingArgs[0] == "usage" || remainingArgs[0] == "version")
	if !isHelpRequest && !dashDashSeen {
		for _, arg := range remainingArgs {
			if arg == "--" {
				break
			}
			if arg == "-h" || arg == "--help" {
				isHelpRequest = true
				break
			}
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.Commands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
		c.Usage()
		return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", remainingArgs[0])
	}

	if isHelpRequest && len(remainingArgs) > 0 {
		c.Usage()
		return nil
	}
	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	}
	return nil
}
