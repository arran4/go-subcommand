	"example.com/requiresapp/cmd"
)

var _ Cmd = (*Api)(nil)

type Api struct {
	*RootCmd
	Flags           *flag.FlagSet
	SubCommands     map[string]func() Cmd
	CommandAction   func(c *Api) error
	currentUserOnce sync.Once
	currentUser     *auth.User
	currentUserErr  error
}

func (c *Api) CurrentUser() (*auth.User, error) {
	c.currentUserOnce.Do(func() {
		c.registerReset(func() {
			c.currentUserOnce = sync.Once{}
