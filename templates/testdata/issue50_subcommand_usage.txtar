-- input.json --
{
  "MainCmdName": "myapp",
  "SubCommandName": "sub1",
"SubCommandStructName": "Sub1",
"ConstructorMethodName": "NewSub1",
  "SubCommandFunctionName": "Sub1Func",
  "SubCommandDescription": "Sub1 command description",
  "Parameters": [
    {
      "Name": "force",
      "Type": "bool",
      "FlagAliases": ["f"],
      "Description": "Force execution",
      "DeclaredIn": "sub1"
    }
  ]
}
-- output.txt --
{{/* Do not modify: Generated by github.com/arran4/go-subcommand/cmd/gosubc */ -}}
Usage: myapp sub1 [flags...]

Sub1 command description

Subcommands:
{{- $commands := subcommands
    (subcommand "help" "Print this help message")
    (subcommand "usage" "Print this usage message")
-}}
{{- $width := subcommandWidth $commands -}}
{{- range $commands}}
{{- if .Description}}
    {{printf "%-*s" $width .Label}} {{.Description}}
{{- else}}
    {{.Label}}
{{- end}}
{{- end}}


Flags:
    -f    Force execution
