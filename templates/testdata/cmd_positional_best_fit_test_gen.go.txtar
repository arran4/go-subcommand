-- input.json --
{
  "PackageName": "main",
  "SubCommandName": "mycmd",
  "SubCommandStructName": "MyCmd",
  "ConstructorMethodName": "NewMyCmd",
  "SubCommandFunctionName": "MyCmdFunc",
  "SubCommandDescription": "My command description",
  "SubCommandPackageName": "mypkg",
  "ImportPath": "example.com/mypkg",
  "UsageFileName": "mycmd_usage.txt",
  "PositionalAlgorithm": "best-fit",
  "Parameters": [
    {
      "Name": "str1",
      "Type": "string",
      "IsPositional": true,
      "HasDefaultValue": true,
      "Default": "def1",
      "PositionalArgIndex": 1,
      "Description": "Optional string 1"
    },
    {
      "Name": "num1",
      "Type": "int",
      "IsPositional": true,
      "HasDefaultValue": true,
      "Default": "0",
      "PositionalArgIndex": 2,
      "Description": "Optional int 1"
    },
    {
      "Name": "str2",
      "Type": "string",
      "IsPositional": true,
      "HasDefaultValue": true,
      "Default": "def2",
      "PositionalArgIndex": 3,
      "Description": "Optional string 2"
    }
  ]
}
-- template_name --
cmd_test.go.gotmpl
-- output.go --
// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"testing"
)

func TestMyCmd_Execute(t *testing.T) {

	parent := &RootCmd{
		FlagSet:  flag.NewFlagSet("root", flag.ContinueOnError),
		Commands: make(map[string]func() Cmd),
	}
	cmd := parent.NewMyCmd()

	called := false
	cmd.CommandAction = func(c *MyCmd) error {
		called = true
		return nil
	}

	args := []string{}
	args = append(args, "test")
	args = append(args, "1")
	args = append(args, "test")

	err := cmd.Execute(args)
	if err != nil {
		t.Errorf("Unexpected error: %v", err)
	}

	if !called {
		t.Error("CommandAction was not called")
	}

	if cmd.str1 != "test" {
		t.Errorf("Expected str1 to be 'test', got '%v'", cmd.str1)
	}
	if cmd.num1 != 1 {
		t.Errorf("Expected num1 to be 1, got '%v'", cmd.num1)
	}
	if cmd.str2 != "test" {
		t.Errorf("Expected str2 to be 'test', got '%v'", cmd.str2)
	}
}

func TestMyCmd_ExecuteHelpAndUnknownFlags(t *testing.T) {

	parent := &RootCmd{
		FlagSet:  flag.NewFlagSet("root", flag.ContinueOnError),
		Commands: make(map[string]func() Cmd),
	}
	cmd := parent.NewMyCmd()

	if err := cmd.Execute([]string{"--help"}); err != nil {
		t.Errorf("--help returned an error: %v", err)
	}
	if err := cmd.Execute([]string{"-h"}); err != nil {
		t.Errorf("-h returned an error: %v", err)
	}
	if err := cmd.Execute([]string{"--not-a-real-flag"}); err == nil {
		t.Error("expected an error for an unknown long flag")
	}
	if err := cmd.Execute([]string{"-?"}); err == nil {
		t.Error("expected an error for an unknown short flag")
	}
}
