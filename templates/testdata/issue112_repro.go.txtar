-- input.json --
{
  "PackageName": "main",
  "SubCommandName": "testcmd",
  "SubCommandStructName": "TestCmd",
  "ConstructorMethodName": "NewTestCmd",
  "SubCommandFunctionName": "",
  "ImportPath": "",
  "Parameters": []
}
-- template_name --
cmd.go.gotmpl
-- output.go --
// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"fmt"
	"os"
	"strings"
)

var _ Cmd = (*TestCmd)(nil)

type TestCmd struct {
	*RootCmd
	Flags         *flag.FlagSet
	SubCommands   map[string]func() Cmd
	CommandAction func(c *TestCmd) error
}

type UsageDataTestCmd struct {
	*TestCmd
	Recursive bool
}

func (c *TestCmd) Usage() {
	err := executeUsage(os.Stderr, "", UsageDataTestCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *TestCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "", UsageDataTestCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *TestCmd) Execute(args []string) (err error) {

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}

	c.Usage()

	return nil
}

func (c *RootCmd) NewTestCmd() *TestCmd {
	set := flag.NewFlagSet("testcmd", flag.ContinueOnError)
	v := &TestCmd{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}
	set.Usage = v.Usage

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
