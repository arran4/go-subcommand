-- output.txt --
{{/* Do not modify: Generated by github.com/arran4/go-subcommand/cmd/gosubc */ -}}
Usage: myapp foo [flags...] <subcommand>

Subcommands:
{{- $commands := subcommands -}}
{{if .Recursive}}
{{- $commands = subcommands
    (subcommand "foo bar" "Bar command")
    (subcommand "foo baz" "Baz command")
    (subcommand "help" "Print this help message")
    (subcommand "usage" "Print this usage message")
-}}
{{else}}
{{- $commands = subcommands
    (subcommand "bar" "Bar command")
    (subcommand "baz" "Baz command")
    (subcommand "help" "Print this help message")
    (subcommand "usage" "Print this usage message")
-}}
{{end}}
{{- $width := subcommandWidth $commands -}}
{{- range $commands}}
{{- if .Description}}
    {{printf "%-*s" $width .Label}} {{.Description}}
{{- else}}
    {{.Label}}
{{- end}}
{{- end}}


Flags:
    -v       (default: false)   Enable verbose
    -c int   (default: 0)       Count items
