-- input.json --
{
  "MainCmdName": "myapp",
  "SubCommandName": "deploy",
  "SubCommandFunctionName": "Deploy",
  "SubCommandDescription": "Deploy application bundles to target environments.",
  "Parameters": [
    {
      "Name": "config",
      "Type": "string",
      "FlagAliases": ["c", "cfg", "config"],
      "Default": "/etc/myapp/production/settings.yaml",
      "Description": "Configuration file to load before running deployment tasks.\n\nOverrides environment variables when explicitly provided.",
      "DeclaredIn": "deploy"
    },
    {
      "Name": "registry",
      "Type": "string",
      "Description": "Registry endpoint https://registry.example.com/v2/organizations/default/artifacts/latest for fetching bundles.",
      "DeclaredIn": "deploy"
    },
    {
      "Name": "quiet",
      "Type": "bool",
      "FlagAliases": ["q"],
      "Default": "false",
      "Description": "",
      "DeclaredIn": "deploy"
    },
    {
      "Name": "environment",
      "Type": "string",
      "IsPositional": true,
      "PositionalArgIndex": 1,
      "Description": "Target environment name to deploy into, such as staging or production.",
      "DeclaredIn": "deploy"
    },
    {
      "Name": "clusters",
      "Type": "string",
      "IsPositional": true,
      "IsVarArg": true,
      "PositionalArgIndex": 2,
      "Description": "Optional cluster targets to restrict the rollout.",
      "DeclaredIn": "deploy"
    }
  ],
  "SubCommands": [
    {
      "SubCommandName": "env",
      "SubCommandDescription": "Manage deployment environments and promotion pipelines.",
      "SubCommands": [
        {
          "SubCommandName": "promote",
          "SubCommandDescription": "Promote a verified release from one environment to the next stage."
        }
      ]
    },
    {
      "SubCommandName": "silent",
      "SubCommandDescription": ""
    },
    {
      "SubCommandName": "extremely-long-subcommand-identifier-exceeding-forty-columns",
      "SubCommandDescription": "Command whose label alone exceeds narrow forty-column terminals."
    }
  ]
}
