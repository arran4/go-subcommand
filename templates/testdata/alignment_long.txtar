-- input.json --
{
  "MainCmdName": "myapp",
  "SubCommandName": "align",
  "SubCommandDescription": "Check alignment",
  "Parameters": [
    {
      "Name": "short",
      "Type": "bool",
      "FlagAliases": ["s"],
      "Default": "false",
      "Description": "Short flag",
      "DeclaredIn": "align"
    },
    {
      "Name": "very-very-long-flag-name-to-test-alignment-limits",
      "Type": "string",
      "FlagAliases": ["long"],
      "Default": "",
      "Description": "This is a very long flag description to see how it wraps or aligns in the output when the flag name itself is quite long.",
      "DeclaredIn": "align"
    },
    {
      "Name": "another",
      "Type": "int",
      "FlagAliases": [],
      "Default": "42",
      "Description": "Another flag",
      "DeclaredIn": "align"
    }
  ],
  "SubCommands": [
    {
      "SubCommandName": "short-cmd",
      "SubCommandDescription": "Short description"
    },
    {
      "SubCommandName": "very-long-subcommand-name-here",
      "SubCommandDescription": "Description for long subcommand"
    }
  ]
}
-- output.txt --
{{/* Do not modify: Generated by github.com/arran4/go-subcommand/cmd/gosubc */ -}}
Usage: myapp align [flags...] <subcommand>

Check alignment

Subcommands:
{{- $commands := subcommands -}}
{{if .Recursive}}
{{- $commands = subcommands
    (subcommand "align short-cmd" "Short description")
    (subcommand "align very-long-subcommand-name-here" "Description for long subcommand")
-}}
{{else}}
{{- $commands = subcommands
    (subcommand "short-cmd" "Short description")
    (subcommand "very-long-subcommand-name-here" "Description for long subcommand")
-}}
{{end}}
{{- $width := subcommandWidth $commands -}}
{{- range $commands}}
{{- if .Description}}
    {{printf "%-*s" $width .Label}} {{.Description}}
{{- else}}
    {{.Label}}
{{- end}}
{{- end}}


Flags:
    -s              (default: false)   Short flag
    --long string                      This is a very long flag description to see how it wraps or aligns in the output when the flag name itself is quite long.
    --another int   (default: 42)      Another flag
