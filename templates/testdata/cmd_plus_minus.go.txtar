// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"fmt"
	"os"
	"strconv"
	"strings"
)

var _ Cmd = (*ToggleCmd)(nil)

type ToggleCmd struct {
	*RootCmd
	Flags         *flag.FlagSet
	x             bool
	verbose       bool
	count         int
	args          [][]string
	SubCommands   map[string]func() Cmd
	CommandAction func(c *ToggleCmd) error
}

type UsageDataToggleCmd struct {
	*ToggleCmd
	Recursive bool
}

func (c *ToggleCmd) Usage() {
	err := executeUsage(os.Stderr, "toggle_usage.txt", UsageDataToggleCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *ToggleCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "toggle_usage.txt", UsageDataToggleCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *ToggleCmd) Execute(args []string) (err error) {
	// The plus-minus grammar extends GNU-style parsing with +x to explicitly
	// disable a short boolean flag. Normalise those toggles into the GNU parser
	// form so ordinary long flags, value flags, -- termination, and diagnostics
	// remain one well-tested grammar.
	normalizedArgs := make([]string, 0, len(args))
	plusMinusTerminated := false
	for _, arg := range args {
		if arg == "--" {
			plusMinusTerminated = true
			normalizedArgs = append(normalizedArgs, arg)
			continue
		}
		if !plusMinusTerminated && strings.HasPrefix(arg, "+") && arg != "+" {
			shorts := arg[1:]
			for _, char := range shorts {
				found := false

				if char == 'x' {
					found = true
					normalizedArgs = append(normalizedArgs, "--x=false")
				}

				if char == 'v' {
					found = true
					normalizedArgs = append(normalizedArgs, "--verbose=false")
				}
				if !found {
					return fmt.Errorf("unknown plus flag: +%c", char)
				}
			}
			continue
		}
		normalizedArgs = append(normalizedArgs, arg)
	}
	args = normalizedArgs
	var remainingArgs []string
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {

			case "x":
				if hasValue {
					b, err := strconv.ParseBool(value)
					if err != nil {
						return fmt.Errorf("invalid boolean value for flag %s: %s", name, value)
					}
					c.x = b
				} else {
					c.x = true
				}

			case "verbose":
				if hasValue {
					b, err := strconv.ParseBool(value)
					if err != nil {
						return fmt.Errorf("invalid boolean value for flag %s: %s", name, value)
					}
					c.verbose = b
				} else {
					c.verbose = true
				}

			case "count":
				if !hasValue {
					if i+1 < len(args) {
						value = args[i+1]
						i++
					} else {
						return fmt.Errorf("flag %s requires a value", name)
					}
				}
				v, err := strconv.Atoi(value)
				if err != nil {
					return fmt.Errorf("invalid integer value for flag %s: %s", name, value)
				}
				c.count = v
			default:
				return fmt.Errorf("unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false

				if char == "x" {
					found = true
					c.x = true
				}

				if char == "v" {
					found = true
					c.verbose = true
				}

				if !found {
					return fmt.Errorf("unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}
	// Handle vararg args
	{
		varArgStart := 0
		if varArgStart > len(remainingArgs) {
			varArgStart = len(remainingArgs)
		}
		varArgs := remainingArgs[varArgStart:]
		c.args = varArgs
	}

	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *RootCmd) NewToggleCmd() *ToggleCmd {
	set := flag.NewFlagSet("toggle", flag.ContinueOnError)
	v := &ToggleCmd{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}

	set.BoolVar(&v.x, "x", false, "Short flag x")

	set.BoolVar(&v.verbose, "v", false, "Verbose flag with short alias v")

	set.IntVar(&v.count, "count", 0, "Count parameter")
	set.Usage = v.Usage

	v.CommandAction = func(c *ToggleCmd) error {

		Toggle(c.x, c.verbose, c.count, c.args...)
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
