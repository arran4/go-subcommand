// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"fmt"
	"os"
	"strconv"

	"example.com/plusminus/cmd"
)

var _ Cmd = (*ToggleCmd)(nil)

type ToggleCmd struct {
	*RootCmd
	Flags         *flag.FlagSet
	x             bool
	verbose       bool
	count         int
	args          []string
	SubCommands   map[string]func() Cmd
	CommandAction func(c *ToggleCmd) error
}

type UsageDataToggleCmd struct {
	*ToggleCmd
	Recursive bool
}

func (c *ToggleCmd) Usage() {
	err := executeUsage(os.Stderr, "toggle_usage.txt", UsageDataToggleCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *ToggleCmd) usageError(kind cmd.UsageErrorKind, flag string, cause error, format string, args ...interface{}) error {
	return newUsageError(c.commandPath(), kind, flag, cause, format, args...)
}

func (c *ToggleCmd) commandPath() string { return "app toggle" }

func (c *ToggleCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "toggle_usage.txt", UsageDataToggleCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *ToggleCmd) Execute(args []string) (err error) {
	plusMinusOptions := map[string]plusMinusOption{
		"x": {Key: "x", Boolean: true, IO: false, Set: func(value string) error {
			v, err := strconv.ParseBool(value)
			if err != nil {
				return err
			}
			c.x = v
			return nil
		}},
		"verbose": {Key: "verbose", Boolean: true, IO: false, Set: func(value string) error {
			v, err := strconv.ParseBool(value)
			if err != nil {
				return err
			}
			c.verbose = v
			return nil
		}},
		"count": {Key: "count", Boolean: false, IO: false, Set: func(value string) error {
			v, err := strconv.Atoi(value)
			if err != nil {
				return err
			}
			c.count = v
			return nil
		}},
	}
	plusMinusShort := map[string]plusMinusOption{
		"x": plusMinusOptions["x"],
		"v": plusMinusOptions["verbose"],
	}
	plusMinusLong := map[string]plusMinusOption{
		"verbose": plusMinusOptions["verbose"],
		"count":   plusMinusOptions["count"],
	}
	_ = plusMinusOptions
	remainingArgs, seenFlags, dashDashSeen, plusMinusHelp, err := parsePlusMinus(args, c.commandPath(), plusMinusShort, plusMinusLong)
	if err != nil {
		return err
	}
	if plusMinusHelp {
		c.Usage()
		return nil
	}
	_ = seenFlags

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}
	// Handle vararg args
	{
		varArgStart := 0
		if varArgStart > len(remainingArgs) {
			varArgStart = len(remainingArgs)
		}
		varArgs := remainingArgs[varArgStart:]
		c.args = varArgs
	}

	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *RootCmd) NewToggleCmd() *ToggleCmd {
	set := flag.NewFlagSet("toggle", flag.ContinueOnError)
	v := &ToggleCmd{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}

	set.BoolVar(&v.x, "x", false, "Short flag x")

	set.BoolVar(&v.verbose, "v", false, "Verbose flag with short alias v")

	set.IntVar(&v.count, "count", 0, "Count parameter")
	set.Usage = v.Usage

	v.CommandAction = func(c *ToggleCmd) error {

		Toggle(c.x, c.verbose, c.count, c.args...)
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
