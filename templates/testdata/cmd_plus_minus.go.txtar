	remainingArgs, seenFlags, commitFlags, dashDashSeen, pmSpecial, err := parsePlusMinus(args, c.commandPath(), plusMinusShort, plusMinusLong, subcmdMap)
	if err != nil {
		return err
	}
	if pmSpecial == "help" || pmSpecial == "usage" {
		c.Usage()
