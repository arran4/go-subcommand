					return err
				}
				c.x = v
				return nil
			},
			StageMinus: func(value string) (func() error, error) {
				v, err := strconv.ParseBool(value)
				if err != nil {
					return nil, err
				}
				return func() error {
					c.x = v
					return nil
				}, nil
			},
			StageBarePlus: func() (func() error, error) {
				v := false
				return func() error {
					c.x = v
					return nil
				}, nil
			},
			StageValuePlus: func(value string) (func() error, error) {
				return nil, nil
			},
		},
		"verbose": {
			Key:               "verbose",
			Boolean:           true,
			IO:                false,
			SupportsBarePlus:  true,
			SupportsValuePlus: false,
			Set: func(value string) error {
				v, err := strconv.ParseBool(value)
				if err != nil {
					return err
				}
				c.verbose = v
				return nil
			},
			StageMinus: func(value string) (func() error, error) {
				v, err := strconv.ParseBool(value)
				if err != nil {
					return nil, err
				}
				return func() error {
					c.verbose = v
					return nil
				}, nil
			},
			StageBarePlus: func() (func() error, error) {
				v := false
				return func() error {
					c.verbose = v
					return nil
				}, nil
			},
			StageValuePlus: func(value string) (func() error, error) {
				return nil, nil
			},
		},
		"count": {
			Key:               "count",
			Boolean:           false,
			IO:                false,
			SupportsBarePlus:  false,
			SupportsValuePlus: false,
			Set: func(value string) error {
				v, err := strconv.Atoi(value)
				if err != nil {
					return err
				}
				c.count = v
				return nil
			},
			StageMinus: func(value string) (func() error, error) {
				v, err := strconv.Atoi(value)
				if err != nil {
					return nil, err
				}
				return func() error {
					c.count = v
					return nil
				}, nil
			},
			StageBarePlus: func() (func() error, error) {
				return nil, nil
