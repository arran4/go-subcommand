// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"fmt"
	"os"
	"strconv"

	"example.com/plusminus/cmd"
)

var _ Cmd = (*ToggleCmd)(nil)

type ToggleCmd struct {
	*RootCmd
	Flags           *flag.FlagSet
	x               bool
	verbose         bool
	count           int
	args            []string
	SubCommands     map[string]func() Cmd
	CommandAction   func(c *ToggleCmd) error
	plusMinusCommit func() error
	seenFlags       map[string]bool
}

func (c *ToggleCmd) commitAll() error {
	if c.plusMinusCommit != nil {
		fn := c.plusMinusCommit
		c.plusMinusCommit = nil
		return fn()
	}
	return nil
}

func (c *ToggleCmd) hasSeenFlag(name string) bool {
	return c.seenFlags != nil && c.seenFlags[name]
}

type UsageDataToggleCmd struct {
	*ToggleCmd
	Recursive bool
}

func (c *ToggleCmd) Usage() {
	err := executeUsage(os.Stderr, "toggle_usage.txt", UsageDataToggleCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *ToggleCmd) usageError(kind cmd.UsageErrorKind, flag string, cause error, format string, args ...interface{}) error {
	return newUsageError(c.commandPath(), kind, flag, cause, format, args...)
}

func (c *ToggleCmd) commandPath() string { return "app toggle" }

func (c *ToggleCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "toggle_usage.txt", UsageDataToggleCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

