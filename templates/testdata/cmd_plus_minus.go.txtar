		varArgStart := 0
		if varArgStart > len(remainingArgs) {
			varArgStart = len(remainingArgs)
		}
		varArgs := remainingArgs[varArgStart:]
		c.args = varArgs
	}
	if err := c.commitAll(); err != nil {
		return err
	}

	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
