-- input.json --
{
  "PackagePath": "example.com/fixture",
  "GoVersion": "1.22",
  "PackageName": "main",
  "MainCmdName": "app",
  "SubCommandName": "config",
  "SubCommandStructName": "ConfigCmd",
  "ConstructorMethodName": "NewConfigCmd",
  "SubCommandFunctionName": "Config",
  "SubCommandDescription": "Config optional value command",
  "SubCommandPackageName": "main",
  "UsageFileName": "config_usage.txt",
  "ResolvedCLIParser": "gnu",
  "Parameters": [
    {
      "Name": "label",
      "Type": "OptionalLabel",
      "OptionalValue": true,
      "FlagAliases": ["l"],
      "Description": "Optional value consumer-owned label"
    },
    {
      "Name": "items",
      "Type": "OptionalPointers",
      "OptionalValue": true,
      "FlagAliases": ["i"],
      "Description": "Repeated optional pointers"
    }
  ]
}
-- template_name --
cmd.go.gotmpl
-- output.go --
// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"fmt"
	"os"
	"slices"
	"strings"

	"example.com/fixture/cmd"
)

var _ Cmd = (*ConfigCmd)(nil)

type ConfigCmd struct {
	*RootCmd
	Flags         *flag.FlagSet
	label         OptionalLabel
	items         OptionalPointers
	SubCommands   map[string]func() Cmd
	CommandAction func(c *ConfigCmd) error
}

type UsageDataConfigCmd struct {
	*ConfigCmd
	Recursive bool
}

func (c *ConfigCmd) Usage() {
	err := executeUsage(os.Stderr, "config_usage.txt", UsageDataConfigCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *ConfigCmd) usageError(kind cmd.UsageErrorKind, flag string, cause error, format string, args ...any) error {
	return newUsageError(c.commandPath(), kind, flag, cause, format, args...)
}

func (c *ConfigCmd) commandPath() string { return "app config" }

func (c *ConfigCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "config_usage.txt", UsageDataConfigCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *ConfigCmd) Execute(args []string) (err error) {
	var remainingArgs []string
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {

			case "label":
				if err := c.label.SetOptionalValue(true, hasValue, value); err != nil {
					return c.usageError(cmd.UsageInvalidValue, name, err, "invalid optional value for flag %s: %s", name, err)
				}

			case "items":
				if err := c.items.SetOptionalValue(true, hasValue, value); err != nil {
					return c.usageError(cmd.UsageInvalidValue, name, err, "invalid optional value for flag %s: %s", name, err)
				}
			default:
				return c.usageError(cmd.UsageUnknownFlag, name, nil, "unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false

				if char == "l" {
					found = true
					value := ""
					hasValue := false
					if j+1 < len(shorts) {
						value = shorts[j+1:]
						if strings.HasPrefix(value, "=") {
							value = value[1:]
						}
						hasValue = true
						j = len(shorts)
					}
					if err := c.label.SetOptionalValue(true, hasValue, value); err != nil {
						return c.usageError(cmd.UsageInvalidValue, char, err, "invalid optional value for flag -%s: %s", char, err)
					}
				}

				if char == "i" {
					found = true
					value := ""
					hasValue := false
					if j+1 < len(shorts) {
						value = shorts[j+1:]
						if strings.HasPrefix(value, "=") {
							value = value[1:]
						}
						hasValue = true
						j = len(shorts)
					}
					if err := c.items.SetOptionalValue(true, hasValue, value); err != nil {
						return c.usageError(cmd.UsageInvalidValue, char, err, "invalid optional value for flag -%s: %s", char, err)
					}
				}
				if !found {
					return c.usageError(cmd.UsageUnknownFlag, char, nil, "unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}

	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *RootCmd) NewConfigCmd() *ConfigCmd {
	set := flag.NewFlagSet("config", flag.ContinueOnError)
	v := &ConfigCmd{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}
	set.Usage = v.Usage

	v.CommandAction = func(c *ConfigCmd) error {

		Config(c.label, c.items)
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					v.UsageRecursive()
					return nil
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
