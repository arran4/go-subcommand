  "SubCommandFunctionName": "Config",
  "SubCommandDescription": "Config optional value command",
  "SubCommandPackageName": "main",
  "UsageFileName": "config_usage.txt",
  "ResolvedCLIParser": "gnu",
  "Parameters": [
    {
      "Name": "label",
      "Type": "string",
      "OptionalValue": true,
      "FlagAliases": ["l"],
      "Description": "Optional string flag"
    },
    {
      "Name": "items",
      "Type": "[]*string",
      "OptionalValue": true,
      "FlagAliases": ["i"],
      "Description": "Repeated optional pointers"
    },
    {
      "Name": "big",
      "Type": "*int64",
      "OptionalValue": true,
      "FlagAliases": ["b"],
      "Description": "Optional int64 pointer"
    },
    {
      "Name": "ports",
      "Type": "[]uint32",
      "OptionalValue": true,
      "FlagAliases": ["p"],
      "Description": "Optional uint32 slice"
    },
    {
      "Name": "timeout",
      "Type": "*time.Duration",
      "OptionalValue": true,
      "FlagAliases": ["t"],
      "Description": "Optional duration pointer"
    }
  ]
}
-- template_name --
cmd.go.gotmpl
