// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"fmt"
	"os"
	"strconv"
	"strings"
	"time"

	"example.com/mypkg"
)

var _ Cmd = (*MySliceCmd)(nil)

type MySliceCmd struct {
	*RootCmd
	Flags         *flag.FlagSet
	files         []string
	counts        []int
	debugs        []bool
	timeouts      []time.Duration
	SubCommands   map[string]func() Cmd
	CommandAction func(c *MySliceCmd) error
}

type UsageDataMySliceCmd struct {
	*MySliceCmd
	Recursive bool
}

func (c *MySliceCmd) Usage() {
	err := executeUsage(os.Stderr, "myslicecmd_usage.txt", UsageDataMySliceCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *MySliceCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "myslicecmd_usage.txt", UsageDataMySliceCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *MySliceCmd) Execute(args []string) (err error) {

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}

	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return fmt.Errorf("myslicecmd failed: %w", err)
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *RootCmd) NewMySliceCmd() *MySliceCmd {
	set := flag.NewFlagSet("myslicecmd", flag.ContinueOnError)
	v := &MySliceCmd{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}

	set.Var((*StringSlice)(&v.files), "f", "Files list")

	set.Var((*IntSlice)(&v.counts), "counts", "Counts list")

	set.Var((*BoolSlice)(&v.debugs), "debugs", "Debug list")

	set.Var((*DurationSlice)(&v.timeouts), "timeouts", "Timeouts list")
	set.Usage = v.Usage

	v.CommandAction = func(c *MySliceCmd) error {

		mypkg.MySliceFunc(c.files, c.counts, c.debugs, c.timeouts)
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
