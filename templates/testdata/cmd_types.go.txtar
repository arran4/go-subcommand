-- input.json --
{
  "PackageName": "main",
  "SubCommandName": "mycmd",
  "SubCommandStructName": "MyCmd",
  "ConstructorMethodName": "NewMyCmd",
  "SubCommandFunctionName": "MyCmdFunc",
  "SubCommandDescription": "My command description",
  "SubCommandPackageName": "mypkg",
  "ImportPath": "example.com/mypkg",
  "UsageFileName": "mycmd_usage.txt",
  "Parameters": [
    {
      "Name": "timeout",
      "Type": "time.Duration",
      "FlagAliases": ["t"],
      "Description": "Timeout duration",
      "Default": "1s"
    },
    {
      "Name": "count",
      "Type": "int",
      "Description": "Retry count",
      "Default": "3"
    },
    {
        "Name": "config",
        "Type": "string",
        "Description": "Config file",
        "Default": "config.yaml"
    }
  ]
}
-- template_name --
cmd.go.gotmpl
-- output.go --
// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"fmt"
	"os"
	"strings"
	"time"

	"example.com/mypkg"
)

var _ Cmd = (*MyCmd)(nil)

type MyCmd struct {
	*RootCmd
	Flags         *flag.FlagSet
	timeout       time.Duration
	count         int
	config        string
	SubCommands   map[string]func() Cmd
	CommandAction func(c *MyCmd) error
}

type UsageDataMyCmd struct {
	*MyCmd
	Recursive bool
}

func (c *MyCmd) Usage() {
	err := executeUsage(os.Stderr, "mycmd_usage.txt", UsageDataMyCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *MyCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "mycmd_usage.txt", UsageDataMyCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *RootCmd) NewMyCmd() *MyCmd {
	set := flag.NewFlagSet("mycmd", flag.ContinueOnError)
	v := &MyCmd{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}

	if d, err := time.ParseDuration("1s"); err == nil {
		set.DurationVar(&v.timeout, "t", d, "Timeout duration")
	} else {
		set.DurationVar(&v.timeout, "t", 0, "Timeout duration")
	}

	set.IntVar(&v.count, "count", 3, "Retry count")

	set.StringVar(&v.config, "config", "config.yaml", "Config file")
	set.Usage = v.Usage

	v.CommandAction = func(c *MyCmd) error {

		mypkg.MyCmdFunc(c.timeout, c.count, c.config)
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
