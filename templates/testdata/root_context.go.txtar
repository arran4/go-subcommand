// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"fmt"
	"io"
	"os"
	"strings"
	"sync"

	"example.com/contextapp/buildinfo"
	"example.com/contextapp/cmd"
	"example.com/contextapp/cmd/contextapp/templates"
)

type Cmd interface {
	Execute(args []string) error
	Usage()
}

type InternalCommand struct {
	Exec      func(args []string) error
	UsageFunc func()
}

func (c *InternalCommand) Execute(args []string) error {
	return c.Exec(args)
}

func (c *InternalCommand) Usage() {
	c.UsageFunc()
}

func NewLazyCommand(f func() Cmd) func() Cmd {
	var once sync.Once
	var cmd Cmd
	return func() Cmd {
		once.Do(func() {
			cmd = f()
		})
		return cmd
	}
}

type UserError struct {
	Err error
	Msg string
}

func (e *UserError) Error() string {
	if e.Err != nil {
		return fmt.Sprintf("%s: %v", e.Msg, e.Err)
	}
	return e.Msg
}

func NewUserError(err error, msg string) *UserError {
	return &UserError{Err: err, Msg: msg}
}

func executeUsage(out io.Writer, templateName string, data interface{}) error {
	return templates.GetTemplates().ExecuteTemplate(out, templateName, data)
}

type RootCmd struct {
	*flag.FlagSet
	Commands      map[string]func() Cmd
	Version       string
	Commit        string
	Date          string
	buildInfo     buildinfo.BuildInfo
	CommandAction func(c *RootCmd) error
}

func (c *RootCmd) Usage() {
	err := executeUsage(os.Stderr, "contextapp_usage.txt", UsageDataRootCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *RootCmd) usageError(kind cmd.UsageErrorKind, flag string, cause error, format string, args ...interface{}) error {
	return newUsageError(c.commandPath(), kind, flag, cause, format, args...)
}

func (c *RootCmd) commandPath() string { return "contextapp" }

func (c *RootCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "contextapp_usage.txt", UsageDataRootCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

type UsageDataRootCmd struct {
	*RootCmd
	Recursive bool
}

// NewRoot retains the no-context constructor contract. Call
// NewRootWithContext when the application owns typed root context.
func NewRoot(name, version, commit, date string) (*RootCmd, error) {
	var buildInfo buildinfo.BuildInfo
	return NewRootWithContext(name, version, commit, date, buildInfo)
}

func NewRootWithContext(name, version, commit, date string, buildInfo buildinfo.BuildInfo) (*RootCmd, error) {
	c := &RootCmd{
		FlagSet:   flag.NewFlagSet(name, flag.ExitOnError),
		Commands:  make(map[string]func() Cmd),
		Version:   version,
		Commit:    commit,
		Date:      date,
		buildInfo: buildInfo,
	}
	c.FlagSet.Usage = c.Usage

	{
		subCmd := NewLazyCommand(func() Cmd { return c.NewChild() })
		c.Commands["child"] = subCmd

	}
	c.Commands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := false
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						deep = true
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"help"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				deep := false
				var target []string
				for _, arg := range args {
					if arg == "-deep" {
						deep = true
						continue
					}
					if arg == "-h" || arg == "--help" {
						continue
					}
					target = append(target, arg)
				}
				if len(target) > 0 {
					if sub, ok := c.Commands[target[0]]; ok && target[0] != "help" && target[0] != "usage" && target[0] != "version" {
						nextArgs := append([]string{"usage"}, target[1:]...)
						if deep {
							nextArgs = append(nextArgs, "-deep")
						}
						return sub().Execute(nextArgs)
					}
					c.Usage()
					return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", target[0])
				}
				if deep {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["version"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				fmt.Printf("Version: %s\nCommit: %s\nDate: %s\n", c.Version, c.Commit, c.Date)
				return nil
			},
			UsageFunc: func() {
				fmt.Fprintf(os.Stderr, "Usage: %s version\n", os.Args[0])
			},
		}
	}
	return c, nil
}

func (c *RootCmd) Execute(args []string) (err error) {

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.Commands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}
	c.Usage()
	if len(remainingArgs) > 0 {
		return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", remainingArgs[0])
	}
	return nil
}
