-- input.json --
{
  "PackageName": "main",
  "SubCommandName": "mycmd",
  "SubCommandStructName": "MyCmd",
  "ConstructorMethodName": "NewMyCmd",
  "SubCommandFunctionName": "MyCmdFunc",
  "SubCommandDescription": "My command description",
  "SubCommandPackageName": "mypkg",
  "ImportPath": "example.com/mypkg",
  "UsageFileName": "mycmd_usage.txt",
  "PositionalAlgorithm": "best-fit",
  "Parameters": [
    {
      "Name": "str1",
      "Type": "string",
      "IsPositional": true,
      "HasDefaultValue": true,
      "Default": "def1",
      "PositionalArgIndex": 1,
      "Description": "Optional string 1"
    },
    {
      "Name": "num1",
      "Type": "int",
      "IsPositional": true,
      "HasDefaultValue": true,
      "Default": "0",
      "PositionalArgIndex": 2,
      "Description": "Optional int 1"
    },
    {
      "Name": "str2",
      "Type": "string",
      "IsPositional": true,
      "HasDefaultValue": true,
      "Default": "def2",
      "PositionalArgIndex": 3,
      "Description": "Optional string 2"
    }
  ]
}
-- template_name --
cmd.go.gotmpl
-- output.go --
// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"example.com/mypkg"
	"flag"
	"fmt"
	"os"
	"strconv"
	"strings"
)

var _ Cmd = (*MyCmd)(nil)

type MyCmd struct {
	*RootCmd
	Flags         *flag.FlagSet
	str1          string
	num1          int
	str2          string
	SubCommands   map[string]func() Cmd
	CommandAction func(c *MyCmd) error
}

type UsageDataMyCmd struct {
	*MyCmd
	Recursive bool
}

func (c *MyCmd) Usage() {
	err := executeUsage(os.Stderr, "mycmd_usage.txt", UsageDataMyCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *MyCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "mycmd_usage.txt", UsageDataMyCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *MyCmd) Execute(args []string) error {
	var remainingArgs []string
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {
			default:
				return fmt.Errorf("unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false
				if !found {
					return fmt.Errorf("unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}
	// best-fit algorithm for optional positional arguments
	currentArgIndex := 0
	// Handle positional argument str1 (best-fit)
	{
		var assigned bool
		// Optional positional
		if currentArgIndex < len(remainingArgs) {
			argVal := remainingArgs[currentArgIndex]
			c.str1 = argVal
			assigned = true
			if assigned {
				currentArgIndex++
			}
		}
		if !assigned {
			c.str1 = "def1"
		}
	}
	// Handle positional argument num1 (best-fit)
	{
		var assigned bool
		// Optional positional
		if currentArgIndex < len(remainingArgs) {
			argVal := remainingArgs[currentArgIndex]
			v, err := strconv.Atoi(argVal)
			if err == nil {
				c.num1 = v
				assigned = true
			}
			if assigned {
				currentArgIndex++
			}
		}
		if !assigned {
			v, err := strconv.Atoi(0)
			if err != nil {
				return fmt.Errorf("invalid default value for num1: %w", err)
			}
			c.num1 = v
		}
	}
	// Handle positional argument str2 (best-fit)
	{
		var assigned bool
		// Optional positional
		if currentArgIndex < len(remainingArgs) {
			argVal := remainingArgs[currentArgIndex]
			c.str2 = argVal
			assigned = true
			if assigned {
				currentArgIndex++
			}
		}
		if !assigned {
			c.str2 = "def2"
		}
	}

	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return fmt.Errorf("mycmd failed: %w", err)
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *RootCmd) NewMyCmd() *MyCmd {
	set := flag.NewFlagSet("mycmd", flag.ContinueOnError)
	v := &MyCmd{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}
	set.Usage = v.Usage

	v.CommandAction = func(c *MyCmd) error {

		mypkg.MyCmdFunc(c.str1, c.num1, c.str2)
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
