-- input.json --
{
  "PackageName": "main",
  "MainCmdName": "app",
  "SubCommandName": "child",
  "SubCommandStructName": "ParentChild",
  "ConstructorMethodName": "NewParentChild",
  "SubCommandFunctionName": "Child",
  "SubCommandDescription": "Child command",
  "SubCommandPackageName": "main",
  "UsageFileName": "child_usage.txt",
  "ResolvedCLIParser": "gnu",
  "Parent": {
    "SubCommandName": "parent",
    "SubCommandStructName": "Parent",
    "ConstructorMethodName": "NewParent",
    "Parameters": [
      {
        "Name": "sameDir",
        "Type": "string",
        "FlagAliases": ["same-dir"]
      }
    ]
  },
  "Parameters": [
    {
      "Name": "sameDir",
      "Type": "string",
      "FlagAliases": ["same-dir"],
      "DeclaredIn": "parent",
