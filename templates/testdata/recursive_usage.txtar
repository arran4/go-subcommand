-- input.json --
{
  "MainCmdName": "myapp",
  "SubCommandName": "root",
"SubCommandStructName": "Root",
"ConstructorMethodName": "NewRoot",
  "SubCommandDescription": "Root command",
  "Recursive": true,
  "SubCommands": [
    {
      "SubCommandName": "child1",
      "SubCommandDescription": "First child",
      "SubCommands": [
           {
               "SubCommandName": "grandchild",
               "SubCommandDescription": "Grandchild"
           }
      ]
    },
    {
      "SubCommandName": "child2",
      "SubCommandDescription": "Second child"
    }
  ],
  "SubCommandFunctionName": "exec"
}
-- output.txt --
{{/* Do not modify: Generated by github.com/arran4/go-subcommand/cmd/gosubc */ -}}
Usage: myapp root <subcommand>

Root command

Subcommands:
{{- $commands := subcommands -}}
{{if .Recursive}}
{{- $commands = subcommands
    (subcommand "root child1" "First child")
    (subcommand "root child1 grandchild" "Grandchild")
    (subcommand "root child2" "Second child")
    (subcommand "help" "Print this help message")
    (subcommand "usage" "Print this usage message")
-}}
{{else}}
{{- $commands = subcommands
    (subcommand "child1" "First child")
    (subcommand "child2" "Second child")
    (subcommand "help" "Print this help message")
    (subcommand "usage" "Print this usage message")
-}}
{{end}}
{{- $width := subcommandWidth $commands -}}
{{- range $commands}}
{{- if .Description}}
    {{printf "%-*s" $width .Label}} {{.Description}}
{{- else}}
    {{.Label}}
{{- end}}
{{- end}}
