{{/* Do not modify: Generated by github.com/arran4/go-subcommand/cmd/gosubc */ -}}
Usage: myapp root <subcommand>

Root command

Subcommands:
{{if .Recursive}}
    {{formatHelpRow 22 "root child1" "First child"}}
    {{formatHelpRow 22 "root child1 grandchild" "Grandchild"}}
    {{formatHelpRow 22 "root child2" "Second child"}}
    {{formatHelpRow 22 "help" "Print this help message"}}
    {{formatHelpRow 22 "usage" "Print this usage message"}}
{{else}}
    {{formatHelpRow 6 "child1" "First child"}}
