-- template_name --
root_test.go.gotmpl
-- output.go --
// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"testing"
	"time"
)

func TestRoot_Execute(t *testing.T) {
	cmd, err := NewRoot("test", "", "", "")
	if err != nil {
		t.Fatalf("Failed to create root command: %v", err)
	}

	called := false
	cmd.CommandAction = func(c *RootCmd) error {
		called = true
		return nil
	}

	args := []string{}
	args = append(args, "--str")
	args = append(args, "test")
	args = append(args, "--int")
	args = append(args, "1")
	args = append(args, "--int64")
	args = append(args, "1")
	args = append(args, "--float")
	args = append(args, "1.5")
	args = append(args, "--bool")
	args = append(args, "--dur")
	args = append(args, "1s")

	err = cmd.Execute(args)
	if err != nil {
		t.Errorf("Unexpected error: %v", err)
	}
	if !called {
		t.Error("CommandAction was not called")
	}

	if cmd.strPtr == nil {
		t.Errorf("Expected strPtr to be non-nil")
	} else if *cmd.strPtr != "test" {
		t.Errorf("Expected strPtr to be 'test', got '%v'", *cmd.strPtr)
	}
	if cmd.intPtr == nil {
		t.Errorf("Expected intPtr to be non-nil")
	} else if *cmd.intPtr != 1 {
		t.Errorf("Expected intPtr to be 1, got '%v'", *cmd.intPtr)
	}
	if cmd.int64Ptr == nil {
		t.Errorf("Expected int64Ptr to be non-nil")
	} else if *cmd.int64Ptr != 1 {
		t.Errorf("Expected int64Ptr to be 1, got '%v'", *cmd.int64Ptr)
	}
	if cmd.floatPtr == nil {
		t.Errorf("Expected floatPtr to be non-nil")
	} else if *cmd.floatPtr != 1.5 {
		t.Errorf("Expected floatPtr to be 1.5, got '%v'", *cmd.floatPtr)
	}
	if cmd.boolPtr == nil {
		t.Errorf("Expected boolPtr to be non-nil")
	} else if *cmd.boolPtr != true {
		t.Errorf("Expected boolPtr to be true, got '%v'", *cmd.boolPtr)
	}
	if cmd.durPtr == nil {
		t.Errorf("Expected durPtr to be non-nil")
	} else if *cmd.durPtr != 1*time.Second {
		t.Errorf("Expected durPtr to be 1s, got '%v'", *cmd.durPtr)
	}

}

func TestRoot_ExecuteHelpAndUnknownFlags(t *testing.T) {
	cmd, err := NewRoot("test", "", "", "")
	if err != nil {
		t.Fatalf("Failed to create root command: %v", err)
	}

	if err := cmd.Execute([]string{"--help"}); err != nil {
		t.Errorf("--help returned an error: %v", err)
	}
	if err := cmd.Execute([]string{"-h"}); err != nil {
		t.Errorf("-h returned an error: %v", err)
	}
	if err := cmd.Execute([]string{"--not-a-real-flag"}); err == nil {
		t.Error("expected an error for an unknown long flag")
	}
	if err := cmd.Execute([]string{"-?"}); err == nil {
		t.Error("expected an error for an unknown short flag")
	}
}
