-- input.json --
{
  "PackageName": "main",
  "PackagePath": "example.com/contextapp",
  "MainCmdName": "contextapp",
  "SubCommandName": "child",
  "SubCommandStructName": "Child",
  "ConstructorMethodName": "NewChild",
  "SubCommandFunctionName": "Child",
  "SubCommandDescription": "Child command inheriting root context",
  "SubCommandPackageName": "main",
  "UsageFileName": "child_usage.txt",
  "ResolvedCLIParser": "gnu",
  "Imports": [
    "example.com/contextapp/buildinfo"
  ],
  "Parameters": [
    {
      "Name": "buildInfo",
      "Type": "buildinfo.BuildInfo",
      "TypeImportPath": "example.com/contextapp/buildinfo",
      "Inherited": true,
      "Description": "Build metadata from the root constructor",
      "Generator": {
        "Type": "constructor"
      }
    }
  ]
}
-- template_name --
cmd.go.gotmpl
-- output.go --
// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"fmt"
	"os"
	"strings"
)

var _ Cmd = (*Child)(nil)

type Child struct {
	*RootCmd
	Flags         *flag.FlagSet
	SubCommands   map[string]func() Cmd
	CommandAction func(c *Child) error
}

type UsageDataChild struct {
	*Child
	Recursive bool
}

func (c *Child) Usage() {
	err := executeUsage(os.Stderr, "child_usage.txt", UsageDataChild{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *Child) UsageRecursive() {
	err := executeUsage(os.Stderr, "child_usage.txt", UsageDataChild{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *Child) Execute(args []string) (err error) {
	var remainingArgs []string
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {
			default:
				return fmt.Errorf("unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false
				if !found {
					return fmt.Errorf("unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.SubCommands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}

	if c.CommandAction != nil {
		if err := c.CommandAction(c); err != nil {
			return err
		}
	} else {
		c.Usage()
	}

	return nil
}

func (c *RootCmd) NewChild() *Child {
	set := flag.NewFlagSet("child", flag.ContinueOnError)
	v := &Child{
		RootCmd:     c,
		Flags:       set,
		SubCommands: make(map[string]func() Cmd),
	}
	set.Usage = v.Usage

	v.CommandAction = func(c *Child) error {

		Child(c.buildInfo)
		return nil
	}

	v.SubCommands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	v.SubCommands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				for _, arg := range args {
					if arg == "-deep" {
						v.UsageRecursive()
						return nil
					}
				}
				v.Usage()
				return nil
			},
			UsageFunc: v.Usage,
		}
	}
	return v
}
