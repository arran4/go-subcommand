The input/ files are also compiled and executed by TestGenerateFlagPresence.
The template golden below makes the parser presence bookkeeping inspectable.
-- input.json --
{
  "SubCommandName": "child",
  "SubCommandStructName": "Child",
  "ConstructorMethodName": "NewChild",
  "SubCommandFunctionName": "Child",
  "SubCommandPackageName": "app",
  "ImportPath": "example.com/presence",
  "PackagePath": "example.com/presence",
  "UsageFileName": "child_usage.txt",
  "ResolvedCLIParser": "gnu",
  "GoVersion": "1.22",
  "Parameters": [
    {
      "Name": "enabled",
      "Type": "bool",
      "FlagAliases": [
        "enabled",
        "e"
      ],
      "Default": "true",
      "HasDefaultValue": true
    },
    {
      "Name": "count",
      "Type": "int",
      "FlagAliases": [
        "count",
        "n"
      ],
      "Default": "7",
      "HasDefaultValue": true
    },
    {
      "Name": "label",
      "Type": "string",
      "FlagAliases": [
        "label",
        "l"
      ],
      "Default": "configured",
      "HasDefaultValue": true
    },
    {
      "Name": "seen",
      "Type": "map[string]bool",
      "Generator": {
        "Type": "flag-presence"
      }
    }
  ]
}
-- template_name --
cmd.go.gotmpl
-- input/go.mod --
module example.com/presence

go 1.22
-- input/gosubc.mdc --
format-version: 1
cli-parser: go-flag
recursive: false
project-provenance: false
timestamp: false
emit-go-generate: false
-- input/app.go --
package app

import (
	"encoding/json"
	"fmt"
)

// Root is a subcommand `app` reports parsed values and explicit presence.
//
// Flags:
//
//	enabled: --enabled -e (default: true) Enable the action.
//	count: --count -n (default: 7) Number of items.
//	label: --label -l (default: "configured") Label.
//	seen: (flag presence) Parameters supplied on this invocation.
func Root(enabled bool, count int, label string, seen map[string]bool) {
	report(enabled, count, label, seen)
}

// Child is a subcommand `app child` reports its own parameter presence.
//
// Flags:
//
//	enabled: --enabled -e (default: true) Enable the action.
//	count: --count -n (default: 7) Number of items.
//	label: --label -l (default: "configured") Label.
//	seen: (flag presence) Parameters supplied on this invocation.
func Child(enabled bool, count int, label string, seen map[string]bool) {
	report(enabled, count, label, seen)
}

func report(enabled bool, count int, label string, seen map[string]bool) {
	presence, _ := json.Marshal(seen)
	fmt.Printf("enabled=%t count=%d label=%q seen=%s\n", enabled, count, label, presence)
}
