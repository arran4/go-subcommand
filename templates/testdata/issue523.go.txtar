Typed-error source, process invocations and inspectable error contract.
Run by TestGenerateTypedErrors and the existing TestGoTemplates loader.
-- input.json --
{
  "PackagePath": "example.com/typederrors",
  "GoVersion": "1.22"
}
-- template_name --
errors.go.gotmpl
-- input/go.mod --
module example.com/typederrors

go 1.22
-- input/app.go --
package app

import (
	"errors"
	"fmt"
	"io"

	"example.com/typederrors/cmd"
)

var ParserCause = errors.New("parser cause")
var UsageFailure = &cmd.UsageError{CommandPath: "app action", Kind: cmd.UsageInvalidValue, Message: "usage failure"}
var WrappedUsage = fmt.Errorf("wrapped: %w", UsageFailure)

func ParseCustom(value string) (string, error) {
	if value == "bad" { return "", ParserCause }
	return value, nil
}

// Root is a subcommand `app` demonstrates typed errors.
//
// Flags:
//
//	prefix: --prefix (default: "root") Inherited label.
func Root(prefix string) { fmt.Printf("root:%s\n", prefix) }

// Check is a subcommand `app group check` binds inherited flags and values.
//
// Flags:
//
//	prefix: (from parent) Inherited label.
//	count: --count -n (default: 0) Item count.
//	enabled: --enabled -e (default: false) Enable output.
//	custom: (parser: ParseCustom) --custom Custom input.
func Check(prefix string, count int, enabled bool, custom string) {
	fmt.Printf("%s:%d:%t:%s\n", prefix, count, enabled, custom)
}

// Action is a subcommand `app action` returns representative application errors.
//
// Flags:
//
//	mode: --mode (default: "plain") Error category.
//	code: --code (default: 0) Explicit status.
func Action(mode string, code int) error {
	switch mode {
	case "usage": return UsageFailure
	case "wrapped-usage": return WrappedUsage
	case "exit": return &cmd.ErrExitCode{Code: code}
	case "wrapped-exit": return fmt.Errorf("outer: %w", &cmd.ErrExitCode{Code: code})
	case "exit-cause": return fmt.Errorf("outer: %w", &cmd.ErrExitCode{Code: code, Err: errors.New("inner cause")})
	case "exit-help": return &cmd.ErrExitCode{Code: code, Err: cmd.ErrPrintHelp}
	case "validation": return fmt.Errorf("outer: %w", &cmd.ErrExitCode{Code: 2, Err: errors.New("validation failure")})
	case "internal": return fmt.Errorf("outer: %w", &cmd.ErrExitCode{Code: 3, Err: errors.New("internal failure")})
	case "help": return fmt.Errorf("wrapped: %w", cmd.ErrPrintHelp)
	case "hint": return fmt.Errorf("wrapped: %w", cmd.ErrHelp)
	}
	return errors.New("plain failure")
}

// Required is a subcommand `app required` requires a token.
//
// Flags:
//
//	token: (required) --token -t Token.
func Required(token string) { fmt.Println(token) }

// Positional is a subcommand `app positional` reads a required integer.
//
// Flags:
//
//	value: @1 Integer argument.
func Positional(value int) { fmt.Println(value) }

// Tail is a subcommand `app tail` takes one or two values.
//
// Flags:
//
//	values: @1 1...2 Values.
func Tail(values ...string) { fmt.Println(values) }

func Build() (string, error) { fmt.Println("provider"); return "provided", nil }

// Effect is a subcommand `app effect` acquires a business provider.
//
// Flags:
//
//	value: (generator: Build) Acquired value.
func Effect(value string) { fmt.Println(value) }

// Read is a subcommand `app read` acquires input without reclassifying I/O errors.
//
// Flags:
//
//	input: --input Input file.
func Read(input io.Reader) { _, _ = io.Copy(io.Discard, input) }

