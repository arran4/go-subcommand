Functionless no-command policy. TestGenerateNoCommandPolicy generates twice,
compares Go/config output, compiles and checks process/API behavior.
-- input.json --
{
  "PackagePath": "example.com/nocommand",
  "MainCmdName": "app",
  "Description": "Run jobs.",
  "ResolvedCLIParser": "gnu",
  "GoVersion": "1.22",
  "NoCommand": "error",
  "Metadata": {"Path": "app", "NoCommand": "error"},
  "SubCommands": [],
  "Parameters": []
}
-- template_name --
root.go.gotmpl
-- expected/root-help.stderr --
Usage: app <subcommand>

Run jobs.

Subcommands:

    group  Group jobs.
    number Print a positional integer.
    run    Run a job.
-- expected/do-help.stderr --
Usage: app group [flags...] do [flags...]

Run with a provider.

Subcommands:
    help  Print this help message
    usage Print this usage message


Flags:
    --prefix string   (default: "ready")   Label.
-- expected/unknown.stderr --
Usage: app <subcommand>

Run jobs.

Subcommands:

    group  Group jobs.
    number Print a positional integer.
    run    Run a job.
Error: unknown command: missing
-- expected/terminated.stderr --
Usage: app <subcommand>

Run jobs.

Subcommands:

    group  Group jobs.
    number Print a positional integer.
    run    Run a job.
Error: unknown command: run
-- input/go.mod --
module example.com/nocommand

go 1.22
-- input/metadata.go --
// App is a command `app` -- Run jobs.
// No command: error
package commands
-- input/gosubc.mdc --
format-version: 1
project-provenance: false
timestamp: false
emit-go-generate: false

# Commands
```command: app
Description: Run jobs.
No command: error
```
-- input/commands.go --
package commands

import "fmt"

// Run is a subcommand `app run` -- Run a job.
func Run() { fmt.Println("run") }

// Group is a subcommand `app group` -- Group jobs.
// Aliases: g
//
// Flags:
//
//	prefix: --prefix (default: "ready") Label.
func Group(prefix string) { fmt.Println("group:" + prefix) }

func Build() (string, error) { fmt.Println("provider"); return "provided", nil }

// Do is a subcommand `app group do` -- Run with a provider.
// Aliases: doit
//
// Flags:
//
//	prefix: (from parent) Label.
//	value: (generator: Build) Prepared value.
func Do(prefix, value string) { fmt.Println(prefix + ":" + value) }

// Number is a subcommand `app number` -- Print a positional integer.
//
// Flags:
//
//	number: @1 Integer.
func Number(number int) { fmt.Println(number) }
-- input/root-action.go --
package commands

// Root is a subcommand `app` -- Real root.
//
// Flags:
//
//	name: --name (default: "root") Root flag.
func Root(name string) {}
-- input/action-policy.go --
package commands

// Root is a subcommand `app` -- Real root.
// No command: error
func Root() {}
-- input/default-child.go --
package commands

// DefaultChild is a subcommand `app default` -- Default child.
// Default: true
func DefaultChild() {}
-- expected/invocations.json --
[
  {"args": [], "status": 1, "stderr": "Error: no command provided\n"},
  {"args": ["--"], "status": 1, "stderr": "Error: no command provided\n"},
  {"args": ["run"], "stdout": "run\n"},
  {"args": ["g", "--prefix=chosen", "doit"], "stdout": "provider\nchosen:provided\n"},
  {"args": ["number", "--", "-3"], "stdout": "-3\n"},
  {"args": ["help"], "stderrFile": "root-help.stderr"},
  {"args": ["usage"], "stderrFile": "root-help.stderr"},
  {"args": ["--help"], "stderrFile": "root-help.stderr"},
  {"args": ["help", "g", "doit"], "stderrFile": "do-help.stderr"},
  {"args": ["usage", "group", "do"], "stderrFile": "do-help.stderr"},
  {"args": ["group", "do", "--help"], "stderrFile": "do-help.stderr"},
  {"args": ["version"], "stdout": "Version: dev\nCommit: none\nDate: unknown\n"},
  {"args": ["missing"], "status": 1, "stderrFile": "unknown.stderr"},
  {"args": ["--", "run"], "status": 1, "stderrFile": "terminated.stderr"}
]
-- output.go --
// Code generated by github.com/arran4/go-subcommand/cmd/gosubc. DO NOT EDIT.

package main

import (
	"flag"
	"fmt"
	"io"
	"os"
	"slices"
	"strings"
	"sync"

	"example.com/nocommand/cmd"
	"example.com/nocommand/cmd/app/templates"
)

type Cmd interface {
	Execute(args []string) error
	Usage()
}

type InternalCommand struct {
	Exec      func(args []string) error
	UsageFunc func()
}

func (c *InternalCommand) Execute(args []string) error {
	return c.Exec(args)
}

func (c *InternalCommand) Usage() {
	c.UsageFunc()
}

func NewLazyCommand(f func() Cmd) func() Cmd {
	var once sync.Once
	var cmd Cmd
	return func() Cmd {
		once.Do(func() {
			cmd = f()
		})
		return cmd
	}
}

type UserError struct {
	Err error
	Msg string
}

func (e *UserError) Error() string {
	if e.Err != nil {
		return fmt.Sprintf("%s: %v", e.Msg, e.Err)
	}
	return e.Msg
}

func NewUserError(err error, msg string) *UserError {
	return &UserError{Err: err, Msg: msg}
}

func executeUsage(out io.Writer, templateName string, data any) error {
	return templates.GetTemplates().ExecuteTemplate(out, templateName, data)
}

type RootCmd struct {
	*flag.FlagSet
	Commands      map[string]func() Cmd
	Version       string
	Commit        string
	Date          string
	CommandAction func(c *RootCmd) error
}

func (c *RootCmd) Usage() {
	err := executeUsage(os.Stderr, "app_usage.txt", UsageDataRootCmd{c, false})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

func (c *RootCmd) usageError(kind cmd.UsageErrorKind, flag string, cause error, format string, args ...any) error {
	return newUsageError(c.commandPath(), kind, flag, cause, format, args...)
}

func (c *RootCmd) commandPath() string { return "app" }

func (c *RootCmd) UsageRecursive() {
	err := executeUsage(os.Stderr, "app_usage.txt", UsageDataRootCmd{c, true})
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error generating usage: %s\n", err)
	}
}

type UsageDataRootCmd struct {
	*RootCmd
	Recursive bool
}

func NewRoot(name, version, commit, date string) (*RootCmd, error) {
	c := &RootCmd{
		FlagSet:  flag.NewFlagSet(name, flag.ExitOnError),
		Commands: make(map[string]func() Cmd),
		Version:  version,
		Commit:   commit,
		Date:     date,
	}
	c.FlagSet.Usage = c.Usage

	c.Commands["help"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["usage"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				if slices.Contains(args, "-deep") {
					c.UsageRecursive()
					return nil
				}
				c.Usage()
				return nil
			},
			UsageFunc: c.Usage,
		}
	}
	c.Commands["version"] = func() Cmd {
		return &InternalCommand{
			Exec: func(args []string) error {
				fmt.Printf("Version: %s\nCommit: %s\nDate: %s\n", c.Version, c.Commit, c.Date)
				return nil
			},
			UsageFunc: func() {
				fmt.Fprintf(os.Stderr, "Usage: %s version\n", os.Args[0])
			},
		}
	}
	return c, nil
}

func (c *RootCmd) Execute(args []string) (err error) {
	var remainingArgs []string
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {
			default:
				return c.usageError(cmd.UsageUnknownFlag, name, nil, "unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false
				if !found {
					return c.usageError(cmd.UsageUnknownFlag, char, nil, "unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}

	if !dashDashSeen && len(remainingArgs) > 0 {
		if cmd, ok := c.Commands[remainingArgs[0]]; ok {
			return cmd().Execute(remainingArgs[1:])
		}
	}
	if len(remainingArgs) == 0 {
		return c.usageError(cmd.UsageNoCommand, "", nil, "no command provided")
	}
	c.Usage()
	if len(remainingArgs) > 0 {
		return c.usageError(cmd.UsageUnknownCommand, "", nil, "unknown command: %s", remainingArgs[0])
	}
	return nil
}
