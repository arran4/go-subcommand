Metadata is functionless. TestGenerateCommandMetadata consumes the real input files,
compares Go/config declarations, generates twice, compiles, and runs the invocation matrix.
The root.go template golden is also compared with the real empty-root generated file.
-- input.json --
{
  "PackagePath": "example.com/metadata",
  "MainCmdName": "app",
  "Description": "Manage jobs.",
  "ExtendedHelp": "More application help.",
  "ResolvedCLIParser": "gnu",
  "GoVersion": "1.22",
  "Metadata": {
    "Path": "app"
  },
  "SubCommands": [],
  "Parameters": []
}
-- template_name --
root.go.gotmpl
-- input/go.mod --
module example.com/metadata

go 1.22
-- input/commands.go --
package commands

import "fmt"

// Generate is a subcommand `app generate` -- Generate jobs.
func Generate() { fmt.Println("generate") }

// Show is a subcommand `app config show` -- Show settings.
func Show() { fmt.Println("show") }

// RootChild is a subcommand `app root` -- A literal root child.
// Aliases: literal
func RootChild() { fmt.Println("literal-root") }

func Build() (string, error) { fmt.Println("provider"); return "ready", nil }

// Service is a subcommand `app service` -- Start the service.
//
// Flags:
//
//	value: (generator: Build) Prepared service.
func Service(value string) { fmt.Println("service:" + value) }

-- input/metadata.go --
// App is a command `app` -- Manage jobs.
// More application help.
package commands

// Config is a command `app config` -- Inspect configuration.
// Aliases: c
// More configuration help.

// About is a command `app about` -- Documentation topic.
// Aliases: info

-- input/root-action.go --
package commands

import "fmt"

// RootAction is a subcommand `app` -- A real root action.
//
// Flags:
//
//	name: --name (default: "root") Root label.
func RootAction(name string) { fmt.Println("root:" + name) }

// Inherited is a subcommand `app inherited` -- Read the root label.
//
// Flags:
//
//	name: (from parent) Root label.
func Inherited(name string) { fmt.Println("inherited:" + name) }

-- input/gosubc.mdc --
format-version: 1
recursive: true
cli-parser: gnu
project-provenance: false
timestamp: false
emit-go-generate: false

# Commands

```command: app
Description: Manage jobs.
More application help.
```

```command: app config
Description: Inspect configuration.
Aliases: c
More configuration help.
```

```command: app about
Description: Documentation topic.
Aliases: info
```

# Documentation

```markdown: app file=docs/root.md
```

````markdown: app config
Configuration appendix.

```sh
app config show
```
````

```text: app about file="docs/about help.txt"
```

# Man content

```man: app EXAMPLES
app generate
```

```man: app config EXAMPLES file=docs/config.txt
```

