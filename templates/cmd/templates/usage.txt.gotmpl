{{ "{{" }}/* Do not modify: Generated by github.com/arran4/go-subcommand/cmd/gosubc */ -{{ "}}" }}
{{ define "subcommands_recursive" -}}
{{- $commands := index . 0}}{{- $width := index . 1}}
{{- range $commands}}
{{- if .SubCommandDescription}}
    {{printf "%-*s" $width .SubCommandSequence}} {{.SubCommandDescription}}
{{- else}}
    {{.SubCommandSequence}}
{{- end}}
{{- if .SubCommands}}
{{- template "subcommands_recursive" (list .SubCommands $width) }}
{{- end}}
{{- end}}
{{- end -}}
Usage: {{.FullUsageString}}
{{- if .SubCommandDescription}}

{{.SubCommandDescription}}
{{- end}}
{{- if .SubCommandExtendedHelp}}

{{.SubCommandExtendedHelp}}
{{- end}}
{{- if or .SubCommands .SubCommandFunctionName}}

Subcommands:
{{- if .SubCommands}}
{{ "{{" }}if .Recursive{{ "}}" }}
{{- $recursiveWidth := .UsageSubcommandWidth true}}
{{- template "subcommands_recursive" (list .SubCommands $recursiveWidth) }}
{{- if .SubCommandFunctionName }}
    {{printf "%-*s" $recursiveWidth "help"}} Print this help message
    {{printf "%-*s" $recursiveWidth "usage"}} Print this usage message
{{- end}}
{{ "{{" }}else{{ "}}" }}
{{- $shallowWidth := .UsageSubcommandWidth false}}
{{- range .SubCommands}}
{{- if .SubCommandDescription}}
    {{printf "%-*s" $shallowWidth .SubCommandName}} {{.SubCommandDescription}}
{{- else}}
    {{.SubCommandName}}
{{- end}}
{{- end}}
{{- if .SubCommandFunctionName }}
    {{printf "%-*s" $shallowWidth "help"}} Print this help message
    {{printf "%-*s" $shallowWidth "usage"}} Print this usage message
{{- end}}
{{ "{{" }}end{{ "}}" }}
{{- else if .SubCommandFunctionName }}
    help  Print this help message
    usage Print this usage message
{{- end}}
{{- end}}
{{- if .ParameterGroups}}
{{- $maxFlag := add .MaxFlagLength 2}}{{- $maxDef := .MaxDefaultLength}}{{- if gt $maxDef 0}}{{- $maxDef = add $maxDef 2}}{{- end}}

{{if eq (len .ParameterGroups) 1}}
{{- range .ParameterGroups}}
Flags:
{{- range .Parameters}}
    {{printf "%-*s %-*s" $maxFlag .FlagString $maxDef .DefaultString}}{{if .Description}} {{wrapFlag $maxFlag $maxDef .FlagString .DefaultString .Description}}{{end}}
{{- end}}
{{- end}}
{{- else}}
{{- range .ParameterGroups}}

`{{.CommandName}}` Flags:
{{- range .Parameters}}
    {{printf "%-*s %-*s" $maxFlag .FlagString $maxDef .DefaultString}}{{if .Description}} {{wrapFlag $maxFlag $maxDef .FlagString .DefaultString .Description}}{{end}}
{{- end}}
{{- end}}
{{- end}}
{{- end}}
{{- $hasPositional := false}}{{- range .Parameters}}{{- if .IsPositional}}{{- $hasPositional = true}}{{- end}}{{- end}}
{{- if $hasPositional}}

Positional Arguments:
{{- range .Parameters}}
{{- if .IsPositional}}
    {{- if .IsVarArg}}
    {{ printf "[%s...]" .Name | printf "%-10s"}} {{.Description}}
    {{- else if .HasDefaultValue}}
    {{ printf "[%s]" .Name | printf "%-10s"}} {{.Description}}
    {{- else}}
    {{ printf "<%s>" .Name | printf "%-10s"}} {{.Description}}
    {{- end}}
{{- end}}
{{- end}}
{{- end}}
