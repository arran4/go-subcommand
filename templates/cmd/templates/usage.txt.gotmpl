{{ "{{" }}/* Do not modify: Generated by github.com/arran4/go-subcommand/cmd/gosubc */ -{{ "}}" }}
{{ define "subcommands_recursive" -}}
{{- $commands := index . 0}}{{- $width := index . 1}}
{{- range $commands}}
    {{ "{{" }}formatHelpRow {{$width}} {{printf "%q" .SubCommandSequence}} {{printf "%q" .SubCommandDescription}}{{ "}}" }}
{{- if .SubCommands}}
{{- template "subcommands_recursive" (list .SubCommands $width) }}
{{- end}}
{{- end}}
{{- end -}}
Usage: {{escapeUsageText .FullUsageString}}
{{- if .SubCommandDescription}}

{{escapeUsageText .SubCommandDescription}}
{{- end}}
{{- if .SubCommandExtendedHelp}}

{{escapeUsageText .SubCommandExtendedHelp}}
{{- end}}
{{- if or .SubCommands .SubCommandFunctionName}}

Subcommands:
{{- if .SubCommands}}
{{ "{{" }}if .Recursive{{ "}}" }}
{{- $recursiveWidth := .UsageSubcommandWidth true}}
{{- template "subcommands_recursive" (list .SubCommands $recursiveWidth) }}
{{- if .SubCommandFunctionName }}
    {{ "{{" }}formatHelpRow {{$recursiveWidth}} "help" "Print this help message"{{ "}}" }}
    {{ "{{" }}formatHelpRow {{$recursiveWidth}} "usage" "Print this usage message"{{ "}}" }}
{{- end}}
{{ "{{" }}else{{ "}}" }}
{{- $shallowWidth := .UsageSubcommandWidth false}}
{{- range .SubCommands}}
    {{ "{{" }}formatHelpRow {{$shallowWidth}} {{printf "%q" .SubCommandName}} {{printf "%q" .SubCommandDescription}}{{ "}}" }}
{{- end}}
{{- if .SubCommandFunctionName }}
    {{ "{{" }}formatHelpRow {{$shallowWidth}} "help" "Print this help message"{{ "}}" }}
    {{ "{{" }}formatHelpRow {{$shallowWidth}} "usage" "Print this usage message"{{ "}}" }}
{{- end}}
{{ "{{" }}end{{ "}}" }}
{{- else if .SubCommandFunctionName }}
{{- $shallowWidth := .UsageSubcommandWidth false}}
    {{ "{{" }}formatHelpRow {{$shallowWidth}} "help" "Print this help message"{{ "}}" }}
    {{ "{{" }}formatHelpRow {{$shallowWidth}} "usage" "Print this usage message"{{ "}}" }}
{{- end}}
{{- end}}
{{- if .ParameterGroups}}
{{- $maxFlag := add .MaxFlagLength 2}}{{- $maxDef := .MaxDefaultLength}}{{- if gt $maxDef 0}}{{- $maxDef = add $maxDef 2}}{{- end}}

{{if eq (len .ParameterGroups) 1}}
{{- range .ParameterGroups}}
Flags:
{{- range .Parameters}}
    {{ "{{" }}formatFlagRow {{$maxFlag}} {{$maxDef}} {{printf "%q" .FlagString}} {{printf "%q" .DefaultString}} {{printf "%q" .Description}}{{ "}}" }}
{{- end}}
{{- end}}
{{- else}}
{{- range .ParameterGroups}}

`{{escapeUsageText .CommandName}}` Flags:
{{- range .Parameters}}
    {{ "{{" }}formatFlagRow {{$maxFlag}} {{$maxDef}} {{printf "%q" .FlagString}} {{printf "%q" .DefaultString}} {{printf "%q" .Description}}{{ "}}" }}
{{- end}}
{{- end}}
{{- end}}
{{- end}}
{{- $hasPositional := false}}{{- range .Parameters}}{{- if .IsPositional}}{{- $hasPositional = true}}{{- end}}{{- end}}
{{- if $hasPositional}}

Positional Arguments:
{{- range .Parameters}}
{{- if .IsPositional}}
    {{- if .IsVarArg}}
    {{ printf "[%s...]" .Name | printf "%-10s" | escapeUsageText}} {{escapeUsageText .Description}}
    {{- else if .HasDefaultValue}}
    {{ printf "[%s]" .Name | printf "%-10s" | escapeUsageText}} {{escapeUsageText .Description}}
    {{- else}}
    {{ printf "<%s>" .Name | printf "%-10s" | escapeUsageText}} {{escapeUsageText .Description}}
    {{- end}}
{{- end}}
{{- end}}
{{- end}}
