{{ "{{" }}/* Do not modify: Generated by github.com/arran4/go-subcommand/cmd/gosubc */ -{{ "}}" }}
{{ define "subcommands_recursive" -}}
{{- range .SubCommands}}
    (subcommand {{printf "%q" .SubCommandSequence}} {{printf "%q" .SubCommandDescription}})
{{- if .SubCommands}}
{{- template "subcommands_recursive" . }}
{{- end}}
{{- end}}
{{- end -}}
Usage: {{escapeUsageText .FullUsageString}}
{{- if .SubCommandDescription}}

{{escapeUsageText .SubCommandDescription}}
{{- end}}
{{- if .SubCommandExtendedHelp}}

{{escapeUsageText .SubCommandExtendedHelp}}
{{- end}}
{{- if or .SubCommands .SubCommandFunctionName}}

Subcommands:
{{- if .SubCommands}}
{{ "{{" }}- $commands := subcommands -{{ "}}" }}
{{ "{{" }}if .Recursive{{ "}}" }}
{{ "{{" }}- $commands = subcommands
{{- template "subcommands_recursive" . }}
{{- if .SubCommandFunctionName }}
    (subcommand "help" "Print this help message")
    (subcommand "usage" "Print this usage message")
{{- end}}
-{{ "}}" }}
{{ "{{" }}else{{ "}}" }}
{{ "{{" }}- $commands = subcommands
{{- range .SubCommands}}
    (subcommand {{printf "%q" .SubCommandName}} {{printf "%q" .SubCommandDescription}})
{{- end}}
{{- if .SubCommandFunctionName }}
    (subcommand "help" "Print this help message")
    (subcommand "usage" "Print this usage message")
{{- end}}
-{{ "}}" }}
{{ "{{" }}end{{ "}}" }}
{{- else if .SubCommandFunctionName }}
{{ "{{" }}- $commands := subcommands
    (subcommand "help" "Print this help message")
    (subcommand "usage" "Print this usage message")
-{{ "}}" }}
{{- end}}
{{ "{{" }}- $width := subcommandWidth $commands -{{ "}}" }}
{{ "{{" }}- range $commands{{ "}}" }}
{{ "{{" }}- if .Description{{ "}}" }}
    {{ "{{" }}printf "%-*s" $width .Label{{ "}}" }} {{ "{{" }}.Description{{ "}}" }}
{{ "{{" }}- else{{ "}}" }}
    {{ "{{" }}.Label{{ "}}" }}
{{ "{{" }}- end{{ "}}" }}
{{ "{{" }}- end{{ "}}" }}
{{- end}}
{{- if .ParameterGroups}}
{{- $maxFlag := add .MaxFlagLength 2}}{{- $maxDef := .MaxDefaultLength}}{{- if gt $maxDef 0}}{{- $maxDef = add $maxDef 2}}{{- end}}

{{if eq (len .ParameterGroups) 1}}
{{- range .ParameterGroups}}
Flags:
{{- range .Parameters}}
    {{printf "%-*s %-*s" $maxFlag .FlagString $maxDef .DefaultString | escapeUsageText}}{{if .Description}} {{wrapFlag $maxFlag $maxDef .FlagString .DefaultString .Description | escapeUsageText}}{{end}}
{{- end}}
{{- end}}
{{- else}}
{{- range .ParameterGroups}}

`{{escapeUsageText .CommandName}}` Flags:
{{- range .Parameters}}
    {{printf "%-*s %-*s" $maxFlag .FlagString $maxDef .DefaultString | escapeUsageText}}{{if .Description}} {{wrapFlag $maxFlag $maxDef .FlagString .DefaultString .Description | escapeUsageText}}{{end}}
{{- end}}
{{- end}}
{{- end}}
{{- end}}
{{- $hasPositional := false}}{{- range .Parameters}}{{- if .IsPositional}}{{- $hasPositional = true}}{{- end}}{{- end}}
{{- if $hasPositional}}

Positional Arguments:
{{- range .Parameters}}
{{- if .IsPositional}}
    {{- if .IsVarArg}}
    {{ printf "[%s...]" .Name | printf "%-10s" | escapeUsageText}} {{escapeUsageText .Description}}
    {{- else if .HasDefaultValue}}
    {{ printf "[%s]" .Name | printf "%-10s" | escapeUsageText}} {{escapeUsageText .Description}}
    {{- else}}
    {{ printf "<%s>" .Name | printf "%-10s" | escapeUsageText}} {{escapeUsageText .Description}}
    {{- end}}
{{- end}}
{{- end}}
{{- end}}
