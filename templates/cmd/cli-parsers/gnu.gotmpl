{{- define "cli_parser_gnu" }}
	var remainingArgs []string
	{{- $hasTrackedFlags := false }}
	{{- range .Parameters }}
		{{- if or .Required (and (not .IsPositional) (not .HasGenerator) (not .InheritedFrom) (or .IsWriter .IsReader) .HasDefaultValue) }}
			{{- $hasTrackedFlags = true }}
		{{- end }}
	{{- end }}
	{{- if $hasTrackedFlags }}
	seenFlags := make(map[string]bool)
	{{- end }}
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "--") {
			if arg == "--help" {
				c.Usage()
				return nil
			}
			name := arg[2:]
			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}
			_ = value
			_ = hasValue
			switch name {
			{{- range .Parameters }}
			{{- if and (not .IsPositional) (not .HasGenerator) (not .InheritedFrom) }}
			{{$param := .}}
			{{- $longs := list }}
			{{- if gt (len .Name) 1 }}{{ $longs = append $longs .Name }}{{ end }}
			{{- range .FlagAliases }}{{ if gt (len .) 1 }}{{ $longs = append $longs . }}{{ end }}{{ end }}
			{{- $uniqueLongs := list }}
			{{- range $l := $longs }}
				{{- $exists := false }}
				{{- range $u := $uniqueLongs }}{{ if eq $u $l }}{{ $exists = true }}{{ end }}{{ end }}
				{{- if not $exists }}{{ $uniqueLongs = append $uniqueLongs $l }}{{ end }}
			{{- end }}
			{{- if gt (len $uniqueLongs) 0 }}
			case {{ range $i, $n := $uniqueLongs }}{{if $i}}, {{end}}"{{$n}}"{{ end }}:
				{{- if or $param.Required (and (not $param.IsPositional) (not $param.HasGenerator) (or $param.IsWriter $param.IsReader) $param.HasDefaultValue) }}
				seenFlags["{{$param.Name}}"] = true
				{{- end }}
				{{- if $param.IsBool }}
				if hasValue {
					b, err := strconv.ParseBool(value)
					if err != nil {
						return fmt.Errorf("invalid boolean value for flag %s: %s", name, value)
					}
					{{- if $param.IsSlice }}
					{{- if $param.HasPointer }}
					c.{{$param.Name}} = append(c.{{$param.Name}}, &b)
					{{- else }}
					c.{{$param.Name}} = append(c.{{$param.Name}}, b)
					{{- end }}
					{{- else }}
					{{- if $param.HasPointer }}
					c.{{$param.Name}} = &b
					{{- else }}
					c.{{$param.Name}} = b
					{{- end }}
					{{- end }}
				} else {
					{{- if $param.IsSlice }}
					{{- if $param.HasPointer }}
					b := true
					c.{{$param.Name}} = append(c.{{$param.Name}}, &b)
					{{- else }}
					c.{{$param.Name}} = append(c.{{$param.Name}}, true)
					{{- end }}
					{{- else }}
					{{- if $param.HasPointer }}
					b := true
					c.{{$param.Name}} = &b
					{{- else }}
					c.{{$param.Name}} = true
					{{- end }}
					{{- end }}
				}
				{{- else }}
				if !hasValue {
					if i+1 < len(args) {
						value = args[i+1]
						i++
					} else {
						return fmt.Errorf("flag %s requires a value", name)
					}
				}
				{{- if and $param.IsString (not $param.HasCustomParser) }}
				{{- if $param.IsSlice }}
				{{- if $param.HasPointer }}
				s := value
				c.{{$param.Name}} = append(c.{{$param.Name}}, &s)
				{{- else }}
				c.{{$param.Name}} = append(c.{{$param.Name}}, value)
				{{- end }}
				{{- else }}
				{{- if $param.HasPointer }}
				s := value
				c.{{$param.Name}} = &s
				{{- else }}
				c.{{$param.Name}} = value
				{{- end }}
				{{- end }}
				{{- else if or $param.IsWriter $param.IsReader }}
				{{- template "acquire_io" (list $param "value") }}
				{{- else }}
				v, err := {{$param.ParserCall "value"}}
				if err != nil {
					return fmt.Errorf("invalid {{$param.TypeDescription}} value for flag %s: %s", name, value)
				}
				{{- if $param.IsSlice }}
				{{- if $param.HasPointer }}
				val := {{$param.CastCode "v"}}
				c.{{$param.Name}} = append(c.{{$param.Name}}, &val)
				{{- else }}
				c.{{$param.Name}} = append(c.{{$param.Name}}, {{$param.CastCode "v"}})
				{{- end }}
				{{- else }}
				{{- if $param.HasPointer }}
				val := {{$param.CastCode "v"}}
				c.{{$param.Name}} = &val
				{{- else }}
				c.{{$param.Name}} = {{$param.CastCode "v"}}
				{{- end }}
				{{- end }}
				{{- end }}
				{{- end }}
			{{- end }}
			{{- end }}
			{{- end }}
			default:
				return fmt.Errorf("unknown flag: --%s", name)
			}
		} else if strings.HasPrefix(arg, "-") && arg != "-" {
			// Short flags
			shorts := arg[1:]
			for j := 0; j < len(shorts); j++ {
				char := string(shorts[j])
				if char == "h" {
					c.Usage()
					return nil
				}
				found := false
				{{- range .Parameters }}
				{{- if and (not .IsPositional) (not .HasGenerator) (not .InheritedFrom) }}
				{{$param := .}}
				{{- $shorts := list }}
				{{- if eq (len .Name) 1 }}{{ $shorts = append $shorts .Name }}{{ end }}
				{{- range .FlagAliases }}{{ if eq (len .) 1 }}{{ $shorts = append $shorts . }}{{ end }}{{ end }}
				{{- $uniqueShorts := list }}
				{{- range $s := $shorts }}
					{{- $exists := false }}
					{{- range $u := $uniqueShorts }}{{ if eq $u $s }}{{ $exists = true }}{{ end }}{{ end }}
					{{- if not $exists }}{{ $uniqueShorts = append $uniqueShorts $s }}{{ end }}
				{{- end }}
				{{- if gt (len $uniqueShorts) 0 }}
				if char == "{{index $uniqueShorts 0}}" {{ range slice $uniqueShorts 1 }}|| char == "{{.}}"{{ end }} {
					found = true
					{{- if or $param.Required (and (or $param.IsWriter $param.IsReader) $param.HasDefaultValue) }}
					seenFlags["{{$param.Name}}"] = true
					{{- end }}
					{{- if $param.IsBool }}
					{{- if $param.IsSlice }}
					{{- if $param.HasPointer }}
					b := true
					c.{{$param.Name}} = append(c.{{$param.Name}}, &b)
					{{- else }}
					c.{{$param.Name}} = append(c.{{$param.Name}}, true)
					{{- end }}
					{{- else }}
					{{- if $param.HasPointer }}
					b := true
					c.{{$param.Name}} = &b
					{{- else }}
					c.{{$param.Name}} = true
					{{- end }}
					{{- end }}
					{{- else }}
					// Value flag
					value := ""
					if j+1 < len(shorts) {
						// Value is the rest of the short flag
						value = shorts[j+1:]
						if strings.HasPrefix(value, "=") {
							value = value[1:]
						}
						j = len(shorts) // break inner loop
					} else {
						// Value is the next arg
						if i+1 < len(args) {
							value = args[i+1]
							i++
						} else {
							return fmt.Errorf("flag -%s requires a value", char)
						}
					}
					{{- if and $param.IsString (not $param.HasCustomParser) }}
					{{- if $param.IsSlice }}
					{{- if $param.HasPointer }}
					s := value
					c.{{$param.Name}} = append(c.{{$param.Name}}, &s)
					{{- else }}
					c.{{$param.Name}} = append(c.{{$param.Name}}, value)
					{{- end }}
					{{- else }}
					{{- if $param.HasPointer }}
					s := value
					c.{{$param.Name}} = &s
					{{- else }}
					c.{{$param.Name}} = value
					{{- end }}
					{{- end }}
					{{- else if or $param.IsWriter $param.IsReader }}
					{{- template "acquire_io" (list $param "value") }}
					{{- else }}
					v, err := {{$param.ParserCall "value"}}
					if err != nil {
						return fmt.Errorf("invalid {{$param.TypeDescription}} value for flag -%s: %s", char, value)
					}
					{{- if $param.IsSlice }}
					{{- if $param.HasPointer }}
					val := {{$param.CastCode "v"}}
					c.{{$param.Name}} = append(c.{{$param.Name}}, &val)
					{{- else }}
					c.{{$param.Name}} = append(c.{{$param.Name}}, {{$param.CastCode "v"}})
					{{- end }}
					{{- else }}
					{{- if $param.HasPointer }}
					val := {{$param.CastCode "v"}}
					c.{{$param.Name}} = &val
					{{- else }}
					c.{{$param.Name}} = {{$param.CastCode "v"}}
					{{- end }}
					{{- end }}
					{{- end }}
					{{- end }}
				}
				{{- end }}
				{{- end }}
				{{- end }}
				if !found {
					return fmt.Errorf("unknown flag: -%s", char)
				}
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}
{{- end }}
