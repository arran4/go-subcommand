{{- define "cli_parser_go-flag" }}
	var remainingArgs []string
	{{- $hasTrackedFlags := false }}
	{{- range .Parameters }}
		{{- if or .Required (and (not .IsPositional) (not .HasGenerator) (not .InheritedFrom) (or .IsWriter .IsReader) .HasDefaultValue) }}
			{{- $hasTrackedFlags = true }}
		{{- end }}
	{{- end }}
	{{- if $hasTrackedFlags }}
	seenFlags := make(map[string]bool)
	{{- end }}
	dashDashSeen := false
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == "--" {
			dashDashSeen = true
			remainingArgs = append(remainingArgs, args[i+1:]...)
			break
		}
		if strings.HasPrefix(arg, "-") && arg != "-" {
			name := arg[1:]
			if strings.HasPrefix(name, "-") {
				name = name[1:]
			}
			if name == "help" || name == "h" {
				c.Usage()
				return nil
			}

			value := ""
			hasValue := false
			if strings.Contains(name, "=") {
				parts := strings.SplitN(name, "=", 2)
				name = parts[0]
				value = parts[1]
				hasValue = true
			}

			_ = value
			_ = hasValue

			found := false
			switch name {
			{{- range .Parameters }}
			{{- if and (not .IsPositional) (not .HasGenerator) (not .InheritedFrom) }}
			{{$param := .}}
			{{- $aliases := list }}
			{{- $aliases = append $aliases .Name }}
			{{- range .FlagAliases }}{{ $aliases = append $aliases . }}{{ end }}
			{{- $uniqueAliases := list }}
			{{- range $a := $aliases }}
				{{- $exists := false }}
				{{- range $u := $uniqueAliases }}{{ if eq $u $a }}{{ $exists = true }}{{ end }}{{ end }}
				{{- if not $exists }}{{ $uniqueAliases = append $uniqueAliases $a }}{{ end }}
			{{- end }}
			{{- if gt (len $uniqueAliases) 0 }}
			case {{ range $i, $n := $uniqueAliases }}{{if $i}}, {{end}}"{{$n}}"{{ end }}:
				found = true
				{{- if or $param.Required (and (not $param.IsPositional) (not $param.HasGenerator) (or $param.IsWriter $param.IsReader) $param.HasDefaultValue) }}
				seenFlags["{{$param.Name}}"] = true
				{{- end }}
				{{- if $param.IsBool }}
				if hasValue {
					b, err := strconv.ParseBool(value)
					if err != nil {
						return fmt.Errorf("invalid boolean value for flag %s: %s", name, value)
					}
					{{- if $param.IsSlice }}
					{{- if $param.HasPointer }}
					c.{{$param.Name}} = append(c.{{$param.Name}}, &b)
					{{- else }}
					c.{{$param.Name}} = append(c.{{$param.Name}}, b)
					{{- end }}
					{{- else }}
					{{- if $param.HasPointer }}
					c.{{$param.Name}} = &b
					{{- else }}
					c.{{$param.Name}} = b
					{{- end }}
					{{- end }}
				} else {
					{{- if $param.IsSlice }}
					{{- if $param.HasPointer }}
					b := true
					c.{{$param.Name}} = append(c.{{$param.Name}}, &b)
					{{- else }}
					c.{{$param.Name}} = append(c.{{$param.Name}}, true)
					{{- end }}
					{{- else }}
					{{- if $param.HasPointer }}
					b := true
					c.{{$param.Name}} = &b
					{{- else }}
					c.{{$param.Name}} = true
					{{- end }}
					{{- end }}
				}
				{{- else }}
				if !hasValue {
					if i+1 < len(args) {
						value = args[i+1]
						i++
					} else {
						return fmt.Errorf("flag %s requires a value", name)
					}
				}
				{{- if and $param.IsString (not $param.HasCustomParser) }}
				{{- if $param.IsSlice }}
				{{- if $param.HasPointer }}
				s := value
				c.{{$param.Name}} = append(c.{{$param.Name}}, &s)
				{{- else }}
				c.{{$param.Name}} = append(c.{{$param.Name}}, value)
				{{- end }}
				{{- else }}
				{{- if $param.HasPointer }}
				s := value
				c.{{$param.Name}} = &s
				{{- else }}
				c.{{$param.Name}} = value
				{{- end }}
				{{- end }}
				{{- else if or $param.IsWriter $param.IsReader }}
				{{- template "acquire_io" (list $param "value") }}
				{{- else }}
				v, err := {{$param.ParserCall "value"}}
				if err != nil {
					return fmt.Errorf("invalid {{$param.TypeDescription}} value for flag %s: %s", name, value)
				}
				{{- if $param.IsSlice }}
				{{- if $param.HasPointer }}
				val := {{$param.CastCode "v"}}
				c.{{$param.Name}} = append(c.{{$param.Name}}, &val)
				{{- else }}
				c.{{$param.Name}} = append(c.{{$param.Name}}, {{$param.CastCode "v"}})
				{{- end }}
				{{- else }}
				{{- if $param.HasPointer }}
				val := {{$param.CastCode "v"}}
				c.{{$param.Name}} = &val
				{{- else }}
				c.{{$param.Name}} = {{$param.CastCode "v"}}
				{{- end }}
				{{- end }}
				{{- end }}
				{{- end }}
			{{- end }}
			{{- end }}
			{{- end }}
			default:
				// Try to see if it's a combined boolean short flag, only if single dash was used.
				// Actually, go-flag doesn't do GNU-style short flag clustering. It just looks for the exact name.
				// If not found, it's an error.
			}

			if !found {
				return fmt.Errorf("unknown flag: -%s", name)
			}
		} else {
			remainingArgs = append(remainingArgs, args[i:]...)
			break
		}
	}
{{- end }}
