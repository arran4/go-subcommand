			name, value, assigned = rest[:at], rest[at+1:], true
		}
		if name == "help" && prefix == "++" {
			return result, newUsageError(path, cmd.UsageUnknownFlag, "help", nil, "unknown flag: ++help")
		}
		option, found := long[name]
		if !found {
			return result, newUsageError(path, cmd.UsageUnknownFlag, name, nil, "unknown flag: %s%s", prefix, name)
		}
