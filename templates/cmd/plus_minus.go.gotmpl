				if value != "" && !option.SupportsValuePlus && option.Set == nil {
					return result, newUsageError(path, cmd.UsageInvalidValue, char, nil, "flag +%s does not support assigned plus operation", char)
				}
				if value == "" && !result.NeedsValue && !option.SupportsBarePlus && option.Set == nil {
					return result, newUsageError(path, cmd.UsageUnknownFlag, char, nil, "unknown flag: +%s", char)
				}
			}
			result.Values = append(result.Values, plusMinusValue{Name: char, Prefix: prefixStr, Option: option, Value: value, IsPlus: prefix == '+'})
			break
