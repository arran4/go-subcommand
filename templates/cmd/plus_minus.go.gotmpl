			if len(body) > 1 || prefix == '+' {
				return result, newUsageError(path, cmd.UsageInvalidArguments, "h", nil, "help cannot be disabled or clustered: %s", token)
			}
			result.Help = true
			return result, nil
		}
		option, found := short[char]
		if !found {
			return result, newUsageError(path, cmd.UsageUnknownFlag, char, nil, "unknown flag: %c%s", prefix, char)
		}
		if option.Boolean {
			if j+1 < len(body) && body[j+1] == '=' {
				return result, newUsageError(path, cmd.UsageInvalidArguments, "", nil, "invalid plus-minus option: %s", token)
			}
			value := "true"
			if prefix == '+' {
				value = "false"
			}
			result.Values = append(result.Values, plusMinusValue{Name: char, Prefix: prefixStr, Option: option, Value: value, IsPlus: prefix == '+'})
		} else {
