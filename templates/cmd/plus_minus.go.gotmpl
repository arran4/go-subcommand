func isFlagLike(token string) bool {
	if strings.HasPrefix(token, "--") && len(token) > 2 {
		return true
	}
	if strings.HasPrefix(token, "++") && len(token) > 2 {
		return true
	}
	return false
}

// Scans args, validates all tokens and staged values before committing any changes.
// Preserves positional argument ordering and yields when encountering subcommands.
func parsePlusMinus(args []string, path string, short, long map[string]plusMinusOption, subcommands ...map[string]bool) (remaining []string, seen map[string]bool, terminated, help bool, err error) {
