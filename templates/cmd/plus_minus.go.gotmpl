			if option.Boolean && !assigned {
				value = "true"
			}
			result.NeedsValue = !option.Boolean && !assigned
		} else { // prefix == "++"
			if assigned {
				if !option.SupportsValuePlus && option.Set == nil {
					return result, newUsageError(path, cmd.UsageInvalidValue, name, nil, "flag ++%s does not support assigned plus operation", name)
				}
			} else {
				if option.Boolean {
					value = "false"
				} else if !option.SupportsBarePlus && option.Set == nil {
					return result, newUsageError(path, cmd.UsageUnknownFlag, name, nil, "unknown flag: ++%s", name)
				}
			}
		}
		result.Values = []plusMinusValue{ {Name: name, Prefix: prefix, Option: option, Value: value, IsPlus: prefix == "++"} }
		return result, nil
	}

	prefix := token[0]
	prefixStr := string(prefix)
	body := token[1:]
	if body[0] == '+' || body[0] == '-' {
		return result, newUsageError(path, cmd.UsageInvalidArguments, "", nil, "invalid plus-minus option: %s", token)
