			lastVal := token.Values[len(token.Values)-1]
			lastName := lastVal.Name
			flagPrefix := lastVal.Prefix
			if i+1 >= len(args) {
				return nil, stagedSeen, false, false, newUsageError(path, cmd.UsageMissingFlagValue, lastName, nil, "flag %s%s requires a value", flagPrefix, lastName)
			}
			next := args[i+1]
			if isFlagLike(next) {
				return nil, stagedSeen, false, false, newUsageError(path, cmd.UsageMissingFlagValue, lastName, nil, "flag %s%s requires a value", flagPrefix, lastName)
			}
