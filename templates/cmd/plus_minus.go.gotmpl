	}
	if strings.HasPrefix(token, "--") || strings.HasPrefix(token, "++") {
		prefix := token[:2]
		rest := token[2:]
		if rest == "" {
			// Standalone "++" is treated as boundary positional
			result.Boundary = true
			return result, nil
