-- in/main.go --
package main

// AppMain is a subcommand `app`.
// CLI-Parser: go-flag
//
// Flags:
//	config: (required) --config Configuration path
//	one: --one Boolean flag
//	out: -out String flag using single dash long option
func AppMain(config string, one bool, out string) {}

// AppChild is a subcommand `app child`.
// CLI-Parser: gnu
//
// Flags:
//	dir: --dir Parent directory
func AppChild(dir string) {}

// AppGrandChild is a subcommand `app child grandchild`.
// CLI-Parser: go-flag
//
// Flags:
//	dir: --dir (from parent)
//	enable: -enable Enable something
func AppGrandChild(dir string, enable bool) {}
-- in/cmd/app/e2e_test.go --
package main

import "testing"

func TestGoFlagRuntimeRequirements(t *testing.T) {
	root, err := NewRoot("app", "", "", "")
	if err != nil {
		t.Fatal(err)
	}

	child := root.NewChild()
	root.Commands["child"] = func() Cmd { return child }

	grandChild := child.NewChildGrandchild()
	child.SubCommands["grandchild"] = func() Cmd { return grandChild }

	var events []string
	root.CommandAction = func(c *RootCmd) error {
		events = append(events, "root")
		return nil
	}
	child.CommandAction = func(c *Child) error {
		events = append(events, "child")
		return nil
	}
	grandChild.CommandAction = func(c *ChildGrandchild) error {
		events = append(events, "grandchild")
		return nil
	}

	err = root.Execute([]string{
		"--config", "config.yml", "--one=true", "-out=test.txt", "child", "--dir", "workspace", "grandchild", "-enable=true",
	})
	if err != nil {
		t.Fatal(err)
	}
	if !grandChild.enable {
		t.Fatalf("go-flag grand child boolean flag not parsed correctly")
	}
	if len(events) != 2 || events[0] != "root" || events[1] != "grandchild" {
		t.Fatalf("action order = %#v", events)
	}

	// Test missing required flag for goflag parser
	missing, err := NewRoot("app", "", "", "")
	if err != nil {
		t.Fatal(err)
	}
	if err := missing.Execute(nil); err == nil {
		t.Fatal("missing required root flag did not fail in go-flag backend")
	}

	// Test ownership boundary: child --
	err = root.Execute([]string{
		"--config", "config.yml", "child", "--", "-enable=true",
	})
	if err != nil {
		t.Fatal(err)
	}
	if len(events) != 4 || events[3] != "child" {
		t.Fatalf("action order should be child = %#v", events)
	}
}
